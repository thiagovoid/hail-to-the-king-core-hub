{
  "name": "hail-to-the-king-core-hub",
  "type": "module",
  "scripts": {
    "postinstall": "playwright install chromium",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "wcl:test": "vite-node -c vitest.config.ts scripts/warcraftlogs/test-connection.ts",
    "wcl:fetch-performance": "vite-node -c vitest.config.ts scripts/warcraftlogs/fetch-performance.ts",
    "wcl:sync-roster-stats": "vite-node -c vitest.config.ts scripts/warcraftlogs/sync-roster-stats.ts",
    "raidbots:update-goals": "vite-node -c vitest.config.ts scripts/raidbots/update-performance-goals.ts",
    "wipefest:fetch-scores": "vite-node -c vitest.config.ts scripts/wipefest/fetch-scores.ts",
    "wipefest:fetch-boss-insights": "vite-node -c vitest.config.ts scripts/wipefest/fetch-boss-insights.ts",
    "wowanalyzer:fetch-scores": "vite-node -c vitest.config.ts scripts/wowanalyzer/fetch-scores.ts",
    "wcl:inspect-preparation": "vite-node -c vitest.config.ts scripts/warcraftlogs/inspect-preparation.ts",
    "wowhead:fetch-preparation": "vite-node -c vitest.config.ts scripts/wowhead/fetch-preparation.ts",
    "raiderio:check-guild-membership": "vite-node -c vitest.config.ts scripts/raiderio/check-guild-membership.ts",
    "raiderio:update-weekly-mythic": "vite-node -c vitest.config.ts scripts/raiderio/update-weekly-mythic-highlights.ts",
    "wcl:inspect-roles": "vite-node -c vitest.config.ts scripts/warcraftlogs/inspect-roles.ts",
    "wipefest:fetch-mechanics": "vite-node -c vitest.config.ts scripts/wipefest/fetch-mechanics.ts",
    "wcl:inspect-parse": "vite-node -c vitest.config.ts scripts/warcraftlogs/inspect-parse.ts",
    "wcl:_probe-parse": "vite-node -c vitest.config.ts scripts/warcraftlogs/_probe-parse.ts"
  },
  "dependencies": {
    "@astrojs/tailwind": "^5.1.4",
    "astro": "^4.16.18",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^2.1.8",
    "dotenv": "^17.4.2",
    "fast-check": "^3.23.2",
    "playwright": "^1.61.1",
    "typescript": "^5.7.3",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.8"
  }
}
