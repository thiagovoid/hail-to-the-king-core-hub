# Credenciais do client OAuth2 criado em warcraftlogs.com -> Settings -> API Clients
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# IDs de conta WCL (não de personagem) de quem sobe os logs de raid.
# Usado pra achar reports mesmo quando a guild não foi marcada no upload.
# Descobrir o ID: reportData.report(code: "...").owner.id na API, ou perguntar
# pra pessoa (é o ID numérico da conta dela no warcraftlogs.com).
# Vários IDs separados por vírgula, ex: 922357,1771711
WCL_UPLOADER_USER_IDS=
