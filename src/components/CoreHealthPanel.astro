---
import type { CoreHealth, HealthStatus } from '@/engine/guild/coreHealth';

interface Props {
  health: CoreHealth;
}

const { health } = Astro.props;

const DOT: Record<HealthStatus, string> = {
  green: 'bg-emerald-500',
  yellow: 'bg-amber-500',
  red: 'bg-red-500',
  unknown: 'bg-slate-600',
};

const TEXT: Record<HealthStatus, string> = {
  green: 'text-emerald-400',
  yellow: 'text-amber-400',
  red: 'text-red-400',
  unknown: 'text-slate-500',
};
---

<section aria-labelledby="core-health-heading">
  <div class="flex items-center gap-3 mb-6">
    <div class="h-px flex-1 bg-white/5" aria-hidden="true" />
    <h2 id="core-health-heading" class="text-slate-400 text-xs font-semibold uppercase tracking-widest px-2">
      Core Health
    </h2>
    <div class="h-px flex-1 bg-white/5" aria-hidden="true" />
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    {health.categories.map((category) => (
      <div class="bg-[#141b2d] border border-white/7 rounded-xl p-4 flex items-start gap-3">
        <span class={`mt-1 w-2.5 h-2.5 rounded-full shrink-0 ${DOT[category.status]}`} aria-hidden="true" />
        <div class="min-w-0">
          <p class={`text-sm font-bold ${TEXT[category.status]}`}>{category.label}</p>
          <p class="text-slate-400 text-xs mt-1 leading-snug">{category.detail}</p>
        </div>
      </div>
    ))}
  </div>
</section>
