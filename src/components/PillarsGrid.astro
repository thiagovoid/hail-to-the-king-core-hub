---
/**
 * PillarsGrid.astro — Os 5 pilares da guild (Respeito, Humildade, Empatia,
 * Companheirismo, Amizade), usado na home institucional e em /historia.
 */
import type { GuildPillar } from '@/types/index';

interface Props {
  pillars: GuildPillar[];
}

const { pillars } = Astro.props;
---

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
  {pillars.map((pillar) => (
    <article class="bg-[#141b2d] border border-white/7 rounded-xl p-5 text-center">
      <h3 class="text-[#f0a500] font-bold text-sm uppercase tracking-wide mb-2">
        {pillar.name}
      </h3>
      <p class="text-slate-400 text-xs leading-relaxed">
        {pillar.description}
      </p>
    </article>
  ))}
</div>
