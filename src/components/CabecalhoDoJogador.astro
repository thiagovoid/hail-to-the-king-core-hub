---
/**
 * O cabeçalho da ficha, no formato de painel.
 *
 * A ficha vinha sendo um listão vertical: identidade, depois uma seção
 * inteira só pros números da temporada, depois o Score, depois mais doze
 * seções. Cada número da temporada ocupava um cartão do tamanho de um
 * parágrafo, e o jogador rolava uma tela antes de chegar no que veio ver.
 *
 * Aqui eles voltam a ser o que são: contexto. Ficam na moldura, numa faixa
 * só, do jeito que uma ficha de personagem mostra atributo — legíveis de
 * relance, sem competir com a nota que vem logo abaixo.
 *
 * A explicação de cada número não some: vira o tooltip do rótulo, porque o
 * texto que antes ocupava um parágrafo fixo só interessa a quem duvidou
 * daquele número específico. Bosses e Mortes abrem a lista encontro a
 * encontro — o total sozinho não diz se foram vinte e três encontros ou o
 * mesmo Altar oito vezes, nem onde treinar.
 */
import { formatPerformanceValue } from '@/engine/metrics';
import type { PlayerSeasonAverage } from '@/engine/metrics';
import EmblemaDeRank from '@/components/EmblemaDeRank.astro';
import InfoTooltip from '@/components/InfoTooltip.astro';

interface Props {
  player: { name: string; avatar: string | null; class: string; spec: string; role: string };
  /** A nota que a medalha reflete. Null quando não há noite medida. */
  score: number | null;
  average: PlayerSeasonAverage | null;
  /** Em quantas das noites do core esta pessoa apareceu, 0-100. */
  presenca: number | null;
  /** Subida ou queda do dps/hps ao longo das noites, em %. */
  tendencia: number | null;
  /**
   * O detalhe por trás de "Bosses" e "Mortes": encontro a encontro.
   *
   * Sem ele os dois números são só totais. "23 bosses" não diz se foram
   * vinte e três encontros diferentes ou o mesmo Altar oito vezes, e "62
   * mortes" não diz onde treinar.
   */
  porBoss?: Array<{ nome: string; dificuldade: string; kills: number; deaths: number }>;
}

const { player, score, average, presenca, tendencia, porBoss = [] } = Astro.props;

/** Só os encontros onde o número existe — zero não ensina nada numa lista. */
const killsPorBoss = porBoss.filter((boss) => boss.kills > 0).sort((a, b) => b.kills - a.kills);
const mortesPorBoss = porBoss.filter((boss) => boss.deaths > 0).sort((a, b) => b.deaths - a.deaths);

/**
 * Abaixo de 5% pra qualquer lado é ruído de boss e de composição, não
 * tendência — pintar isso de verde ou vermelho seria dar significado a
 * flutuação.
 */
const corDaTendencia =
  tendencia === null || Math.abs(tendencia) < 5
    ? 'text-white'
    : tendencia > 0
      ? 'text-emerald-400'
      : 'text-red-400';

/**
 * Cada número com a frase que o explica.
 *
 * "Bosses mortos: 24" sem o resto engana — ele conta repetição, e três
 * clears do mesmo boss contam três. Deixar isso só num parágrafo lá em cima
 * fazia quem chegasse pelo número nunca ler a ressalva.
 */
const numeros = average
  ? [
      average.dps !== undefined
        ? {
            rotulo: 'DPS',
            valor: formatPerformanceValue(average.dps),
            explica: `Média das ${average.runs} noites registradas.`,
          }
        : null,
      average.hps !== undefined
        ? {
            rotulo: 'HPS',
            valor: formatPerformanceValue(average.hps),
            explica: `Média das ${average.runs} noites registradas.`,
          }
        : null,
      {
        rotulo: 'Bosses',
        valor: String(average.bossesMortos),
        explica:
          'Kills com você presente na try, contando repetição: três clears do mesmo boss contam três.',
        lista: killsPorBoss.map((boss) => ({
          nome: boss.nome,
          dificuldade: boss.dificuldade,
          quantos: boss.kills,
        })),
        listaVazia: 'Nenhum boss caiu com você presente ainda.',
      },
      {
        rotulo: 'Mortes',
        valor: String(average.mortesNaSeason),
        explica: 'Total da temporada, não média por noite. A média por try fica no Score.',
        lista: mortesPorBoss.map((boss) => ({
          nome: boss.nome,
          dificuldade: boss.dificuldade,
          quantos: boss.deaths,
        })),
        listaVazia: 'Você não caiu uma vez na temporada.',
      },
      average.mechanics !== undefined
        ? {
            rotulo: 'Erros mec.',
            valor: String(average.errosMecanicosNaSeason),
            explica: 'Total da temporada. A média por try é o que entra no Score.',
          }
        : null,
      average.itemLevel !== undefined
        ? {
            rotulo: 'Item level',
            valor: String(average.itemLevel),
            explica: 'O último registrado, não uma média.',
          }
        : null,
      presenca !== null
        ? {
            rotulo: 'Presença',
            valor: `${presenca}%`,
            explica: 'Das noites que o core raidou, em quantas você apareceu.',
          }
        : null,
      tendencia !== null
        ? {
            rotulo: 'Tendência',
            valor: `${tendencia > 0 ? '+' : ''}${tendencia}%`,
            cor: corDaTendencia,
            explica:
              'Subida ou queda do seu dps/hps ao longo de todas as noites. É uma reta, não dois pontos comparados: uma noite ruim isolada não derruba, várias seguidas sim. Compara você com você mesmo, nunca com o resto do core.',
            paragrafos: [
              'Subida ou queda do seu dps/hps ao longo de todas as runs.',
              'Por ser uma reta, e não dois pontos comparados, uma noite ruim isolada não derruba o número — mas várias seguidas, sim.',
              'Compara você com você mesmo, nunca com o resto do core. Precisa de pelo menos duas runs pra existir.',
            ],
          }
        : null,
    ].filter((n): n is NonNullable<typeof n> => n !== null)
  : [];
---

<header class="mb-8 bg-slate-900/60 border border-slate-800 rounded-xl overflow-hidden">
  <div class="flex items-center gap-5 p-5">
    {player.avatar && (
      <img
        src={player.avatar}
        alt=""
        width="80"
        height="80"
        class="w-20 h-20 rounded-lg border border-slate-700 shrink-0"
      />
    )}

    <div class="min-w-0">
      <h1 class="text-3xl font-bold text-white truncate">{player.name}</h1>

      <p class="text-slate-400 mt-0.5 text-sm">
        {player.class} · {player.spec}
        <span class="text-slate-500 capitalize"> · {player.role}</span>
      </p>
    </div>

    <div class="ml-auto shrink-0">
      <EmblemaDeRank score={score} />
    </div>
  </div>

  {
    numeros.length > 0 && (
      <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-8 border-t border-slate-800">
        {numeros.map((numero, indice) => (
          <div
            class:list={[
              'px-4 py-3 border-slate-800/70',
              indice > 0 && 'border-l',
              // Em telas estreitas a grade quebra em linhas, e sem a borda
              // de cima as linhas encostam uma na outra.
              'border-t sm:border-t-0 first:border-t-0',
            ]}
          >
            {/* O `title` do navegador some pra quem não usa mouse e não
                aparece pra quem não sabe que existe. O "i" é visível e
                alcançável pelo teclado. */}
            <p class="text-[10px] uppercase tracking-wider text-slate-500">
              <span class="inline-flex items-center gap-1">
                {numero.rotulo}

                <InfoTooltip
                  label={`O que é ${numero.rotulo}`}
                  alinhamento={indice >= numeros.length - 2 ? 'direita' : 'esquerda'}
                  direcao="baixo"
                >
                  {'paragrafos' in numero && numero.paragrafos ? (
                    numero.paragrafos.map((paragrafo, ordem) => (
                      <span
                        class:list={[
                          'block text-[11px] leading-relaxed',
                          ordem === 0 ? 'text-slate-300' : 'text-slate-400 mt-2',
                        ]}
                      >
                        {paragrafo}
                      </span>
                    ))
                  ) : (
                    <span class="block text-[11px] text-slate-400 leading-relaxed">
                      {numero.explica}
                    </span>
                  )}

                  {/* Encontro a encontro: "23 bosses" não diz se foram vinte e
                      três encontros ou o mesmo Altar oito vezes, e "62 mortes"
                      não diz onde treinar. */}
                  {'lista' in numero && numero.lista && (
                    <span class="block mt-2 pt-2 border-t border-white/10">
                      {numero.lista.length === 0 ? (
                        <span class="block text-[11px] text-slate-500">{numero.listaVazia}</span>
                      ) : (
                        numero.lista.map((item) => (
                          <span class="flex items-baseline justify-between gap-3 text-[11px] leading-relaxed">
                            <span class="text-slate-400 min-w-0">
                              {item.nome}
                              <span
                                class:list={[
                                  'ml-1.5 text-[9px] uppercase tracking-wide',
                                  item.dificuldade === 'Heroico'
                                    ? 'text-purple-400'
                                    : 'text-slate-600',
                                ]}
                              >
                                {item.dificuldade}
                              </span>
                            </span>
                            <span class="text-slate-200 tabular-nums shrink-0">{item.quantos}</span>
                          </span>
                        ))
                      )}
                    </span>
                  )}
                </InfoTooltip>
              </span>
            </p>

            <strong class:list={["block text-lg font-bold tabular-nums mt-0.5", ("cor" in numero && numero.cor) || "text-white"]}>
              {numero.valor}
            </strong>
          </div>
        ))}
      </div>
    )
  }
</header>
