
---

import { getClassColor } from '@/utils/roster';
import { formatDate } from '@/utils/format';

interface DataPoint {
  date: string;
  value: number;
}

function formatShortDate(iso: string): string {
  return formatDate(iso).slice(0, 5);
}

interface PlayerSeries {
  playerId: string;
  playerName: string;
  playerClass?: string | null;
  playerSlug?: string;
  data: DataPoint[];
}

interface Metric {
  id: string;
  label: string;
  direction: 'higher' | 'lower';
  series: PlayerSeries[];
}

interface Props {
  metrics: Metric[];
}

const { metrics } = Astro.props;

const width = 800;
const height = 320;
const paddingLeft = 55;
const paddingRight = 30;
const paddingTop = 25;
const paddingBottom = 35;

function formatValue(value: number): string {
  if (value >= 1000) {
    return `${(value / 1000).toFixed(1)}k`;
  }

  return value.toString();
}

function getScale(series: PlayerSeries[]) {
  const values = series.flatMap((item) =>
    item.data.map((point) => point.value)
  );

  if (values.length === 0) {
    return {
      min: 0,
      max: 100,
      range: 100,
    };
  }

  let min = Math.min(...values);
  let max = Math.max(...values);

  if (min === max) {
    min = Math.max(0, min - 1);
    max = max + 1;
  }

  const padding = (max - min) * 0.15;

  min = Math.max(0, min - padding);
  max = max + padding;

  return {
    min,
    max,
    range: max - min || 1,
  };
}

function getX(
  date: string,
  dates: string[]
): number {
  const chartWidth =
    width - paddingLeft - paddingRight;

  if (dates.length <= 1) {
    return paddingLeft + chartWidth / 2;
  }

  const index = dates.indexOf(date);

  if (index === -1) {
    return paddingLeft;
  }

  return (
    paddingLeft +
    (index / (dates.length - 1)) * chartWidth
  );
}

function getY(
  value: number,
  scale: ReturnType<typeof getScale>
): number {
  const chartHeight =
    height - paddingTop - paddingBottom;

  return (
    paddingTop +
    (1 - (value - scale.min) / scale.range) *
      chartHeight
  );
}

function createPoints(
  data: DataPoint[],
  scale: ReturnType<typeof getScale>,
  dates: string[]
): string {
  return data
    .map(
      (point) =>
        `${getX(point.date, dates)},${getY(point.value, scale)}`
    )
    .join(' ');
}

function getDates(series: PlayerSeries[]): string[] {
  return [
    ...new Set(
      series.flatMap((item) =>
        item.data.map((point) => point.date)
      )
    ),
  ].sort((a, b) => a.localeCompare(b));
}

function getLastDate(dates: string[]): string | null {
  if (dates.length === 0) {
    return null;
  }

  return dates[dates.length - 1];
}

function getTrend(
  data: DataPoint[],
  direction: 'higher' | 'lower'
) {
  if (data.length < 2) {
    return null;
  }

  const previous = data[data.length - 2].value;
  const current = data[data.length - 1].value;

  if (previous === 0) {
    return null;
  }

  const change = Math.round(
    ((current - previous) / Math.abs(previous)) * 100
  );

  if (change === 0) {
    return {
      symbol: '→',
      value: '0%',
      positive: null,
    };
  }

  const improved =
    direction === 'higher'
      ? change > 0
      : change < 0;

  return {
    symbol: change > 0 ? '↑' : '↓',
    value: `${Math.abs(change)}%`,
    positive: improved,
  };
}

// Só a primeira métrica é renderizada no servidor (é a única visível ao
// carregar a página). As outras 3 abas são construídas no navegador, sob
// demanda, no primeiro clique — renderizar as 4 de uma vez (só escondendo
// 3 via CSS) inflava o DOM da home pra ~950 elementos com o roster atual,
// o suficiente pra reprovar o orçamento de performance do Lighthouse CI.
/**
 * Meses presentes no dado, do mais antigo pro mais novo.
 *
 * O filtro é só de visualização: ele muda o que é desenhado e nada do que é
 * calculado. A tendência da legenda, por exemplo, continua olhando o
 * histórico inteiro mesmo com um mês selecionado — senão "↑12%" passaria a
 * significar coisas diferentes conforme o botão apertado.
 */
function mesesDoDado(lista: Metric[]): string[] {
  const meses = new Set<string>();
  for (const metric of lista) {
    for (const series of metric.series) {
      for (const point of series.data) meses.add(point.date.slice(0, 7));
    }
  }
  return [...meses].sort();
}

const MES_CURTO = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];

function rotuloDoMes(mes: string): string {
  const [ano, numero] = mes.split('-');
  return `${MES_CURTO[Number(numero) - 1]}/${ano.slice(2)}`;
}

const mesesDisponiveis = mesesDoDado(metrics);

const serializedMetrics = metrics.map((metric) => ({
  id: metric.id,
  label: metric.label,
  direction: metric.direction,
  series: metric.series.map((series) => ({
    playerName: series.playerName,
    playerSlug: series.playerSlug ?? null,
    playerColor: getClassColor(series.playerClass as any),
    data: series.data,
  })),
}));
---

<section
  class="bg-slate-900/60 border border-slate-800 rounded-xl p-6 mt-8"
>
  <div
    class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-6"
  >
    <div>
      <h2 class="text-xl font-bold text-white">
        Performance do Core
      </h2>

      <p class="text-sm text-slate-500 mt-1">
        Evolução dos jogadores run a run.
      </p>
    </div>

    <div
      id="core-performance-tabs"
      class="flex flex-wrap gap-2"
    >
      {
        metrics.map((metric, index) => (
          <button
            type="button"
            data-metric={metric.id}
            class={`px-3 py-1.5 rounded-lg text-sm transition-colors ${
              index === 0
                ? 'bg-slate-700 text-white'
                : 'text-slate-400 hover:text-white hover:bg-slate-800'
            }`}
          >
            {metric.label}
          </button>
        ))
      }
    </div>
  </div>

  <!-- Controles de visualização. Ficam numa linha só acima do gráfico, e
       nenhum dos dois altera cálculo: mudam o recorte desenhado. -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-5 pb-4 border-b border-slate-800">
    <div id="core-performance-meses" class="flex flex-wrap items-center gap-1.5">
      <span class="text-[11px] uppercase tracking-wide text-slate-600 mr-1">Período</span>

      <button
        type="button"
        data-mes="todos"
        class="px-2.5 py-1 rounded-md text-xs transition-colors bg-slate-700 text-white"
      >
        Tudo
      </button>

      {
        mesesDisponiveis.map((mes) => (
          <button
            type="button"
            data-mes={mes}
            class="px-2.5 py-1 rounded-md text-xs transition-colors text-slate-400 hover:text-white hover:bg-slate-800"
          >
            {rotuloDoMes(mes)}
          </button>
        ))
      }
    </div>

    <div id="core-performance-modo" class="flex items-center gap-1.5">
      <span class="text-[11px] uppercase tracking-wide text-slate-600 mr-1">Ver como</span>

      <button
        type="button"
        data-modo="ranking"
        class="px-2.5 py-1 rounded-md text-xs transition-colors bg-slate-700 text-white"
        title="Mostra a posição de cada jogador em vez do número. Aguenta muito mais linhas juntas, mas some com a magnitude — o valor aparece ao passar o mouse."
      >
        Ranking
      </button>

      <button
        type="button"
        data-modo="valor"
        class="px-2.5 py-1 rounded-md text-xs transition-colors text-slate-400 hover:text-white hover:bg-slate-800"
      >
        Valor
      </button>
    </div>
  </div>

  {
    metrics.map((metric, metricIndex) => {
      if (metricIndex !== 0) {
        return (
          <div
            data-metric-chart={metric.id}
            class="hidden"
          />
        );
      }

      const scale = getScale(metric.series);
      const dates = getDates(metric.series);
      const lastDate = getLastDate(dates);

      return (
        <div
          data-metric-chart={metric.id}
          data-rendered="true"
        >
          <div class="overflow-x-auto">
            <svg
              viewBox={`0 0 ${width} ${height}`}
              class="w-full min-w-[600px]"
              role="img"
              aria-label={`Evolução de ${metric.label} do core`}
            >
              {
                Array.from({ length: 5 }).map((_, gridIndex) => {
                  const value =
                    scale.max -
                    (gridIndex / 4) * scale.range;

                  const yPosition =
                    paddingTop +
                    (gridIndex / 4) *
                      (height - paddingTop - paddingBottom);

                  return (
                    <g>
                      <line
                        x1={paddingLeft}
                        y1={yPosition}
                        x2={width - paddingRight}
                        y2={yPosition}
                        stroke="currentColor"
                        class="text-slate-800"
                        stroke-width="1"
                      />

                      <text
                        x={paddingLeft - 8}
                        y={yPosition + 4}
                        text-anchor="end"
                        class="fill-slate-500 text-[11px]"
                      >
                        {formatValue(value)}
                      </text>
                    </g>
                  );
                })
              }

              {
                lastDate !== null && (
                  <g>
                    <line
                      x1={getX(lastDate, dates)}
                      y1={paddingTop}
                      x2={getX(lastDate, dates)}
                      y2={height - paddingBottom}
                      stroke="currentColor"
                      class="text-slate-700"
                      stroke-width="1"
                      stroke-dasharray="4 4"
                    />

                    <text
                      x={getX(lastDate, dates)}
                      y={paddingTop - 8}
                      text-anchor="middle"
                      class="fill-slate-400 text-[10px]"
                    >
                      Atual
                    </text>
                  </g>
                )
              }

              {
                metric.series.map((playerSeries) => {
                  if (playerSeries.data.length === 0) {
                    return null;
                  }

                  const playerColor = getClassColor(
                    playerSeries.playerClass as any
                  );

                  const labelY =
                    getY(
                      playerSeries.data[
                        playerSeries.data.length - 1
                      ].value,
                      scale
                    );

                  return (
                    <g>
                      <polyline
                        points={createPoints(
                          playerSeries.data,
                          scale,
                          dates
                        )}
                        fill="none"
                        stroke="currentColor"
                        class={playerColor}
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />

                      {
                        playerSeries.data.map(
                          (point, pointIndex) => {
                            const isLastPoint =
                              pointIndex === playerSeries.data.length - 1;

                            return (
                              <g>
                                <circle
                                  cx={getX(point.date, dates)}
                                  cy={getY(point.value, scale)}
                                  r={isLastPoint ? 6 : 5}
                                  class={`${playerColor} stroke-slate-950`}
                                  fill="currentColor"
                                  stroke-width={isLastPoint ? "2.5" : "2"}
                                />

                                <text
                                  x={getX(point.date, dates)}
                                  y={getY(point.value, scale) - 11}
                                  text-anchor="middle"
                                  class="fill-slate-400 text-[10px]"
                                >
                                  {formatValue(point.value)}
                                </text>
                              </g>
                            );
                          }
                        )
                      }

                      <text
                        x={width - paddingRight + 5}
                        y={labelY + 4}
                        class="fill-slate-200 text-[10px]"
                      >
                        {playerSeries.playerName}
                      </text>
                    </g>
                  );
                })
              }

              {
                metric.series.some(
                  (item) => item.data.length > 0
                ) && (
                  <g>
                    {
                      getDates(metric.series).map((date, index, dates) => (
                        <text
                          x={getX(date, dates)}
                          y={height - 8}
                          text-anchor="middle"
                          class="fill-slate-500 text-[11px]"
                        >
                          {formatShortDate(date)}
                        </text>
                      ))
                    }
                  </g>
                )
              }
            </svg>
          </div>

          <div class="flex flex-wrap gap-x-5 gap-y-2 mt-4 pt-4 border-t border-slate-800">
            {
              metric.series
                .filter((item) => item.data.length > 0)
                .map((playerSeries) => {
                  const playerColor = getClassColor(
                    playerSeries.playerClass as any
                  );

                  const trend = getTrend(
                    playerSeries.data,
                    metric.direction
                  );

                  return (
                    <div class="flex items-center gap-2 text-xs">
                      <span
                        class={`w-2 h-2 rounded-full ${playerColor}`}
                        style="background-color: currentColor;"
                      />

                      {
                        playerSeries.playerSlug ? (
                          <a
                            href={`/core/membros/${playerSeries.playerSlug}/`}
                            class="text-slate-300 hover:text-white hover:underline transition-colors"
                          >
                            {playerSeries.playerName}
                          </a>
                        ) : (
                          <span class="text-slate-300">
                            {playerSeries.playerName}
                          </span>
                        )
                      }

                      {
                        trend && (
                          <span
                            class={
                              trend.positive === true
                                ? 'text-emerald-400'
                                : trend.positive === false
                                  ? 'text-red-400'
                                  : 'text-slate-500'
                            }
                          >
                            {trend.symbol} {trend.value}
                          </span>
                        )
                      }
                    </div>
                  );
                })
            }
          </div>
        </div>
      );
    })
  }

  <script type="application/json" id="core-performance-data" set:html={JSON.stringify(serializedMetrics)} />
</section>

<script>
  interface DataPoint {
    date: string;
    value: number;
  }

  interface SerializedPlayerSeries {
    playerName: string;
    playerSlug: string | null;
    playerColor: string;
    data: DataPoint[];
  }

  interface SerializedMetric {
    id: string;
    label: string;
    direction: 'higher' | 'lower';
    series: SerializedPlayerSeries[];
  }

  const width = 800;
  const height = 320;
  const paddingLeft = 55;
  const paddingRight = 30;
  const paddingTop = 25;
  const paddingBottom = 35;

  function escapeHtml(value: string): string {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function formatValue(value: number): string {
    if (value >= 1000) {
      return `${(value / 1000).toFixed(1)}k`;
    }
    return value.toString();
  }

  function formatShortDate(iso: string): string {
    const match = iso.match(/^(\d{4})-(\d{2})-(\d{2})/);
    if (!match) return '—';
    return `${match[3]}/${match[2]}`;
  }

  function getScale(series: SerializedPlayerSeries[]) {
    const values = series.flatMap((item) => item.data.map((point) => point.value));

    if (values.length === 0) {
      return { min: 0, max: 100, range: 100 };
    }

    let min = Math.min(...values);
    let max = Math.max(...values);

    if (min === max) {
      min = Math.max(0, min - 1);
      max = max + 1;
    }

    const padding = (max - min) * 0.15;
    min = Math.max(0, min - padding);
    max = max + padding;

    return { min, max, range: max - min || 1 };
  }

  function getX(date: string, dates: string[]): number {
    const chartWidth = width - paddingLeft - paddingRight;
    if (dates.length <= 1) return paddingLeft + chartWidth / 2;
    const index = dates.indexOf(date);
    if (index === -1) return paddingLeft;
    return paddingLeft + (index / (dates.length - 1)) * chartWidth;
  }

  function getY(value: number, scale: ReturnType<typeof getScale>): number {
    const chartHeight = height - paddingTop - paddingBottom;
    return paddingTop + (1 - (value - scale.min) / scale.range) * chartHeight;
  }

  function createPoints(data: DataPoint[], scale: ReturnType<typeof getScale>, dates: string[]): string {
    return data.map((point) => `${getX(point.date, dates)},${getY(point.value, scale)}`).join(' ');
  }

  function getDates(series: SerializedPlayerSeries[]): string[] {
    return [...new Set(series.flatMap((item) => item.data.map((point) => point.date)))].sort((a, b) =>
      a.localeCompare(b)
    );
  }

  function getLastDate(dates: string[]): string | null {
    return dates.length === 0 ? null : dates[dates.length - 1];
  }

  function getTrend(data: DataPoint[], direction: 'higher' | 'lower') {
    if (data.length < 2) return null;

    const previous = data[data.length - 2].value;
    const current = data[data.length - 1].value;
    if (previous === 0) return null;

    const change = Math.round(((current - previous) / Math.abs(previous)) * 100);
    if (change === 0) return { symbol: '→', value: '0%', positive: null as boolean | null };

    const improved = direction === 'higher' ? change > 0 : change < 0;
    return { symbol: change > 0 ? '↑' : '↓', value: `${Math.abs(change)}%`, positive: improved };
  }

  /**
   * Recorta as séries a um mês, sem mexer em mais nada.
   *
   * Devolve séries novas com os pontos filtrados. A série original continua
   * disponível pra quem precisa do período completo — a tendência da legenda
   * e a meta são calculadas em cima dela, não em cima deste recorte.
   */
  function filtrarPorMes(
    metric: SerializedMetric,
    mes: string
  ): SerializedMetric {
    if (mes === 'todos') return metric;

    return {
      ...metric,
      series: metric.series.map((series) => ({
        ...series,
        data: series.data.filter((point) => point.date.slice(0, 7) === mes),
      })),
    };
  }

  /**
   * Posição de cada jogador em cada data.
   *
   * Empate é resolvido pelo nome, não pela ordem em que o jogador apareceu no
   * array: sem isso, dois jogadores com o mesmo valor trocariam de faixa
   * entre um render e outro sem nada ter mudado.
   *
   * Quem não jogou a noite não recebe posição — a linha abre um vão em vez de
   * inventar uma colocação.
   */
  function calcularPosicoes(
    metric: SerializedMetric,
    dates: string[]
  ): Map<string, Map<string, number>> {
    const posicoes = new Map<string, Map<string, number>>();

    for (const date of dates) {
      const presentes = metric.series
        .map((series) => {
          const ponto = series.data.find((point) => point.date === date);
          return ponto ? { nome: series.playerName, valor: ponto.value } : null;
        })
        .filter((item): item is { nome: string; valor: number } => item !== null)
        .sort((a, b) =>
          metric.direction === 'higher'
            ? b.valor - a.valor || a.nome.localeCompare(b.nome)
            : a.valor - b.valor || a.nome.localeCompare(b.nome)
        );

      posicoes.set(date, new Map(presentes.map((item, indice) => [item.nome, indice + 1])));
    }

    return posicoes;
  }

  /**
   * O ranking precisa de mais margem à direita que o gráfico de valor: ali
   * mora o nome de cada jogador, e com 30px ele saía cortado ("Kroli", "Jrxan").
   */
  const paddingRightRanking = 96;

  function getXRanking(date: string, dates: string[]): number {
    const chartWidth = width - paddingLeft - paddingRightRanking;
    if (dates.length <= 1) return paddingLeft + chartWidth / 2;
    const index = dates.indexOf(date);
    if (index === -1) return paddingLeft;
    return paddingLeft + (index / (dates.length - 1)) * chartWidth;
  }

  /** Faixa vertical de uma posição. A 1ª fica no topo. */
  function getYDaPosicao(posicao: number, totalDeFaixas: number): number {
    if (totalDeFaixas <= 1) return paddingTop + (height - paddingTop - paddingBottom) / 2;
    const util = height - paddingTop - paddingBottom;
    return paddingTop + ((posicao - 1) / (totalDeFaixas - 1)) * util;
  }

  /**
   * Bump chart: posição no eixo, não valor.
   *
   * É o que deixa 17 linhas legíveis — as faixas são discretas, então as
   * linhas não se sobrepõem em diagonal. O preço é a magnitude: uma noite em
   * que o raide inteiro melhorou fica igual a uma em que todo mundo caiu. Por
   * isso o valor continua existindo, no <title> de cada ponto.
   */
  function buildRankingSvg(metric: SerializedMetric, dates: string[]): string {
    const posicoes = calcularPosicoes(metric, dates);
    const totalDeFaixas = Math.max(
      1,
      ...dates.map((date) => posicoes.get(date)?.size ?? 0)
    );

    let gridSvg = '';
    for (let faixa = 1; faixa <= totalDeFaixas; faixa += 1) {
      const y = getYDaPosicao(faixa, totalDeFaixas);
      gridSvg += `<g><line x1="${paddingLeft}" y1="${y}" x2="${width - paddingRightRanking}" y2="${y}" stroke="currentColor" class="text-slate-800" stroke-width="1"/><text x="${paddingLeft - 8}" y="${y + 4}" text-anchor="end" class="fill-slate-500 text-[11px]">${faixa}º</text></g>`;
    }

    let seriesSvg = '';
    for (const series of metric.series) {
      const pontos = dates
        .map((date) => {
          const posicao = posicoes.get(date)?.get(series.playerName);
          if (posicao === undefined) return null;
          const valor = series.data.find((point) => point.date === date)?.value ?? 0;
          return {
            date,
            posicao,
            valor,
            x: getXRanking(date, dates),
            y: getYDaPosicao(posicao, totalDeFaixas),
          };
        })
        .filter((item): item is NonNullable<typeof item> => item !== null);

      if (pontos.length === 0) continue;

      // Vão quando o jogador faltou: cada trecho contínuo é uma polyline.
      const trechos: Array<typeof pontos> = [];
      let atual: typeof pontos = [];
      for (const [indice, ponto] of pontos.entries()) {
        const anterior = pontos[indice - 1];
        const seguido = anterior && dates.indexOf(ponto.date) === dates.indexOf(anterior.date) + 1;
        if (anterior && !seguido) {
          trechos.push(atual);
          atual = [];
        }
        atual.push(ponto);
      }
      trechos.push(atual);

      const nomeEscapado = escapeHtml(series.playerName);

      let linhasSvg = '';
      for (const trecho of trechos) {
        if (trecho.length < 2) continue;
        const coordenadas = trecho.map((ponto) => `${ponto.x},${ponto.y}`).join(' ');
        linhasSvg += faixaDeAlcance(coordenadas);
        linhasSvg += `<polyline points="${coordenadas}" fill="none" stroke="currentColor" class="${series.playerColor}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>`;
      }
      let marcasSvg = '';
      for (const ponto of pontos) {
        marcasSvg += `<circle cx="${ponto.x}" cy="${ponto.y}" r="4.5" class="${series.playerColor} stroke-slate-950" fill="currentColor" stroke-width="2"><title>${nomeEscapado} — ${ponto.posicao}º em ${formatShortDate(ponto.date)} · ${formatValue(ponto.valor)}</title></circle>`;
      }

      // Só no fim da linha. A convenção do bump põe nas duas pontas, mas com
      // dezessete jogadores os nomes da esquerda cobriam a numeração das
      // faixas — as posições de 1º a 9º sumiam atrás deles.
      const ultimo = pontos[pontos.length - 1];
      const rotulos = `<text x="${ultimo.x + 8}" y="${ultimo.y + 4}" class="fill-slate-200 text-[10px]">${nomeEscapado}</text>`;

      seriesSvg += `<g class="serie" data-jogador="${nomeEscapado}">${linhasSvg}${marcasSvg}${rotulos}</g>`;
    }

    let labelsSvg = '';
    for (const date of dates) {
      labelsSvg += `<text x="${getXRanking(date, dates)}" y="${height - 8}" text-anchor="middle" class="fill-slate-500 text-[11px]">${formatShortDate(date)}</text>`;
    }

    const dicas = buildDicasDeColuna(metric, dates, getXRanking, posicoes);

    return `<svg viewBox="0 0 ${width} ${height}" class="w-full min-w-[600px]" role="img" aria-label="Ranking de ${escapeHtml(metric.label)} do core">${gridSvg}${seriesSvg}<g>${labelsSvg}</g>${dicas}</svg>`;
  }

/**
   * Faixa invisível e grossa por baixo da linha.
   *
   * Uma linha de 2px é um alvo de mouse frustrante — o ECharts resolve do
   * mesmo jeito. Sem ela, o realce só dispara quando o cursor acerta o
   * traço, e na prática quase nunca acerta.
   */
  function faixaDeAlcance(points: string): string {
    return `<polyline points="${points}" fill="none" stroke="transparent" stroke-width="14" stroke-linecap="round" stroke-linejoin="round"/>`;
  }

  /**
   * Uma caixa por data, escondida, com o dado de todo mundo naquela noite.
   *
   * Poderia ser um retângulo de captura por coluna, resolvido em CSS — mas
   * ele cobriria as linhas e mataria o realce no hover, que é o outro
   * mecanismo desta tela. Aqui as caixas ficam por cima, sem capturar
   * ponteiro, e um único mousemove decide qual aparece.
   */
  function buildDicasDeColuna(
    metric: SerializedMetric,
    dates: string[],
    xDe: (date: string, dates: string[]) => number,
    posicoes?: Map<string, Map<string, number>>
  ): string {
    const alturaLinha = 13;
    const larguraCaixa = 176;

    let svg = '';

    for (const date of dates) {
      const x = xDe(date, dates);

      const linhas = metric.series
        .map((series) => {
          const ponto = series.data.find((item) => item.date === date);
          if (!ponto) return null;
          return {
            nome: series.playerName,
            cor: series.playerColor,
            valor: ponto.value,
            posicao: posicoes?.get(date)?.get(series.playerName),
          };
        })
        .filter((item): item is NonNullable<typeof item> => item !== null)
        .sort((a, b) =>
          metric.direction === 'higher' ? b.valor - a.valor : a.valor - b.valor
        );

      if (linhas.length === 0) continue;

      const alturaCaixa = 34 + linhas.length * alturaLinha;
      // Abre pro lado com espaço: perto da borda direita a caixa sairia da
      // área visível.
      const paraEsquerda = x > width - larguraCaixa - 40;
      const caixaX = paraEsquerda ? x - larguraCaixa - 12 : x + 12;
      const caixaY = Math.max(6, Math.min(paddingTop, height - alturaCaixa - 6));

      let corpo = '';
      linhas.forEach((linha, indice) => {
        const y = caixaY + 30 + indice * alturaLinha;
        const marcador = linha.posicao === undefined ? '' : `${linha.posicao}º `;
        corpo +=
          `<circle cx="${caixaX + 10}" cy="${y - 3}" r="3" class="${linha.cor}" fill="currentColor"/>` +
          `<text x="${caixaX + 18}" y="${y}" class="fill-slate-300 text-[10px]">${escapeHtml(linha.nome)}</text>` +
          `<text x="${caixaX + larguraCaixa - 10}" y="${y}" text-anchor="end" class="fill-slate-400 text-[10px]">${marcador}${formatValue(linha.valor)}</text>`;
      });

      svg +=
        `<g class="dica-coluna" data-date="${date}">` +
        `<line x1="${x}" y1="${paddingTop}" x2="${x}" y2="${height - paddingBottom}" stroke="currentColor" class="text-slate-500" stroke-width="1" stroke-dasharray="3 3"/>` +
        `<rect x="${caixaX}" y="${caixaY}" width="${larguraCaixa}" height="${alturaCaixa}" rx="8" class="fill-[#141b2d] stroke-white/10" stroke-width="1"/>` +
        `<text x="${caixaX + 10}" y="${caixaY + 14}" class="fill-slate-400 text-[10px] font-semibold">${formatShortDate(date)}</text>` +
        corpo +
        `</g>`;
    }

    return svg;
  }

  function buildMetricMarkup(
    metric: SerializedMetric,
    modo: 'valor' | 'ranking',
    completo: SerializedMetric
  ): string {
    const scale = getScale(metric.series);
    const dates = getDates(metric.series);
    const lastDate = getLastDate(dates);

    if (dates.length === 0) {
      return '<p class="text-sm text-slate-500 py-8 text-center">Nenhuma run neste período.</p>';
    }

    let gridSvg = '';
    for (let gridIndex = 0; gridIndex < 5; gridIndex += 1) {
      const value = scale.max - (gridIndex / 4) * scale.range;
      const yPosition = paddingTop + (gridIndex / 4) * (height - paddingTop - paddingBottom);
      gridSvg += `<g><line x1="${paddingLeft}" y1="${yPosition}" x2="${width - paddingRight}" y2="${yPosition}" stroke="currentColor" class="text-slate-800" stroke-width="1"/><text x="${paddingLeft - 8}" y="${yPosition + 4}" text-anchor="end" class="fill-slate-500 text-[11px]">${formatValue(value)}</text></g>`;
    }

    let currentSvg = '';
    if (lastDate !== null) {
      const x = getX(lastDate, dates);
      currentSvg = `<g><line x1="${x}" y1="${paddingTop}" x2="${x}" y2="${height - paddingBottom}" stroke="currentColor" class="text-slate-700" stroke-width="1" stroke-dasharray="4 4"/><text x="${x}" y="${paddingTop - 8}" text-anchor="middle" class="fill-slate-400 text-[10px]">Atual</text></g>`;
    }

    let seriesSvg = '';
    let legendHtml = '';

    for (const playerSeries of metric.series) {
      if (playerSeries.data.length === 0) continue;

      // Do histórico inteiro, de propósito: "↑12%" tem que significar a
      // mesma coisa com ou sem mês selecionado.
      const serieCompleta =
        completo.series.find((item) => item.playerName === playerSeries.playerName) ?? playerSeries;
      const trend = getTrend(serieCompleta.data, metric.direction);
      const lastPoint = playerSeries.data[playerSeries.data.length - 1];
      const labelY = getY(lastPoint.value, scale);
      const points = createPoints(playerSeries.data, scale, dates);

      const nameEscaped = escapeHtml(playerSeries.playerName);

      // O valor saiu de cima de cada ponto: eram 17 jogadores x 8 datas =
      // 136 números empilhados, e nenhum deles legível. Agora ele mora no
      // hover, junto de quem é e de quando foi.
      let pointsSvg = '';
      playerSeries.data.forEach((point, pointIndex) => {
        const isLast = pointIndex === playerSeries.data.length - 1;
        const x = getX(point.date, dates);
        const y = getY(point.value, scale);
        pointsSvg += `<circle cx="${x}" cy="${y}" r="${isLast ? 6 : 5}" class="${playerSeries.playerColor} stroke-slate-950" fill="currentColor" stroke-width="${isLast ? '2.5' : '2'}"><title>${nameEscaped} — ${formatShortDate(point.date)} · ${formatValue(point.value)}</title></circle>`;
      });

      seriesSvg += `<g class="serie" data-jogador="${nameEscaped}">${faixaDeAlcance(points)}<polyline points="${points}" fill="none" stroke="currentColor" class="${playerSeries.playerColor}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>${pointsSvg}<text x="${width - paddingRight + 5}" y="${labelY + 4}" class="fill-slate-200 text-[10px]">${nameEscaped}</text></g>`;

      const trendHtml = trend
        ? `<span class="${trend.positive === true ? 'text-emerald-400' : trend.positive === false ? 'text-red-400' : 'text-slate-500'}">${trend.symbol} ${trend.value}</span>`
        : '';

      const nameHtml = playerSeries.playerSlug
        ? `<a href="/core/membros/${playerSeries.playerSlug}/" class="text-slate-300 hover:text-white hover:underline transition-colors">${nameEscaped}</a>`
        : `<span class="text-slate-300">${nameEscaped}</span>`;

      if (metric.series.length > 1)
        legendHtml += `<div class="legenda-item flex items-center gap-2 text-xs" data-jogador="${nameEscaped}"><span class="w-2 h-2 rounded-full ${playerSeries.playerColor}" style="background-color: currentColor;"></span>${nameHtml}${trendHtml}</div>`;
    }

    let axisSvg = '';
    if (metric.series.some((item) => item.data.length > 0)) {
      let labelsSvg = '';
      dates.forEach((date) => {
        const x = getX(date, dates);
        labelsSvg += `<text x="${x}" y="${height - 8}" text-anchor="middle" class="fill-slate-500 text-[11px]">${formatShortDate(date)}</text>`;
      });
      axisSvg = `<g>${labelsSvg}</g>`;
    }

    const svg =
      modo === 'ranking'
        ? buildRankingSvg(metric, dates)
        : `<svg viewBox="0 0 ${width} ${height}" class="w-full min-w-[600px]" role="img" aria-label="Evolução de ${escapeHtml(metric.label)} do core">${gridSvg}${currentSvg}${seriesSvg}${axisSvg}${buildDicasDeColuna(metric, dates, getX)}</svg>`;

    // No ranking a posição já é a leitura; sem esta nota ninguém descobre que
    // o valor continua ali, no hover de cada ponto.
    const nota =
      modo === 'ranking'
        ? '<p class="text-[11px] text-slate-500 mt-3">Posição na noite, não o número. Passe o mouse num ponto pra ver o valor.</p>'
        : '';

    return `<div class="overflow-x-auto">${svg}</div>${nota}<div class="flex flex-wrap gap-x-5 gap-y-2 mt-4 pt-4 border-t border-slate-800">${legendHtml}</div>`;
  }

  const dataScript = document.querySelector('#core-performance-data');
  const metricsData: SerializedMetric[] = dataScript?.textContent
    ? JSON.parse(dataScript.textContent)
    : [];

  const container = document.querySelector('#core-performance-tabs');
  const barraDeMeses = document.querySelector('#core-performance-meses');
  const barraDeModo = document.querySelector('#core-performance-modo');

  // Estado da VISUALIZAÇÃO. Nada aqui entra em cálculo: a tendência da
  // legenda e a meta seguem lendo a série completa.
  let metricaAtiva = metricsData[0]?.id ?? '';
  let mesAtivo = 'todos';

  /**
   * O modo que a pessoa escolheu — não necessariamente o que está na tela.
   *
   * Métrica de uma linha só (o Hail Score) não tem o que ranquear e cai pra
   * valor. Guardar a escolha separada do que é exibido é o que faz a
   * preferência sobreviver: sem isso, passar pelo Hail Score rebaixava todo
   * mundo pra valor e a escolha da pessoa se perdia no caminho.
   */
  let modoPreferido: 'valor' | 'ranking' = 'ranking';

  function marcarAtivo(botoes: NodeListOf<Element>, ativo: Element) {
    botoes.forEach((botao) => {
      const eAtivo = botao === ativo;
      botao.classList.toggle('bg-slate-700', eAtivo);
      botao.classList.toggle('text-white', eAtivo);
      botao.classList.toggle('text-slate-400', !eAtivo);
    });
  }

  function renderizar() {
    const metric = metricsData.find((item) => item.id === metricaAtiva);
    const alvo = document.querySelector(`[data-metric-chart="${metricaAtiva}"]`);
    if (!metric || !alvo) return;

    // Ranking pressupõe gente pra ranquear. No Hail Score, que é uma linha
    // só do core, o botão some em vez de ficar lá oferecendo um modo que
    // devolveria uma faixa única.
    const daPraRanquear = metric.series.length > 1;
    barraDeModo?.classList.toggle('hidden', !daPraRanquear);

    const modoAtivo = daPraRanquear ? modoPreferido : 'valor';

    // A série COMPLETA vai junto: buildMetricMarkup usa o recorte pra
    // desenhar e o completo pra calcular tendência.
    alvo.innerHTML = buildMetricMarkup(filtrarPorMes(metric, mesAtivo), modoAtivo, metric);

    document.querySelectorAll('[data-metric-chart]').forEach((el) => {
      el.classList.toggle('hidden', el.getAttribute('data-metric-chart') !== metricaAtiva);
    });
  }

  if (container) {
    const botoesDeMetrica = container.querySelectorAll('[data-metric]');

    botoesDeMetrica.forEach((botao) => {
      botao.addEventListener('click', () => {
        const id = botao.getAttribute('data-metric');
        if (!id) return;
        metricaAtiva = id;
        marcarAtivo(botoesDeMetrica, botao);
        renderizar();
      });
    });
  }

  if (barraDeMeses) {
    const botoesDeMes = barraDeMeses.querySelectorAll('[data-mes]');

    botoesDeMes.forEach((botao) => {
      botao.addEventListener('click', () => {
        mesAtivo = botao.getAttribute('data-mes') ?? 'todos';
        marcarAtivo(botoesDeMes, botao);
        renderizar();
      });
    });
  }

  if (barraDeModo) {
    const botoesDeModo = barraDeModo.querySelectorAll('[data-modo]');

    botoesDeModo.forEach((botao) => {
      botao.addEventListener('click', () => {
        modoPreferido = botao.getAttribute('data-modo') === 'ranking' ? 'ranking' : 'valor';
        marcarAtivo(botoesDeModo, botao);
        renderizar();
      });
    });
  }

  /**
   * Passar o mouse num nome da legenda realça a linha dele.
   *
   * Delegação num container que sobrevive ao re-render: o innerHTML do
   * gráfico é trocado a cada mudança de filtro ou de modo, e listener preso
   * na legenda morreria junto.
   */
  function ligarRealceDaLegenda(container: Element) {
    container.addEventListener('mouseover', (evento) => {
      const item = (evento.target as Element).closest?.('.legenda-item');
      if (!item) return;

      const jogador = item.getAttribute('data-jogador');
      container.classList.add('destacando');
      container.querySelectorAll('.serie').forEach((serie) => {
        serie.classList.toggle('destacada', serie.getAttribute('data-jogador') === jogador);
      });
    });

    container.addEventListener('mouseout', (evento) => {
      if ((evento.target as Element).closest?.('.legenda-item')) {
        container.classList.remove('destacando');
      }
    });
  }

  document.querySelectorAll('[data-metric-chart]').forEach(ligarRealceDaLegenda);


  /**
   * Mostra a caixa da coluna mais próxima do cursor.
   *
   * Um mousemove só, no SVG: as caixas não capturam ponteiro, então o realce
   * da linha continua funcionando por baixo — os dois mecanismos convivem em
   * vez de disputar o clique.
   */
  function ligarDicasDeColuna(container: Element) {
    container.addEventListener('mousemove', (evento) => {
      const svg = container.querySelector('svg');
      if (!svg) return;

      const caixas = [...svg.querySelectorAll('.dica-coluna')] as SVGGElement[];
      if (caixas.length === 0) return;

      const area = svg.getBoundingClientRect();
      if (area.width === 0) return;

      // O viewBox é 0 0 800 320 e a altura é automática, então a proporção
      // bate e a conversão é uma regra de três.
      const xNoSvg = (((evento as MouseEvent).clientX - area.left) / area.width) * width;

      let maisPerto: SVGGElement | null = null;
      let menorDistancia = Infinity;

      for (const caixa of caixas) {
        const linha = caixa.querySelector('line');
        const x = Number(linha?.getAttribute('x1') ?? 0);
        const distancia = Math.abs(x - xNoSvg);
        if (distancia < menorDistancia) {
          menorDistancia = distancia;
          maisPerto = caixa;
        }
      }

      for (const caixa of caixas) caixa.classList.toggle('visivel', caixa === maisPerto);
    });

    container.addEventListener('mouseleave', () => {
      container.querySelectorAll('.dica-coluna').forEach((caixa) => caixa.classList.remove('visivel'));
    });
  }

  document.querySelectorAll('[data-metric-chart]').forEach(ligarDicasDeColuna);

  // Troca o desenho do servidor pela versão interativa. O do servidor segue
  // servindo de reserva pra quem estiver sem JS — só não tem realce.
  renderizar();
</script>

<style is:global>
  /*
   * Realce de série no hover — é o `emphasis: { focus: 'series' }` do
   * ECharts: a linha sob o cursor fica cheia e o resto desbota. Com 17
   * linhas cruzando, é o que permite seguir uma delas com o olho.
   *
   * Precisa ser global: o SVG é injetado por innerHTML, e estilo com escopo
   * do Astro só casa com elementos que existiam no build.
   */
  [data-metric-chart] .serie {
    transition: opacity 120ms ease;
  }

  /*
   * :has() e não :hover no <svg>. Com "svg:hover .serie", o cursor entrando
   * na área do gráfico sem tocar em linha nenhuma desbotava as dezessete e
   * não destacava nenhuma — o gráfico inteiro lavava. O esmaecimento só
   * pode existir quando há alguma série de fato em foco.
   */
  [data-metric-chart] svg:has(.serie:hover) .serie {
    opacity: 0.16;
  }

  /* Mesma especificidade da regra acima, declarada depois: quem está sob o
     cursor volta a 100%. */
  [data-metric-chart] svg:has(.serie:hover) .serie:hover {
    opacity: 1;
  }

  /* Realce disparado pela legenda, que é como se acha um jogador específico
     no meio de dezessete linhas. */
  [data-metric-chart].destacando .serie {
    opacity: 0.16;
  }

  [data-metric-chart].destacando .serie.destacada {
    opacity: 1;
  }

  [data-metric-chart] .legenda-item {
    cursor: default;
  }

  /*
   * As caixas de coluna ficam por cima de tudo mas NÃO capturam ponteiro.
   * Se capturassem, cobririam as linhas e o realce no hover nunca
   * dispararia — os dois mecanismos precisam conviver.
   */
  [data-metric-chart] .dica-coluna {
    opacity: 0;
    pointer-events: none;
    transition: opacity 90ms ease;
  }

  [data-metric-chart] .dica-coluna.visivel {
    opacity: 1;
  }
</style>
