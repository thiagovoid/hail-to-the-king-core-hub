---
/**
 * LootTable.astro — Tabela de loots com filtros client-side
 * Exibe todos os loots com filtros por Semana, Jogador e Boss.
 * Os filtros operam no DOM via dataset e script inline.
 *
 * Requirements: 7.1, 7.3, 7.4, 7.5
 */

import type { Loot, Player } from "@/types/index";
import { formatDate } from "@/utils/format";

interface Props {
  loots: Loot[];
  players: Player[];
}

const { loots, players } = Astro.props;

// Build player lookup map: id → name
const playerMap = new Map<string, string>(
  players.map((p) => [p.id, p.name])
);

// Helper: derive human-readable boss name from kebab-case id
function bossDisplayName(bossId: string): string {
  return bossId
    .split("-")
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(" ");
}

// Unique sorted weeks
const uniqueWeeks = [...new Set(loots.map((l) => l.week))].sort((a, b) => a - b);

// Unique player ids (sorted by display name)
const uniquePlayerIds = [...new Set(loots.map((l) => l.player))].sort((a, b) => {
  const nameA = playerMap.get(a) ?? a;
  const nameB = playerMap.get(b) ?? b;
  return nameA.localeCompare(nameB);
});

// Unique boss ids (sorted by display name)
const uniqueBossIds = [...new Set(loots.map((l) => l.boss))].sort((a, b) =>
  bossDisplayName(a).localeCompare(bossDisplayName(b))
);
---

<div class="space-y-4">
  <!-- Filters row -->
  <div
    class="flex flex-wrap gap-4 items-end p-4 rounded-lg bg-[#1a2030] border border-slate-700/50"
    role="search"
    aria-label="Filtros de loot"
  >
    <!-- Semana filter -->
    <div class="flex flex-col gap-1 min-w-[140px]">
      <label
        for="filter-week"
        class="text-xs font-semibold uppercase tracking-wider text-slate-400"
      >
        Semana
      </label>
      <select
        id="filter-week"
        class="bg-[#0d1117] border border-slate-700/50 text-slate-200 text-sm rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#f0a500]/50 focus:border-[#f0a500]/50 cursor-pointer"
      >
        <option value="">Todas</option>
        {uniqueWeeks.map((week) => (
          <option value={String(week)}>Semana {week}</option>
        ))}
      </select>
    </div>

    <!-- Jogador filter -->
    <div class="flex flex-col gap-1 min-w-[160px]">
      <label
        for="filter-player"
        class="text-xs font-semibold uppercase tracking-wider text-slate-400"
      >
        Jogador
      </label>
      <select
        id="filter-player"
        class="bg-[#0d1117] border border-slate-700/50 text-slate-200 text-sm rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#f0a500]/50 focus:border-[#f0a500]/50 cursor-pointer"
      >
        <option value="">Todos</option>
        {uniquePlayerIds.map((pid) => (
          <option value={pid}>{playerMap.get(pid) ?? pid}</option>
        ))}
      </select>
    </div>

    <!-- Boss filter -->
    <div class="flex flex-col gap-1 min-w-[200px]">
      <label
        for="filter-boss"
        class="text-xs font-semibold uppercase tracking-wider text-slate-400"
      >
        Boss
      </label>
      <select
        id="filter-boss"
        class="bg-[#0d1117] border border-slate-700/50 text-slate-200 text-sm rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#f0a500]/50 focus:border-[#f0a500]/50 cursor-pointer"
      >
        <option value="">Todos</option>
        {uniqueBossIds.map((bossId) => (
          <option value={bossId}>{bossDisplayName(bossId)}</option>
        ))}
      </select>
    </div>

    <!-- Clear filters button -->
    <button
      id="clear-filters"
      type="button"
      aria-label="Limpar todos os filtros"
      class="px-3 py-2 text-sm text-slate-400 hover:text-slate-200 border border-slate-700/50 rounded hover:border-slate-600 transition-colors"
    >
      Limpar filtros
    </button>
  </div>

  <!-- Table -->
  <div aria-live="polite" aria-atomic="false">
  <div class="overflow-x-auto rounded-lg border border-slate-700/50">
    <table
      class="w-full text-sm"
      aria-label="Tabela de loots do raid"
    >
      <thead>
        <tr class="bg-[#1a2030] border-b border-slate-700/50">
          <th
            scope="col"
            class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-400 w-28"
          >
            Data
          </th>
          <th
            scope="col"
            class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-400"
          >
            Jogador
          </th>
          <th
            scope="col"
            class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-400"
          >
            Item
          </th>
          <th
            scope="col"
            class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-400"
          >
            Boss
          </th>
        </tr>
      </thead>
      <tbody id="loot-tbody" class="divide-y divide-slate-700/30">
        {loots.map((loot) => {
          const playerName = playerMap.get(loot.player) ?? loot.player;
          const playerClass = players.find((p) => p.id === loot.player)?.class ?? "";
          return (
            <tr
              class="hover:bg-[#1a2030]/60 transition-colors"
              data-week={String(loot.week)}
              data-player={loot.player}
              data-boss={loot.boss}
            >
              <!-- Data -->
              <td class="px-4 py-3 text-slate-400 tabular-nums text-xs whitespace-nowrap">
                <time datetime={loot.date}>{formatDate(loot.date)}</time>
              </td>

              <!-- Jogador -->
              <td class="px-4 py-3">
                <span class={`font-medium class-${playerClass || "unknown"}`}>
                  {playerName}
                </span>
              </td>

              <!-- Item (nome + item level) -->
              <td class="px-4 py-3">
                <span class="text-slate-200 font-medium">{loot.itemName}</span>
                <span class="ml-2 inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-[#f0a500]/10 border border-[#f0a500]/20 text-[#f0a500]">
                  ilvl {loot.itemLevel}
                </span>
              </td>

              <!-- Boss -->
              <td class="px-4 py-3 text-slate-400">
                {bossDisplayName(loot.boss)}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
  </div>

  <!-- Empty state (hidden by default) -->
  <p
    id="loot-empty"
    class="hidden text-slate-400 text-center py-10"
    role="status"
    aria-live="polite"
  >
    Nenhum loot encontrado para os filtros selecionados.
  </p>
</div>

<script>
  (function () {
    const tbody = document.getElementById("loot-tbody");
    const emptyMsg = document.getElementById("loot-empty");
    const selectWeek = document.getElementById("filter-week") as HTMLSelectElement | null;
    const selectPlayer = document.getElementById("filter-player") as HTMLSelectElement | null;
    const selectBoss = document.getElementById("filter-boss") as HTMLSelectElement | null;
    const clearBtn = document.getElementById("clear-filters");

    if (!tbody || !emptyMsg || !selectWeek || !selectPlayer || !selectBoss) return;

    function filterLoots(): void {
      const week = selectWeek!.value;
      const player = selectPlayer!.value;
      const boss = selectBoss!.value;

      const rows = tbody!.querySelectorAll<HTMLTableRowElement>("tr");
      let visibleCount = 0;

      rows.forEach((row) => {
        const matchWeek = !week || row.dataset.week === week;
        const matchPlayer = !player || row.dataset.player === player;
        const matchBoss = !boss || row.dataset.boss === boss;

        if (matchWeek && matchPlayer && matchBoss) {
          row.style.display = "";
          visibleCount++;
        } else {
          row.style.display = "none";
        }
      });

      // Toggle empty state
      if (visibleCount === 0) {
        emptyMsg!.classList.remove("hidden");
      } else {
        emptyMsg!.classList.add("hidden");
      }
    }

    selectWeek.addEventListener("change", filterLoots);
    selectPlayer.addEventListener("change", filterLoots);
    selectBoss.addEventListener("change", filterLoots);

    clearBtn?.addEventListener("click", () => {
      selectWeek!.value = "";
      selectPlayer!.value = "";
      selectBoss!.value = "";
      filterLoots();
    });
  })();
</script>
