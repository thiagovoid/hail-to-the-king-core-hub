---
/**
 * Uma linha do Score geral, em colunas alinhadas.
 *
 * Antes era nome na borda esquerda e número na direita, com a barra ocupando
 * tudo no meio: cinco dimensões viravam cinco viagens de olho. Aqui o valor
 * fica logo depois do nome, e como as colunas são fixas os números de
 * dimensões diferentes alinham na vertical, o que deixa comparar de relance.
 */
import { TETO_DA_SUB_NOTA } from '@/engine/metrics';
import type { ScoreDimension } from '@/engine/scores';
import { formatDecimalBr } from '@/utils/format';
import InfoTooltip from '@/components/InfoTooltip.astro';

interface Props {
  dimension: ScoreDimension;
  /** Mostra a seta no fim da linha. Quem não tem detalhe não ganha afordância. */
  temDetalhe?: boolean;
  /** Quantos itens o detalhe tem, quando faz sentido contar. */
  itensDetalhe?: number;
  /**
   * O que o detalhe mostra ("Ver quais mecânicas"). Só pra leitor de tela:
   * na tela a seta e a contagem bastam, mas sem isto quem navega por áudio
   * ouviria um botão sem nome.
   */
  rotuloDetalhe?: string;
  /**
   * O fator de sobrevivência já formatado ("0,91"), só na linha de
   * Sobreviver e só quando ele mordeu. Sem ele a linha diz "multiplica",
   * que é verdade mas não é o número.
   */
  multiplicador?: string | null;
}

const {
  dimension,
  temDetalhe = false,
  itensDetalhe = 0,
  rotuloDetalhe = '',
  multiplicador = null,
} = Astro.props;

const bateuAMeta =
  dimension.value !== null &&
  (dimension.target.direction === 'higher'
    ? dimension.value >= dimension.target.target
    : dimension.value <= dimension.target.target);

const cor = bateuAMeta
  ? { barra: 'bg-emerald-500', texto: 'text-emerald-400' }
  : (dimension.score ?? 0) >= 80
    ? { barra: 'bg-amber-500', texto: 'text-amber-400' }
    : { barra: 'bg-red-500', texto: 'text-red-400' };

/**
 * Quanto passou da meta, em vez de "100% da meta" pra todo mundo que passou.
 *
 * Defender com 57,7 contra meta 30 aparecia igualzinho a Mecânicas batendo
 * exatamente 2: tudo que cruza a linha vira 100% e fica indistinguível.
 * Aqui quem raspou lê "na meta" e quem dobrou lê "+92%".
 */
/**
 * O selo mostra a NOTA — a mesma que o Score soma.
 *
 * Ele mostrava a folga crua ("+92%") quando a meta era cumprida, e a nota
 * ("115") só existia dentro do tooltip do Score geral. Dois números pra
 * mesma dimensão, e quem tentasse conferir de onde saiu o 115 não achava
 * em lugar nenhum da tela.
 *
 * A folga continua existindo, no título: ela diz QUANTO se passou da meta,
 * que a nota comprime (ela para em 115 por mais que se passe).
 */
function notaDaDimensao() {
  if (dimension.value === null || dimension.score === null) return null;

  const { target, direction } = dimension.target;

  /**
   * Sobreviver não tem "nota" na conta — ela multiplica.
   *
   * Com o selo dizendo "nota 47" como todas as outras, a pessoa ia procurar
   * o 47 na soma do tooltip e não ia achar: lá ele aparece como "×  0,89",
   * que é outro número e vem de outra conta. O que ela precisa saber é que
   * esta linha não entra na média.
   */
  if (dimension.key === 'survival') {
    return {
      texto: 'não soma',
      titulo: multiplicador
        ? `Multiplica a nota final por ${multiplicador} em vez de entrar na média`
        : 'Multiplica a nota final em vez de entrar na média',
    };
  }

  const texto = `nota ${dimension.score}`;

  if (!bateuAMeta) {
    return { texto, titulo: `${dimension.score}% do caminho até a meta` };
  }

  if (target === 0) return { texto, titulo: 'na meta' };

  // Em "quanto menor melhor" a folga é o quanto ficou ABAIXO da meta.
  const folga =
    direction === 'higher' ? dimension.value / target - 1 : 1 - dimension.value / target;
  const pontos = Math.round(folga * 100);

  if (pontos <= 0) return { texto, titulo: 'exatamente na meta' };

  return {
    texto,
    titulo:
      (direction === 'higher' ? `${pontos}% acima da meta` : `${pontos}% abaixo da meta`) +
      ' — a nota comprime a folga e para em 115',
  };
}

const progresso = notaDaDimensao();

const direcao = dimension.target.direction === 'higher' ? 'quanto maior, melhor' : 'quanto menor, melhor';

/**
 * A seta ao lado da unidade.
 *
 * A tela mistura métricas onde maior é melhor (uptime, cura) com outras
 * onde menor é melhor (erros por try, tempo morto). Quem se acostuma a ler
 * "número maior = melhor" tropeça na próxima linha. A direção estava só no
 * `title`, que ninguém lê sem motivo.
 */
const seta = dimension.target.direction === 'higher' ? '↑' : '↓';

/**
 * A barra vai até o TETO da nota, não até a meta.
 *
 * Enchendo a barra na meta, cumprir o mínimo parecia ter chegado ao fim do
 * caminho — e quem passava da meta não tinha pra onde crescer na tela. A
 * escala agora é 0 até o teto (115), com a meta marcada por um tracejado a
 * 87% da largura: sobra barra visível depois dela, que é a folga.
 *
 * Serve pras duas direções sem conta especial, porque o score já normaliza
 * o sentido: 100 é a meta cumprida venha ela de "maior melhor" ou do
 * contrário.
 */
const META_NA_BARRA = (100 / TETO_DA_SUB_NOTA) * 100;

const larguraDaBarra =
  dimension.score === null
    ? null
    : Math.min(100, (dimension.score / TETO_DA_SUB_NOTA) * 100);
---

<div class="linha">
  <div class="celula-nome">
    <span class="text-slate-300 font-medium">{dimension.label}</span>
    {/* "0%" era mentira em dois casos diferentes. Sobreviver tem peso zero
        porque MULTIPLICA a nota em vez de ser parcela dela — o Bustgril em
        15/09 passou 19,1% da noite morto e levou a nota inteira pra 91% do
        que valia, o oposto de "não conta". E Curar com peso zero num dps é
        dimensão que não é o ofício dele: ali não há percentual nenhum a
        mostrar, e um "0%" só faz parecer que alguma coisa foi zerada. */}
    {dimension.key === 'survival' ? (
      <span class="text-slate-600 text-[10px]" title="Multiplica a nota final em vez de somar">
        {multiplicador ? `× ${multiplicador}` : 'multiplica'}
      </span>
    ) : (
      dimension.weight > 0 && <span class="text-slate-600 text-[10px]">{dimension.weight}%</span>
    )}

    <InfoTooltip label={`O que é ${dimension.label}`}>
      <span class="block text-slate-200 text-[11px] leading-relaxed">{dimension.description}</span>
      <span class="block text-slate-400 text-[11px] leading-relaxed mt-2">
        <span class="text-slate-500 font-semibold">Fonte:</span> {dimension.source}
      </span>
      <span class="block text-slate-400 text-[11px] leading-relaxed mt-2">
        <span class="text-slate-500 font-semibold">Meta do core:</span>{' '}
        {formatDecimalBr(dimension.target.target)} ({direcao})
      </span>
    </InfoTooltip>
  </div>

  {dimension.value !== null ? (
    <>
      <div class={`celula-valor ${cor.texto}`}>{formatDecimalBr(dimension.value)}</div>
      <div class="celula-unidade">
        {dimension.unit} <span class="text-slate-600" title={direcao}>{seta}</span>
      </div>
      <div class="celula-meta">meta {formatDecimalBr(dimension.target.target)}</div>
    </>
  ) : (
    <div class="celula-semdado">sem dado</div>
  )}

  <div class="celula-barra">
    <div class="relative h-1.5 bg-slate-800 rounded-full">
      <div class="absolute inset-0 rounded-full overflow-hidden">
        {larguraDaBarra !== null && (
          <div class={`h-full rounded-full ${cor.barra}`} style={`width: ${larguraDaBarra}%`} />
        )}
      </div>

      {/* A meta, tracejada. Fica POR CIMA do preenchimento pra continuar
          legível quando a pessoa passa dela — que é justamente a hora em
          que saber onde ela estava importa. */}
      {/* 2px e mais contraste: a 1px numa barra de 6px de altura o
          tracejado sumia, e a meta é a referência que dá sentido ao resto
          do desenho. Sobra pra fora da barra em cima e embaixo pra não se
          confundir com o preenchimento. */}
      <span
        class="absolute top-[-4px] bottom-[-4px] w-0 border-l-2 border-dashed border-slate-300/85"
        style={`left: ${META_NA_BARRA}%`}
        title={`Meta: ${formatDecimalBr(dimension.target.target)} (${direcao})`}
        aria-hidden="true"
      />
    </div>
  </div>

  <div class={`celula-progresso ${progresso ? cor.texto : 'text-slate-600'}`} title={progresso?.titulo}>
    {progresso?.texto ?? ''}
  </div>

  <div class="celula-seta">
    {temDetalhe && (
      <span class="inline-flex items-center gap-1 text-slate-500">
        <svg class="seta w-2.5 h-2.5 shrink-0" viewBox="0 0 8 10" fill="currentColor" aria-hidden="true">
          <path d="M0 0l8 5-8 5z" />
        </svg>
        {itensDetalhe > 0 && <span class="text-[10px] text-slate-600">{itensDetalhe}</span>}
        {rotuloDetalhe && <span class="sr-only">{rotuloDetalhe}</span>}
      </span>
    )}
  </div>
</div>

<style>
  /* Empilhado no celular, onde não cabe coluna; em colunas fixas a partir do
     tablet, que é onde o alinhamento vertical entre dimensões compensa. */
  .linha {
    display: grid;
    align-items: center;
    gap: 0.25rem 0.625rem;
    grid-template-columns: 1fr auto auto;
    grid-template-areas:
      'nome      nome   seta'
      'valor     unidade meta'
      'barra     barra  progresso';
    font-size: 0.75rem;
  }

  @media (min-width: 768px) {
    .linha {
      grid-template-columns: 10.5rem 3.25rem 6.75rem 4.25rem 1fr 3.5rem 1.75rem;
      grid-template-areas: 'nome valor unidade meta barra progresso seta';
      gap: 0 0.625rem;
    }
  }

  .celula-nome {
    grid-area: nome;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    min-width: 0;
  }

  /* Números à direita na própria coluna e unidades à esquerda na sua: é o
     que faz 47, 2 e 95,9 alinharem uns sob os outros. */
  .celula-valor {
    grid-area: valor;
    text-align: right;
    font-weight: 600;
  }

  .celula-unidade {
    grid-area: unidade;
    color: rgb(100 116 139);
  }

  .celula-meta {
    grid-area: meta;
    color: rgb(71 85 105);
    text-align: right;
  }

  .celula-semdado {
    grid-area: valor / valor / meta / meta;
    color: rgb(71 85 105);
  }

  .celula-barra {
    grid-area: barra;
    min-width: 0;
  }

  .celula-progresso {
    grid-area: progresso;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .celula-seta {
    grid-area: seta;
    display: flex;
    justify-content: flex-end;
  }
</style>
