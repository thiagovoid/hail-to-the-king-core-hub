---
/**
 * Pra qual conteúdo o jogador está pronto, e o que falta pro próximo degrau.
 *
 * Mostra SÓ o degrau seguinte. Quem está no limiar do normal não precisa
 * ver o que o mítico exige — a distância desmotiva e não informa: o caminho
 * passa pelo heroico de qualquer jeito.
 *
 * O Raider.IO aparece ao lado, como contexto, nunca como porteiro. Ele mede
 * Mythic+, e o dado do core mostra onde isso erra: a Ligiaf tem IO 1939 e
 * parse 47; o Dagom tem IO 2446 e parse 15.
 */
import { ROTULO_DO_NIVEL, type ProntidaoDoJogador } from '@/engine/scores/prontidao';
import InfoTooltip from '@/components/InfoTooltip.astro';

interface Props {
  prontidao: ProntidaoDoJogador;
  /** Quantas noites entraram na média — sem isso o número não é auditável. */
  noites: number;
}

const { prontidao, noites } = Astro.props;

const CORES = {
  normal: { texto: 'text-emerald-400', borda: 'border-emerald-500/30', fundo: 'bg-emerald-500/10' },
  heroico: { texto: 'text-sky-400', borda: 'border-sky-500/30', fundo: 'bg-sky-500/10' },
  mitico: { texto: 'text-purple-400', borda: 'border-purple-500/30', fundo: 'bg-purple-500/10' },
} as const;

const atual = prontidao.nivel ? CORES[prontidao.nivel] : null;
const proximo = prontidao.proximo ? CORES[prontidao.proximo] : null;

/** "1,5" em vez de "1.5" — e sem casa decimal inventada. */
const numero = (valor: number | null) =>
  valor === null ? '—' : String(Math.round(valor * 10) / 10).replace('.', ',');
---

<section class="mb-10">
  <div class="mb-4">
    <div class="inline-flex items-center gap-2 flex-wrap">
      <h2 class="text-xl font-bold text-white">Prontidão de conteúdo</h2>

      <InfoTooltip label="Como a prontidão é apurada">
        <span class="block text-[11px] text-slate-400 leading-relaxed">
          Prontidão é sobre consistência, não sobre a melhor noite — por isso a média da temporada
          e não o seu recorde.
        </span>

        <span class="block text-[11px] text-slate-400 leading-relaxed mt-2">
          Critério sem dado não reprova ninguém: a lacuna é da coleta, não sua.
        </span>
      </InfoTooltip>
    </div>

    <p class="text-sm text-slate-400 mt-1">
      Média de {noites} {noites === 1 ? 'noite' : 'noites'} da temporada.
    </p>
  </div>

  <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-5">
    <div class="flex flex-wrap items-center gap-3 mb-5">
      <span
        class={`inline-flex items-center px-3 py-1.5 rounded-lg border text-sm font-bold ${
          atual ? `${atual.fundo} ${atual.borda} ${atual.texto}` : 'bg-slate-800/50 border-slate-700 text-slate-400'
        }`}
      >
        {prontidao.nivel ? ROTULO_DO_NIVEL[prontidao.nivel] : 'Em formação'}
      </span>

      {prontidao.perfilDeChave && (
        <span class="text-[11px] text-slate-500">
          Perfil de chave: {ROTULO_DO_NIVEL[prontidao.perfilDeChave]} —{' '}
          <span class="text-slate-600">mede Mythic+, não raide</span>
        </span>
      )}
    </div>

    {
      prontidao.proximo === null ? (
        <p class="text-sm text-slate-300">
          Você cumpre tudo que o core mede. Daqui pra frente a régua é você contra você.
        </p>
      ) : (
        <>
          <p class={`text-xs uppercase tracking-wide font-semibold mb-3 ${proximo!.texto}`}>
            Pra chegar em {ROTULO_DO_NIVEL[prontidao.proximo]}
          </p>

          <ul class="space-y-2">
            {prontidao.criterios.map((criterio) => (
              <li class="flex items-baseline justify-between gap-3 text-[12px]">
                <span class="flex items-baseline gap-2 min-w-0">
                  <span class={criterio.cumpre ? 'text-emerald-400' : 'text-slate-600'}>
                    {criterio.cumpre ? '✓' : '○'}
                  </span>
                  <span class={criterio.cumpre ? 'text-slate-500' : 'text-slate-300'}>
                    {criterio.rotulo}
                  </span>
                </span>

                <span class="tabular-nums shrink-0">
                  <span class={criterio.cumpre ? 'text-slate-500' : 'text-slate-200 font-semibold'}>
                    {numero(criterio.valor)}
                  </span>
                  <span class="text-slate-600">
                    {' '}
                    {criterio.menorEMelhor ? 'de no máx.' : 'de'} {numero(criterio.exigido)}
                  </span>
                </span>
              </li>
            ))}
          </ul>

          {prontidao.falta.length > 0 && (
            <p class="text-[11px] text-slate-500 leading-relaxed mt-4 pt-3 border-t border-white/5">
              Falta {prontidao.falta.length === 1 ? 'uma coisa' : `${prontidao.falta.length} coisas`}
              : <span class="text-slate-300">{prontidao.falta.map((c) => c.rotulo).join(', ')}</span>.
              Os níveis existem pra ninguém ser empurrado pra conteúdo que ainda não faz sentido —
              não pra separar quem presta de quem não presta.
            </p>
          )}
        </>
      )
    }
  </div>
</section>
