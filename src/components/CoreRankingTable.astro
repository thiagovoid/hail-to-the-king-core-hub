---
import type { CoreRankingEntry } from '@/engine/team';

interface Props {
  ranking: CoreRankingEntry[];
}

const { ranking } = Astro.props;

const scored = ranking.filter((entry) => entry.overall !== null);

const scoreColor = (value: number) =>
  value >= 80 ? 'text-emerald-400' : value >= 50 ? 'text-amber-400' : 'text-red-400';
---

<section aria-labelledby="ranking-heading">
  <div class="flex items-center gap-3 mb-6">
    <div class="h-px flex-1 bg-white/5" aria-hidden="true" />
    <h2 id="ranking-heading" class="text-slate-400 text-xs font-semibold uppercase tracking-widest px-2">
      Ranking do Core — Semana Atual
    </h2>
    <div class="h-px flex-1 bg-white/5" aria-hidden="true" />
  </div>

  {
    scored.length === 0 ? (
      <p class="text-slate-400 text-center py-10">
        Ainda não há Score geral suficiente pra montar o ranking desta semana.
      </p>
    ) : (
      <div class="overflow-x-auto rounded-lg border border-slate-700/50">
        <table class="w-full text-sm" aria-label="Ranking do core por Score geral">
          <thead>
            <tr class="bg-[#1a2030] border-b border-slate-700/50">
              <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-400 w-10">
                #
              </th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">
                Jogador
              </th>
              <th scope="col" class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-400 w-32">
                Score geral
              </th>
            </tr>
          </thead>

          <tbody class="divide-y divide-slate-700/30">
            {scored.map((entry, index) => (
              <tr class="hover:bg-[#1a2030]/60 transition-colors">
                <td class="px-4 py-3 text-slate-400 tabular-nums font-medium">{index + 1}</td>
                <td class="px-4 py-3 text-slate-200 font-medium">
                  <a href={`/core/membros/${entry.playerId}/`} class="hover:text-[#f0a500] transition-colors">
                    {entry.playerName}
                  </a>
                </td>
                <td class={`px-4 py-3 text-right tabular-nums font-bold ${scoreColor(entry.overall as number)}`}>
                  {entry.overall}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</section>
