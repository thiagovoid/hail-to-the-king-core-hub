---
/**
 * LootStats.astro — Estatísticas de loot por jogador
 * Calcula e exibe total de loots, último loot e média/mês por jogador.
 *
 * Requirements: 7.2
 */

import type { Loot, Player } from "@/types/index";
import { computeLootStats } from "@/utils/loot";
import { formatDate, formatValue } from "@/utils/format";

interface Props {
  loots: Loot[];
  players: Player[];
}

const { loots, players } = Astro.props;

// Build player lookup map: id → Player
const playerMap = new Map<string, Player>(players.map((p) => [p.id, p]));

// Compute raw stats (playerName field is the raw id)
const rawStats = computeLootStats(loots);

// Enrich with display names and class from roster
const stats = rawStats
  .map((s) => {
    const player = playerMap.get(s.playerId);
    return {
      ...s,
      playerName: player?.name ?? s.playerId,
      playerClass: player?.class ?? "",
    };
  })
  .sort((a, b) => b.totalLoots - a.totalLoots);
---

<div class="overflow-x-auto rounded-lg border border-slate-700/50">
  <table
    class="w-full text-sm"
    aria-label="Estatísticas de loot por jogador"
  >
    <thead>
      <tr class="bg-[#1a2030] border-b border-slate-700/50">
        <th
          scope="col"
          class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-400 w-8"
        >
          #
        </th>
        <th
          scope="col"
          class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-400"
        >
          Jogador
        </th>
        <th
          scope="col"
          class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-400 w-28"
        >
          Total Loots
        </th>
        <th
          scope="col"
          class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-400 w-36"
        >
          Último Loot
        </th>
        <th
          scope="col"
          class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-400 w-32"
        >
          Média / Mês
        </th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-700/30">
      {stats.map((s, index) => (
        <tr class="hover:bg-[#1a2030]/60 transition-colors">
          <!-- Rank -->
          <td class="px-4 py-3 text-slate-500 tabular-nums font-medium">
            {index + 1}
          </td>

          <!-- Jogador -->
          <td class="px-4 py-3">
            <span class={`font-semibold class-${s.playerClass || "unknown"}`}>
              {s.playerName}
            </span>
          </td>

          <!-- Total loots -->
          <td class="px-4 py-3 text-right">
            <span class="inline-flex items-center justify-center px-2.5 py-0.5 rounded-full bg-[#f0a500]/10 border border-[#f0a500]/30 text-[#f0a500] font-bold tabular-nums">
              {s.totalLoots}
            </span>
          </td>

          <!-- Último loot -->
          <td class="px-4 py-3 text-right text-slate-400 tabular-nums text-xs">
            {s.lastLootDate
              ? <time datetime={s.lastLootDate}>{formatDate(s.lastLootDate)}</time>
              : <span>{formatValue(null)}</span>
            }
          </td>

          <!-- Média / mês -->
          <td class="px-4 py-3 text-right">
            <span class="text-[#00c48c] font-medium tabular-nums">
              {formatValue(s.avgPerMonth)}
            </span>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
