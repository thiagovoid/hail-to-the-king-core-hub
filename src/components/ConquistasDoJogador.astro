---
/**
 * As conquistas do jogador na temporada.
 *
 * Mérito e zoeira ficam em prateleiras separadas porque são coisas
 * diferentes: uma é o que a pessoa conquistou, a outra é o que o grupo acha
 * engraçado nela. Misturadas, "Chão é lava" ao lado de "MVP da noite" lê
 * como se as duas fossem julgamento.
 *
 * As que ele não tem aparecem esmaecidas e trancadas, com o texto de como se
 * consegue — é o que transforma a lista em objetivo em vez de placar.
 */
import { CONQUISTAS, type ConquistaGanha } from '@/engine/guild/conquistas';
import type { ConquistaAoAlcance } from '@/engine/guild/aoSeuAlcance';
import MedalhaDeConquista from '@/components/MedalhaDeConquista.astro';
import { formatDate } from '@/utils/format';

interface Props {
  /** O que o jogador levou, por id de conquista. */
  ganhas?: Map<string, ConquistaGanha>;
  /**
   * Trial não tem badge. Chegar num grupo novo e encontrar uma parede de
   * medalhas travadas é o contrário de acolhedor, e conquista é coisa de
   * quem já é de casa.
   */
  elegivel?: boolean;
  /**
   * Quando esta ficha é de um ALT: pra onde as medalhas foram.
   *
   * Duas estantes pro mesmo jogador dividiriam a temporada dele em duas
   * metades — e é justamente o que as conquistas de presença e sequência
   * não podem fazer com quem trocou de personagem pra compor o raide.
   */
  remeteAo?: { id: string; nome: string };
  /** Os outros personagens da mesma pessoa, pra nomear o que está somado. */
  tambemJoga?: string[];
  /**
   * `id` do personagem -> nome de exibição, pra dizer em qual deles cada
   * medalha foi conquistada.
   */
  nomeDoPersonagem?: Record<string, string>;
  /**
   * Data (YYYY-MM-DD) em que a zoeira passou a contar nesta temporada.
   *
   * A tela PRECISA dizer isso: um sistema que decide em silêncio que metade
   * das medalhas não retroage é pior que qualquer uma das duas escolhas.
   */
  zoeiraDesde?: string;
  /**
   * As mais perto de cair. Entram EM CIMA da parede, sem tirar nada dela.
   *
   * Uma parede de 53 medalhas com 45 trancadas não diz por onde começar —
   * e esconder as trancadas seria fingir que não existe um degrau ali.
   */
  aoAlcance?: ConquistaAoAlcance[];
}

const {
  ganhas = new Map<string, ConquistaGanha>(),
  elegivel = true,
  remeteAo = undefined,
  tambemJoga = [],
  nomeDoPersonagem = {},
  zoeiraDesde = undefined,
  aoAlcance = [],
} = Astro.props;

/**
 * Em qual personagem a medalha foi conquistada.
 *
 * Só vale a pena dizer pra quem tem mais de um: "MVP — Kroline" na ficha da
 * Kroline não acrescenta nada. Quem tem alt, sim — o Severino do Xúlio só
 * existe por causa do DK dele.
 */
const temMaisDeUm = tambemJoga.length > 0;

const nomesDosPersonagens = (ids?: string[]): string[] =>
  temMaisDeUm && ids?.length ? ids.map((id) => nomeDoPersonagem[id] ?? id) : [];

const medalhas = CONQUISTAS.map((conquista) => ({
  conquista,
  ganha: ganhas.get(conquista.id),
}));

// Conquistadas primeiro, e entre elas as mais repetidas na frente. As
// travadas ficam juntas no fim, onde leem como "o que falta".
const ordenar = (lista: typeof medalhas) =>
  [...lista].sort((a, b) => (b.ganha?.vezes ?? 0) - (a.ganha?.vezes ?? 0));

const prateleiras = [
  {
    titulo: 'Conquistas',
    nota: 'O que você fez de melhor na temporada.',
    rodape: undefined as string | undefined,
    itens: ordenar(medalhas.filter((item) => item.conquista.tipo === 'boa')),
  },
  {
    titulo: 'Pra rir de si mesmo',
    nota: 'O currículo que ninguém pediu.',
    // Rodapé, não subtítulo: é informação de regra, e em cima da prateleira
    // ela pesava mais que as medalhas.
    rodape: zoeiraDesde
      ? `Contam a partir de ${formatDate(zoeiraDesde)} · zeram a cada temporada`
      : undefined,
    itens: ordenar(medalhas.filter((item) => item.conquista.tipo === 'zoeira')),
  },
];

const desbloqueadas = medalhas.filter((item) => (item.ganha?.vezes ?? 0) > 0).length;
const totalGanho = medalhas.reduce((soma, item) => soma + (item.ganha?.vezes ?? 0), 0);
---

{
  elegivel ? (
    <section class="mb-10">
      <div class="mb-4">
        <h2 class="text-xl font-bold text-white">Medalhas</h2>

        <p class="text-sm text-slate-400 mt-1">
          {desbloqueadas} de {CONQUISTAS.length} desbloqueadas
          {totalGanho > desbloqueadas && ` · ${totalGanho} no total da temporada`}. As esmaecidas
          ainda não foram conquistadas — passe o mouse pra ver como se consegue.
        </p>

        {remeteAo && (
          <p class="text-[11px] text-slate-500 mt-1.5">
            Estas medalhas são do jogador, não do personagem: são as mesmas da ficha do{' '}
            <a href={`/core/membros/${remeteAo.id}/`} class="text-[#f0a500] hover:underline">
              {remeteAo.nome}
            </a>
            . Trocar de cadeira pra compor o raide não é falta.
          </p>
        )}

        {!remeteAo && tambemJoga.length > 0 && (
          <p class="text-[11px] text-slate-500 mt-1.5">
            Inclui o que você fez como {tambemJoga.join(', ')}.
          </p>
        )}
      </div>

      {/* Nada sai da parede — isto ENTRA em cima dela. A diferença entre
          "você não tem estas 45" e "estas três estão ao seu alcance" é a
          mesma lista, lida pra frente. */}
      {aoAlcance.length > 0 && (
        <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-5 mb-4">
          <p class="text-sm font-semibold text-slate-300">Ao seu alcance</p>
          <p class="text-[11px] text-slate-500 mt-0.5 mb-4">
            As mais perto de cair, medidas na sua melhor noite da temporada.
          </p>

          <ul class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {aoAlcance.map((item) => (
              <li class="flex items-start gap-3 min-w-0">
                <div class="shrink-0 opacity-60">
                  <MedalhaDeConquista conquista={item.conquista} vezes={0} />
                </div>

                <div class="min-w-0 flex-1 pt-1">
                  <p class="text-xs font-semibold text-slate-200 leading-snug">
                    {item.conquista.nome}
                  </p>

                  <div class="h-1.5 rounded-full bg-white/5 overflow-hidden my-1.5">
                    <div
                      class="h-full rounded-full bg-[#f0a500]"
                      style={`width: ${item.progresso}%`}
                    />
                  </div>

                  <p class="text-[11px] text-slate-500 leading-snug">{item.falta}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="space-y-4">
        {prateleiras.map((prateleira) => (
          <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-5">
            <div class="mb-4">
              <p class="text-sm font-semibold text-slate-300">{prateleira.titulo}</p>
              <p class="text-[11px] text-slate-500 mt-0.5">{prateleira.nota}</p>
            </div>

            <div class="flex flex-wrap gap-5">
              {prateleira.itens.map((item) => (
                <div class="flex flex-col items-center gap-2 w-24">
                  <MedalhaDeConquista
                    conquista={item.conquista}
                    vezes={item.ganha?.vezes ?? 0}
                    detalhe={item.ganha?.detalhe ?? null}
                    personagens={nomesDosPersonagens(item.ganha?.personagens)}
                  />

                  <span
                    class={`text-[11px] text-center leading-tight ${
                      (item.ganha?.vezes ?? 0) > 0 ? 'text-slate-300' : 'text-slate-600'
                    }`}
                  >
                    {item.conquista.nome}
                  </span>
                </div>
              ))}
            </div>

            {prateleira.rodape && (
              <p class="text-[10px] text-slate-600 mt-4 text-right">* {prateleira.rodape}</p>
            )}
          </div>
        ))}
      </div>
    </section>
  ) : (
    <section class="mb-10">
      <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-5">
        <p class="text-sm font-semibold text-slate-300">Medalhas</p>
        <p class="text-sm text-slate-400 mt-1">
          As medalhas começam quando o trial vira membro. Até lá o que conta é presença,
          comportamento e vontade de aprender — e ninguém é medido por número.
        </p>
      </div>
    </section>
  )
}
