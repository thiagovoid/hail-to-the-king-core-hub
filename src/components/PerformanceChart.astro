---
import { formatCompact } from '@/utils/format';
import { formatDate } from '@/utils/format';
import { ROTULO_DO_NIVEL, type DegrauDoGrafico } from '@/engine/scores/prontidao';

/**
 * A cor de cada degrau, igual à do cartão de prontidão — a mesma ideia tem
 * que ter a mesma cor nas duas telas, senão viram dois sistemas.
 */
const COR_DO_NIVEL = {
  normal: { linha: 'text-emerald-500', texto: 'fill-emerald-400' },
  heroico: { linha: 'text-sky-500', texto: 'fill-sky-400' },
  mitico: { linha: 'text-purple-500', texto: 'fill-purple-400' },
} as const;

interface DataPoint {
  date: string;
  value: number;
  /**
   * Linhas que explicam o ponto naquela noite, uma por mecânica.
   *
   * Existe porque o detalhe do card mostra só a última noite: sem isto, o
   * que explicou cada ponto se perde a cada log novo que chega.
   */
  detail?: string[];
}

function formatShortDate(iso: string): string {
  return formatDate(iso).slice(0, 5);
}

interface Series {
  id: string;
  label: string;
  data: DataPoint[];
  target?: number;
  direction?: 'higher' | 'lower';
  /**
   * Valor que o selo de meta compara. Vem de fora porque cada métrica tem
   * a sua régua: o objetivo de dps olha a média da temporada, enquanto o
   * Score Geral olha a última noite. Sem isto, gráfico e card discordavam.
   */
  current?: number | null;
  /**
   * As linhas de NÍVEL DE CONTEÚDO: o piso que a pessoa já segura e o degrau
   * seguinte. Quando existem, elas substituem a linha de META no desenho —
   * duas réguas sobrepostas no mesmo gráfico não se leem. A meta individual
   * continua no selo acima, com o número exato.
   */
  degraus?: DegrauDoGrafico[];
}

interface Props {
  series: Series[];
}

const { series } = Astro.props;

const width = 800;
const height = 320;

const paddingLeft = 55;
const paddingRight = 30;
const paddingTop = 25;
const paddingBottom = 35;

const formatValue = formatCompact;

/**
 * Passo "redondo" mais próximo acima de um valor bruto.
 *
 * Sem isto o eixo saía com 1.7999999999999998 e 0.23999999999999977 — ruído
 * de ponto flutuante de dividir um intervalo qualquer em 4. Escolhendo o passo
 * antes do máximo, todos os cortes caem em múltiplos limpos.
 */
function passoRedondo(bruto: number): number {
  if (bruto <= 0) return 1;
  const escalas = [0.25, 0.5, 1, 2, 5, 10, 25, 50, 100, 250, 500, 1000];
  const magnitude = Math.pow(10, Math.floor(Math.log10(bruto)));
  const candidatos = escalas.map((e) => e * Math.max(1, magnitude / 10));
  return candidatos.find((c) => c >= bruto) ?? Math.ceil(bruto);
}

function getScale(item: Series) {
  const values = item.data.map((point) => point.value);

  if (item.target !== undefined) {
    values.push(item.target);
  }

  // Um degrau fora da escala vira uma linha colada no topo — ou some. A
  // régua do próximo nível só informa se ela couber na tela.
  for (const degrau of item.degraus ?? []) {
    values.push(degrau.valor);
  }

  const maiorValor = Math.max(...values, 0);

  // Começa no zero: erro mecânico, dps e parse são grandezas que partem de
  // zero, e cortar a base exagera visualmente diferenças pequenas.
  const min = 0;
  const passo = passoRedondo(maiorValor / 4);
  const max = passo * 4;

  return {
    min,
    max: max || 1,
    range: max - min || 1,
  };
}

function getX(index: number, length: number): number {
  const chartWidth =
    width - paddingLeft - paddingRight;

  if (length <= 1) {
    return paddingLeft + chartWidth / 2;
  }

  return (
    paddingLeft +
    (index / (length - 1)) * chartWidth
  );
}

function getY(
  value: number,
  scale: ReturnType<typeof getScale>
): number {
  const chartHeight =
    height - paddingTop - paddingBottom;

  return (
    paddingTop +
    (1 - (value - scale.min) / scale.range) *
      chartHeight
  );
}

function createPoints(
  data: DataPoint[],
  scale: ReturnType<typeof getScale>
): string {
  return data
    .map((point, index) => {
      return `${getX(index, data.length)},${getY(point.value, scale)}`;
    })
    .join(' ');
}

/**
 * Mesma regra do card "Objetivos de performance": compara a MÉDIA da
 * temporada com a meta, não o último ponto.
 *
 * Olhar só a última noite fazia o gráfico anunciar "Meta atingida"
 * enquanto o card logo acima mostrava 92% — uma noite boa não significa
 * a meta batida na temporada.
 *
 * O arredondamento acompanha buildPlayerSeasonAverage de propósito, pra
 * os dois nunca divergirem num caso limítrofe.
 */
function isGoalReached(item: Series): boolean {
  if (item.target === undefined || item.data.length === 0) {
    return false;
  }

  // Quem manda é o valor que a métrica usa de verdade: o objetivo de dps
  // compara a média da temporada, o Score Geral compara a última noite.
  // Só cai na média quando quem chama não informou nada.
  const referencia =
    item.current ??
    Math.round(item.data.reduce((sum, point) => sum + point.value, 0) / item.data.length);

  if (item.direction === 'lower') {
    return referencia <= item.target;
  }

  return referencia >= item.target;
}

/**
 * Meses presentes no dado. Mesmo filtro da home, mesma regra: recorta o que
 * é DESENHADO e nada do que é calculado.
 */
const MES_CURTO = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];

const mesesDisponiveis = [
  ...new Set(series.flatMap((item) => item.data.map((point) => point.date.slice(0, 7)))),
].sort();

const rotuloDoMes = (mes: string) => {
  const [ano, numero] = mes.split('-');
  return `${MES_CURTO[Number(numero) - 1]}/${ano.slice(2)}`;
};

const charts = series.map((item) => {
  const scale = getScale(item);

  return {
    item,
    scale,
    goalReached: isGoalReached(item),
  };
});
---

<section
  class="bg-slate-900/60 border border-slate-800 rounded-xl p-6 mt-8 mb-10"
>
  <div
    class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-6"
  >
    <div>
      <h2 class="text-xl font-bold text-white">
        Evolução de Performance
      </h2>

      <p class="text-sm text-slate-500 mt-1">
        Acompanhe sua evolução run a run.
      </p>
    </div>

    <div
      id="performance-chart-tabs"
      class="flex flex-wrap gap-2"
    >
      {
        charts.map((chart, index) => {
          const item = chart.item;

          return (
            <button
              type="button"
              data-series={item.id}
              class={
                index === 0
                  ? 'px-3 py-1.5 rounded-lg text-sm bg-slate-700 text-white'
                  : 'px-3 py-1.5 rounded-lg text-sm text-slate-400 hover:text-white hover:bg-slate-800'
              }
            >
              {item.label}
            </button>
          );
        })
      }
    </div>
  </div>

  <!-- Mesmo controle da home. Recorta o desenho, não o cálculo: a escala
       vertical, a linha de META e o selo de meta atingida continuam olhando
       o período completo. -->
  <div
    id="performance-chart-meses"
    class="flex flex-wrap items-center gap-1.5 mb-5 pb-4 border-b border-slate-800"
  >
    <span class="text-[11px] uppercase tracking-wide text-slate-600 mr-1">Período</span>

    <button
      type="button"
      data-mes="todos"
      class="px-2.5 py-1 rounded-md text-xs transition-colors bg-slate-700 text-white"
    >
      Tudo
    </button>

    {
      mesesDisponiveis.map((mes) => (
        <button
          type="button"
          data-mes={mes}
          class="px-2.5 py-1 rounded-md text-xs transition-colors text-slate-400 hover:text-white hover:bg-slate-800"
        >
          {rotuloDoMes(mes)}
        </button>
      ))
    }
  </div>

  {
    charts.map((chart, index) => {
      const item = chart.item;
      const scale = chart.scale;

      const current =
        item.data.length > 0
          ? item.data[item.data.length - 1].value
          : undefined;

      return (
        <div
          data-chart={item.id}
          class={index === 0 ? '' : 'hidden'}
        >
          {
            item.target !== undefined && current !== undefined && (
              <div class="flex justify-end mb-4">
                <div class="text-right">
                  <div class="text-xs text-slate-500 uppercase">
                    Meta
                  </div>

                  <div class="text-lg font-bold text-amber-400">
                    {formatValue(item.target)}
                  </div>

                  <div
                    class={
                      chart.goalReached
                        ? 'text-xs mt-1 text-emerald-400'
                        : 'text-xs mt-1 text-slate-500'
                    }
                  >
                    {
                      chart.goalReached
                        ? 'Meta atingida'
                        : 'Meta ainda não atingida'
                    }
                  </div>
                </div>
              </div>
            )
          }

          <div class="overflow-x-auto">
            <svg
              viewBox={`0 0 ${width} ${height}`}
              class="w-full min-w-[600px]"
              role="img"
              aria-label={`Evolução de ${item.label}`}
            >
              {
                Array.from({ length: 5 }).map((_, gridIndex) => {
                  const value =
                    scale.max -
                    (gridIndex / 4) * scale.range;

                  const yPosition =
                    paddingTop +
                    (gridIndex / 4) *
                      (height -
                        paddingTop -
                        paddingBottom);

                  return (
                    <g>
                      <line
                        x1={paddingLeft}
                        y1={yPosition}
                        x2={width - paddingRight}
                        y2={yPosition}
                        stroke="currentColor"
                        class="text-slate-800"
                        stroke-width="1"
                      />

                      <text
                        x={paddingLeft - 8}
                        y={yPosition + 4}
                        text-anchor="end"
                        class="fill-slate-500 text-[11px]"
                      >
                        {formatValue(value)}
                      </text>
                    </g>
                  );
                })
              }

              {
                item.target !== undefined && (item.degraus ?? []).length === 0 && (
                  <g>
                    <line
                      x1={paddingLeft}
                      y1={getY(item.target, scale)}
                      x2={width - paddingRight}
                      y2={getY(item.target, scale)}
                      stroke="currentColor"
                      class="text-amber-500"
                      stroke-width="2"
                      stroke-dasharray="6 6"
                    />

                    {/* À esquerda e ABAIXO da linha. Na direita ela batia em
                        cima do valor do último ponto justamente quando a
                        pessoa chegava perto da meta — o momento em que os
                        dois números mais importam. */}
                    <text
                      x={paddingLeft + 4}
                      y={getY(item.target, scale) + 14}
                      text-anchor="start"
                      class="fill-amber-400 text-[11px]"
                    >
                      META
                    </text>
                  </g>
                )
              }

              {
                (item.degraus ?? []).map((degrau) => {
                  const cor = COR_DO_NIVEL[degrau.nivel];
                  const y = getY(degrau.valor, scale);

                  return (
                    <g>
                      {/* O piso é contínuo e fino: é chão, não alvo. O degrau
                          seguinte é tracejado e mais grosso — é pra onde se vai. */}
                      <line
                        x1={paddingLeft}
                        y1={y}
                        x2={width - paddingRight}
                        y2={y}
                        stroke="currentColor"
                        class={cor.linha}
                        stroke-width={degrau.atual ? '1.5' : '2'}
                        stroke-dasharray={degrau.atual ? '2 5' : '6 6'}
                        opacity={degrau.atual ? '0.55' : '1'}
                      />

                      {/* O piso rotula à esquerda e o próximo à direita: quando
                          os dois números ficam perto, os rótulos não se cobrem.
                          Os dois ficam ABAIXO da própria linha, porque o valor
                          de cada ponto é desenhado acima do ponto — em cima
                          eles se sobrepunham justamente quando a pessoa
                          encostava no degrau. */}
                      <text
                        x={degrau.atual ? paddingLeft + 4 : width - paddingRight}
                        y={y + 14}
                        text-anchor={degrau.atual ? 'start' : 'end'}
                        class={`${cor.texto} text-[11px]`}
                        opacity={degrau.atual ? '0.7' : '1'}
                      >
                        {degrau.atual
                          ? `${ROTULO_DO_NIVEL[degrau.nivel]} (seu nível)`
                          : `PRA ${ROTULO_DO_NIVEL[degrau.nivel].toUpperCase()}`}
                      </text>
                    </g>
                  );
                })
              }

              <polyline
                data-linha
                points={createPoints(item.data, scale)}
                fill="none"
                stroke="currentColor"
                class="text-cyan-400"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              />

              {
                item.data.map((point, pointIndex) => {
                  const x = getX(
                    pointIndex,
                    item.data.length
                  );

                  const y = getY(
                    point.value,
                    scale
                  );

                  const linhas = point.detail ?? [];
                  const larguraCaixa = 250;
                  const alturaLinha = 16;
                  const alturaCaixa = 26 + linhas.length * alturaLinha;

                  // Perto da borda direita a caixa abre pra esquerda, senão
                  // sai da área visível do gráfico.
                  const abreParaEsquerda = x > width - larguraCaixa - paddingRight;
                  const caixaX = abreParaEsquerda ? x - larguraCaixa - 10 : x + 10;

                  // E perto do topo ela desce, pelo mesmo motivo.
                  const caixaY = Math.max(paddingTop, Math.min(y - alturaCaixa / 2, height - paddingBottom - alturaCaixa));

                  return (
                    /* data-x guarda a posição original: o filtro de período
                       desloca o grupo inteiro por diferença, em vez de
                       redesenhar. Assim a escala vertical, a linha de meta e
                       o selo ficam exatamente como estavam. */
                    <g class="group" data-ponto data-date={point.date} data-x={x} data-y={y}>
                      {/* Alvo generoso: acertar um círculo de 6px com o mouse
                          é frustrante, e ele fica invisível. */}
                      <circle cx={x} cy={y} r="16" class="fill-transparent" />

                      <circle
                        cx={x}
                        cy={y}
                        r="6"
                        class="fill-cyan-400 stroke-slate-950 transition-colors group-hover:fill-amber-400"
                        stroke-width="3"
                      />

                      <text
                        x={x}
                        y={y - 14}
                        text-anchor="middle"
                        class="fill-slate-300 text-[11px]"
                      >
                        {formatValue(point.value)}
                      </text>

                      <text
                        x={x}
                        y={height - 8}
                        text-anchor="middle"
                        class="fill-slate-500 text-[11px]"
                      >
                        {formatShortDate(point.date)}
                      </text>

                      {linhas.length > 0 && (
                        <g class="pointer-events-none opacity-0 transition-opacity group-hover:opacity-100">
                          <rect
                            x={caixaX}
                            y={caixaY}
                            width={larguraCaixa}
                            height={alturaCaixa}
                            rx="8"
                            class="fill-[#141b2d] stroke-white/10"
                            stroke-width="1"
                          />

                          <text
                            x={caixaX + 12}
                            y={caixaY + 18}
                            class="fill-slate-300 text-[11px] font-semibold"
                          >
                            {formatShortDate(point.date)}
                          </text>

                          {linhas.map((linha, linhaIndex) => (
                            <text
                              x={caixaX + 12}
                              y={caixaY + 18 + (linhaIndex + 1) * alturaLinha}
                              class="fill-slate-400 text-[11px]"
                            >
                              {linha}
                            </text>
                          ))}
                        </g>
                      )}
                    </g>
                  );
                })
              }
            </svg>
          </div>
        </div>
      );
    })
  }
</section>

<script>
  const container = document.querySelector(
    '#performance-chart-tabs'
  );

  if (container) {
    const buttons =
      container.querySelectorAll(
        '[data-series]'
      );

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const seriesId =
          button.getAttribute('data-series');

        if (!seriesId) {
          return;
        }

        document
          .querySelectorAll('[data-chart]')
          .forEach((chart) => {
            chart.classList.toggle(
              'hidden',
              chart.getAttribute('data-chart') !==
                seriesId
            );
          });

        buttons.forEach((item) => {
          const active = item === button;

          item.classList.toggle(
            'bg-slate-700',
            active
          );

          item.classList.toggle(
            'text-white',
            active
          );

          item.classList.toggle(
            'text-slate-400',
            !active
          );
        });
      });
    });
  }

  // ----- Filtro de período -----
  //
  // Reposiciona o que já está desenhado, em vez de redesenhar: cada ponto é
  // um <g> que guarda a própria posição original em data-x, e o filtro
  // aplica um deslocamento horizontal. A escala vertical, a linha de META e
  // o selo de meta atingida não são tocados — continuam do período completo,
  // que é o comportamento que o core pediu pra manter.
  const larguraDoGrafico = 800 - 55 - 30;
  const margemEsquerda = 55;

  function xDoIndice(indice: number, total: number): number {
    if (total <= 1) return margemEsquerda + larguraDoGrafico / 2;
    return margemEsquerda + (indice / (total - 1)) * larguraDoGrafico;
  }

  function aplicarPeriodo(mes: string) {
    document.querySelectorAll('[data-chart]').forEach((grafico) => {
      const pontos = [...grafico.querySelectorAll('[data-ponto]')] as SVGGElement[];
      if (pontos.length === 0) return;

      const visiveis = pontos.filter(
        (ponto) => mes === 'todos' || (ponto.getAttribute('data-date') ?? '').slice(0, 7) === mes
      );

      const coordenadas: string[] = [];

      pontos.forEach((ponto) => {
        const dentro = visiveis.includes(ponto);
        ponto.style.display = dentro ? '' : 'none';
        if (!dentro) return;

        const xOriginal = Number(ponto.getAttribute('data-x'));
        const xNovo = xDoIndice(visiveis.indexOf(ponto), visiveis.length);
        ponto.setAttribute('transform', `translate(${xNovo - xOriginal}, 0)`);
        coordenadas.push(`${xNovo},${ponto.getAttribute('data-y')}`);
      });

      const linha = grafico.querySelector('[data-linha]');
      if (linha) {
        // Um ponto só não faz linha; deixar a antiga seria desenhar um
        // traço que não corresponde a nada.
        linha.setAttribute('points', coordenadas.length > 1 ? coordenadas.join(' ') : '');
      }
    });
  }

  const barraDeMeses = document.querySelector('#performance-chart-meses');

  if (barraDeMeses) {
    const botoes = barraDeMeses.querySelectorAll('[data-mes]');

    botoes.forEach((botao) => {
      botao.addEventListener('click', () => {
        aplicarPeriodo(botao.getAttribute('data-mes') ?? 'todos');

        botoes.forEach((item) => {
          const ativo = item === botao;
          item.classList.toggle('bg-slate-700', ativo);
          item.classList.toggle('text-white', ativo);
          item.classList.toggle('text-slate-400', !ativo);
        });
      });
    });
  }
</script>