---
/**
 * PerformanceSummary.astro — números do jogador na temporada.
 *
 * Mostra a média das runs, e não a última: é a mesma base que alimenta as
 * metas e o Score Geral logo abaixo, então todo número da página fecha com
 * os outros. A evolução run a run fica no gráfico, que continua por run.
 */
import { formatPerformanceValue } from '@/engine/metrics';
import type { PlayerSeasonAverage } from '@/engine/metrics';

interface Props {
  average: PlayerSeasonAverage;
}

const { average } = Astro.props;

// Mortes por run saiu: ela já não pontua no Score Geral, segue no
// histórico run a run, e o espaço vale mais pra "quantos bosses eu derrubei"
// — que é a pergunta que o jogador realmente faz.
const cards = [
  average.dps !== undefined ? { label: 'DPS médio', value: formatPerformanceValue(average.dps) } : null,
  average.hps !== undefined ? { label: 'HPS médio', value: formatPerformanceValue(average.hps) } : null,
  { label: 'Bosses mortos', value: String(average.bossesMortos) },
  average.parse !== undefined ? { label: 'Parse médio', value: String(average.parse) } : null,
  average.mechanics !== undefined
    ? { label: 'Erros mecânicos', value: String(average.mechanics.errors) }
    : null,
  average.itemLevel !== undefined ? { label: 'Item Level', value: String(average.itemLevel) } : null,
].filter((card) => card !== null);
---

<section class="mb-10">
  <div class="mb-4">
    <h2 class="text-xl font-bold text-white">
      Performance na temporada
    </h2>

    <p class="text-sm text-slate-400 mt-1">
      Média de {average.runs} run(s) registrada(s). Item Level é o último
      registrado, não uma média. Bosses mortos é o total de kills com
      você presente na try, contando repetição: três clears do mesmo boss
      contam três.
    </p>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
    {
      cards.map((card) => (
        <article class="bg-slate-900/60 border border-slate-800 rounded-xl p-4">
          <p class="text-xs uppercase tracking-wide text-slate-500">
            {card!.label}
          </p>

          <strong class="block text-2xl font-bold text-white mt-1">
            {card!.value}
          </strong>
        </article>
      ))
    }
  </div>
</section>
