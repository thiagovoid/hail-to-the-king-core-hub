---
/**
 * NavBar.astro — Barra de navegação principal do Core Hub
 * Estilo Raider.IO: sticky, fundo escuro com blur, logo dourado, indicador de ativo.
 *
 * Agrupada em "Guild" e "Core Nemesis" — mesma separação institucional vs.
 * performance que o resto do site já reflete — em vez de 10 itens soltos
 * num nav horizontal só, que não cabia mais depois de História/Chronicle/
 * Hall da Fama entrarem.
 */

const currentPath = Astro.url.pathname;

interface NavLink {
  label: string;
  href: string;
  icon: string;
}

interface NavGroup {
  label: string;
  icon: string;
  items: NavLink[];
}

const flatItemsStart: NavLink[] = [
  { label: 'Início', href: '/', icon: '🏠' },
];

const groups: NavGroup[] = [
  {
    label: 'Guild',
    icon: '🏰',
    items: [
      { label: 'História', href: '/historia/', icon: '📜' },
      { label: 'Chronicle', href: '/chronicle/', icon: '📖' },
      { label: 'Hall da Fama', href: '/hall-da-fama/', icon: '🏆' },
    ],
  },
  {
    label: 'Core Nemesis',
    icon: '⚔',
    items: [
      { label: 'Dashboard', href: '/core/', icon: '📊' },
      { label: 'Progressão', href: '/core/progressao/', icon: '🗡' },
      { label: 'Membros', href: '/core/membros/', icon: '👥' },
      { label: 'Mythic+', href: '/core/mythic/', icon: '🗝' },
    ],
  },
];

const flatItemsEnd: NavLink[] = [
  { label: 'Ferramentas', href: '/ferramentas/', icon: '🛠' },
  { label: 'Regras', href: '/regras/', icon: '📋' },
];

// Achata tudo pro menu mobile — espaço vertical é barato, não precisa de
// acordeão, só uns rótulos de seção pra manter a mesma organização.
const mobileSections: Array<{ label: string | null; items: NavLink[] }> = [
  { label: null, items: flatItemsStart },
  { label: groups[0].label, items: groups[0].items },
  { label: groups[1].label, items: groups[1].items },
  { label: null, items: flatItemsEnd },
];

function isActive(href: string): boolean {
  return currentPath === href;
}

function isGroupActive(group: NavGroup): boolean {
  return group.items.some((item) => isActive(item.href));
}
---

<nav role="navigation" aria-label="Menu principal">
  <div class="sticky top-0 z-50 bg-[#0a0d14]/95 backdrop-blur-md border-b border-white/5">

    <!-- Top accent line -->
    <div class="h-[2px] bg-gradient-to-r from-transparent via-[#f0a500] to-transparent opacity-60" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-14">

        <!-- Branding — Fix label-content-name-mismatch: remove aria-label, use aria-label only when no visible text -->
        <a
          href="/"
          class="flex items-center gap-2.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f0a500] rounded"
        >
          <span class="text-xl" aria-hidden="true">⚔</span>
          <span class="font-display text-[#f0a500] font-bold text-base tracking-wide group-hover:text-[#fbbf24] transition-colors">
            Hail to the King
          </span>
          <span class="sr-only">— página inicial</span>
        </a>

        <!-- Desktop links -->
        <div class="hidden lg:flex items-center gap-1">
          {flatItemsStart.map((item) => {
            const active = isActive(item.href);
            return (
              <a
                href={item.href}
                class={[
                  'relative px-3 py-2 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f0a500] rounded',
                  active ? 'text-[#f0a500]' : 'text-slate-400 hover:text-slate-100',
                ].join(' ')}
                aria-current={active ? 'page' : undefined}
              >
                {item.label}
                {active && <span class="absolute inset-x-2 -bottom-[1px] h-[2px] bg-[#f0a500] rounded-full" aria-hidden="true" />}
              </a>
            );
          })}

          {groups.map((group) => {
            const active = isGroupActive(group);
            const slug = group.label.toLowerCase().replace(/\s+/g, '-');
            return (
              <div class="relative">
                <button
                  type="button"
                  data-dropdown-trigger={slug}
                  aria-haspopup="true"
                  aria-expanded="false"
                  class={[
                    'relative flex items-center gap-1 px-3 py-2 text-sm font-medium transition-colors rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f0a500]',
                    active ? 'text-[#f0a500]' : 'text-slate-400 hover:text-slate-100',
                  ].join(' ')}
                >
                  {group.label}
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                  {active && <span class="absolute inset-x-2 -bottom-[1px] h-[2px] bg-[#f0a500] rounded-full" aria-hidden="true" />}
                </button>

                <div
                  data-dropdown-panel={slug}
                  role="menu"
                  aria-label={group.label}
                  class="hidden absolute left-0 top-full mt-1 min-w-[180px] py-1.5 rounded-lg border border-white/10 bg-[#141b2d] shadow-xl"
                >
                  {group.items.map((item) => {
                    const itemActive = isActive(item.href);
                    return (
                      <a
                        href={item.href}
                        role="menuitem"
                        class={[
                          'flex items-center gap-2 px-3.5 py-2 text-sm transition-colors',
                          itemActive ? 'text-[#f0a500] bg-[#f0a500]/10' : 'text-slate-300 hover:text-slate-100 hover:bg-white/5',
                        ].join(' ')}
                        aria-current={itemActive ? 'page' : undefined}
                      >
                        <span aria-hidden="true">{item.icon}</span>
                        {item.label}
                      </a>
                    );
                  })}
                </div>
              </div>
            );
          })}

          {flatItemsEnd.map((item) => {
            const active = isActive(item.href);
            return (
              <a
                href={item.href}
                class={[
                  'relative px-3 py-2 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f0a500] rounded',
                  active ? 'text-[#f0a500]' : 'text-slate-400 hover:text-slate-100',
                ].join(' ')}
                aria-current={active ? 'page' : undefined}
              >
                {item.label}
                {active && <span class="absolute inset-x-2 -bottom-[1px] h-[2px] bg-[#f0a500] rounded-full" aria-hidden="true" />}
              </a>
            );
          })}
        </div>

        <!-- Mobile hamburger button -->
        <button
          id="hamburger-btn"
          type="button"
          class="lg:hidden inline-flex items-center justify-center p-2 rounded text-slate-400 hover:text-[#f0a500] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f0a500]"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Abrir menu"
        >
          <svg id="hamburger-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden lg:hidden border-t border-white/5 bg-[#0a0d14] max-h-[calc(100vh-3.5rem)] overflow-y-auto">
      <div class="px-4 py-3 space-y-3">
        {mobileSections.map((section) => (
          <div>
            {section.label && (
              <p class="px-3 pb-1 text-[10px] font-bold uppercase tracking-widest text-slate-600">
                {section.label}
              </p>
            )}
            <div class="space-y-0.5">
              {section.items.map((item) => {
                const active = isActive(item.href);
                return (
                  <a
                    href={item.href}
                    class={[
                      'flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f0a500]',
                      active ? 'bg-[#f0a500]/10 text-[#f0a500]' : 'text-slate-400 hover:text-slate-100 hover:bg-white/5',
                    ].join(' ')}
                    aria-current={active ? 'page' : undefined}
                  >
                    <span aria-hidden="true">{item.icon}</span>
                    {item.label}
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('hamburger-btn') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu') as HTMLElement | null;
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden', isOpen);
      btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      btn.setAttribute('aria-label', isOpen ? 'Abrir menu' : 'Fechar menu');
      hamburgerIcon?.classList.toggle('hidden', !isOpen);
      closeIcon?.classList.toggle('hidden', isOpen);
    });
  }

  // Dropdowns de desktop (Guild / Core Nemesis): clique pra abrir/fechar,
  // clique fora ou Escape fecha, abrir um fecha os outros.
  const triggers = document.querySelectorAll<HTMLButtonElement>('[data-dropdown-trigger]');

  function closeAllDropdowns(except?: HTMLButtonElement) {
    triggers.forEach((trigger) => {
      if (trigger === except) return;
      const key = trigger.dataset.dropdownTrigger;
      const panel = document.querySelector<HTMLElement>(`[data-dropdown-panel="${key}"]`);
      panel?.classList.add('hidden');
      trigger.setAttribute('aria-expanded', 'false');
    });
  }

  triggers.forEach((trigger) => {
    const key = trigger.dataset.dropdownTrigger;
    const panel = document.querySelector<HTMLElement>(`[data-dropdown-panel="${key}"]`);
    if (!panel) return;

    trigger.addEventListener('click', (event) => {
      event.stopPropagation();
      const isOpen = !panel.classList.contains('hidden');
      closeAllDropdowns(trigger);
      panel.classList.toggle('hidden', isOpen);
      trigger.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
    });
  });

  document.addEventListener('click', () => closeAllDropdowns());
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeAllDropdowns();
  });
</script>
