---
/**
 * Uma medalha de conquista.
 *
 * A arte é UMA só por conquista: a quantidade entra como contador sobreposto
 * no canto, do jeito que aplicativo faz com notificação não lida. Desenhar
 * uma variante por número seria seis vezes mais arte pra dizer a mesma coisa.
 *
 * Medalha é redonda e o emblema de rank é escudo, de propósito: são coisas
 * diferentes na mesma página e precisam se distinguir de longe.
 */
import type { DefinicaoDeConquista } from '@/engine/guild/conquistas';

interface Props {
  conquista: DefinicaoDeConquista;
  /** Quantas vezes o jogador levou. Zero mostra a medalha travada. */
  vezes: number;
  /** Texto da vez mais recente, quando a conquista tem nome próprio. */
  detalhe?: string | null;
  /**
   * Em quais personagens ela foi conquistada.
   *
   * Vazio pra quem só tem um: "MVP — Kroline" na ficha da Kroline não
   * acrescenta nada. Quem tem alt, sim.
   */
  personagens?: string[];
  size?: number;
}

const { conquista, vezes, detalhe = null, personagens = [], size = 64 } = Astro.props;

const conquistada = vezes > 0;
const id = `medalha-${conquista.id}`;

/** Cada conquista tem seu metal; a travada é chumbo. */
const METAIS: Record<string, { claro: string; escuro: string; borda: string }> = {
  mvp: { claro: '#fde047', escuro: '#a16207', borda: '#fef08a' },
  'maior-dano': { claro: '#f87171', escuro: '#7f1d1d', borda: '#fca5a5' },
  'maior-cura': { claro: '#4ade80', escuro: '#14532d', borda: '#86efac' },
  'maior-defesa': { claro: '#60a5fa', escuro: '#1e3a8a', borda: '#93c5fd' },
  'nota-maxima': { claro: '#fb923c', escuro: '#7c2d12', borda: '#fdba74' },
  'noite-limpa': { claro: '#e2e8f0', escuro: '#475569', borda: '#f8fafc' },
  'mecanicas-impecaveis': { claro: '#c084fc', escuro: '#4c1d95', borda: '#d8b4fe' },
  relojoeiro: { claro: '#22d3ee', escuro: '#164e63', borda: '#67e8f9' },
  escoteiro: { claro: '#a3e635', escuro: '#365314', borda: '#bef264' },
  'triplice-coroa': { claro: '#fef08a', escuro: '#854d0e', borda: '#fef9c3' },
  lenda: { claro: '#fdba74', escuro: '#9a3412', borda: '#fed7aa' },
  superacao: { claro: '#5eead4', escuro: '#115e59', borda: '#99f6e4' },
  constante: { claro: '#a5b4fc', escuro: '#312e81', borda: '#c7d2fe' },
  'zero-a-zero': { claro: '#cffafe', escuro: '#155e75', borda: '#ecfeff' },
  polivalente: { claro: '#f0abfc', escuro: '#701a75', borda: '#f5d0fe' },
  muralha: { claro: '#7dd3fc', escuro: '#075985', borda: '#bae6fd' },
  'sem-sobra': { claro: '#6ee7b7', escuro: '#065f46', borda: '#a7f3d0' },
  fundador: { claro: '#f472b6', escuro: '#831843', borda: '#f9a8d4' },
  inabalavel: { claro: '#d4a373', escuro: '#5b3a1a', borda: '#e7c9a9' },
  invicto: { claro: '#fb7185', escuro: '#7f1d1d', borda: '#fda4af' },
  'paciencia-de-jo': { claro: '#e9d5a1', escuro: '#5c4a1f', borda: '#f5e7c4' },
  coringa: { claro: '#c4b5fd', escuro: '#4c1d95', borda: '#ddd6fe' },
  'dois-oficios': { claro: '#99f6e4', escuro: '#134e4a', borda: '#ccfbf1' },
  severino: { claro: '#67e8f9', escuro: '#0e7490', borda: '#a5f3fc' },
  // As de zoeira ficam num tom mais terroso, pra ler como "outra
  // prateleira" mesmo quando estão fora da seção delas.
  'pocao-que-pocao': { claro: '#fbbf24', escuro: '#78350f', borda: '#fcd34d' },
  descalco: { claro: '#d6d3d1', escuro: '#44403c', borda: '#e7e5e4' },
  colecionador: { claro: '#fb7185', escuro: '#881337', borda: '#fda4af' },
  'chao-e-lava': { claro: '#a8a29e', escuro: '#292524', borda: '#d6d3d1' },
  dieta: { claro: '#fda4af', escuro: '#7f1d3d', borda: '#fecdd3' },
  'museu-de-encantos': { claro: '#c4b5a0', escuro: '#3f3626', borda: '#ddd3c0' },
  'pagando-promessa': { claro: '#fed7aa', escuro: '#7c4a12', borda: '#ffedd5' },
  'tanque-nao-oficial': { claro: '#94a3b8', escuro: '#27303f', borda: '#cbd5e1' },
  'guardando-pro-inverno': { claro: '#bae6fd', escuro: '#0c4a6e', borda: '#e0f2fe' },
  'cooldown-de-estimacao': { claro: '#d8b4a0', escuro: '#44302a', borda: '#ecd9cd' },
  pacifista: { claro: '#e0e7ff', escuro: '#3730a3', borda: '#eef2ff' },
  'fominha-de-trash': { claro: '#fdba74', escuro: '#7c2d12', borda: '#fed7aa' },
  'chegou-atrasado': { claro: '#a8a29e', escuro: '#3f3f46', borda: '#d6d3d1' },
  'lagou-aqui': { claro: '#fde68a', escuro: '#713f12', borda: '#fef3c7' },
  turista: { claro: '#93c5fd', escuro: '#1e3a5f', borda: '#bfdbfe' },
  'meter-do-alem': { claro: '#cbd5e1', escuro: '#1e293b', borda: '#e2e8f0' },
  'vai-de-novo': { claro: '#f9a8d4', escuro: '#701a45', borda: '#fbcfe8' },
  // A família de peça vazia divide o mesmo bronze empoeirado: são dez
  // variações da mesma piada, e cor própria pra cada uma só confundiria.
  // O símbolo é que as distingue.
  'cabeca-oca': { claro: '#cbbba0', escuro: '#453a29', borda: '#e3d8c5' },
  'ombro-frio': { claro: '#cbbba0', escuro: '#453a29', borda: '#e3d8c5' },
  'peito-aberto': { claro: '#cbbba0', escuro: '#453a29', borda: '#e3d8c5' },
  'cintura-solta': { claro: '#cbbba0', escuro: '#453a29', borda: '#e3d8c5' },
  'perna-de-fora': { claro: '#cbbba0', escuro: '#453a29', borda: '#e3d8c5' },
  'punho-livre': { claro: '#cbbba0', escuro: '#453a29', borda: '#e3d8c5' },
  'anel-sem-graca': { claro: '#cbbba0', escuro: '#453a29', borda: '#e3d8c5' },
  'lamina-cega': { claro: '#cbbba0', escuro: '#453a29', borda: '#e3d8c5' },
  // As de gema puxam pro verde-pedra, pra separar de encanto na estante.
  'gargantilha-vazia': { claro: '#a7c4b5', escuro: '#254034', borda: '#c9dcd2' },
  'soquete-vago': { claro: '#a7c4b5', escuro: '#254034', borda: '#c9dcd2' },
  // As duas do par são as mais difíceis da família: merecem destaque.
  'meio-armado': { claro: '#fca5a5', escuro: '#6b1d1d', borda: '#fecaca' },
  'so-um-dedo': { claro: '#fca5a5', escuro: '#6b1d1d', borda: '#fecaca' },
};

const metal = conquistada
  ? METAIS[conquista.id] ?? METAIS.mvp
  : { claro: '#475569', escuro: '#1e293b', borda: '#64748b' };

const titulo = conquistada
  ? `${conquista.nome}${vezes > 1 ? ` — ${vezes} vezes` : ''}. ${conquista.como}`
  : `${conquista.nome} (ainda não conquistada). ${conquista.como}`;
---

<div class="relative group shrink-0" style={`width:${size}px;height:${size}px`}>
  <svg
    viewBox="0 0 64 64"
    width={size}
    height={size}
    role="img"
    aria-label={titulo}
    class={conquistada ? '' : 'opacity-45 saturate-0'}
  >
    <defs>
      <linearGradient id={`${id}-metal`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color={metal.claro} />
        <stop offset="100%" stop-color={metal.escuro} />
      </linearGradient>
    </defs>

    <circle cx="32" cy="32" r="28" fill={`url(#${id}-metal)`} stroke={metal.borda} stroke-width="2.5" />
    <circle cx="32" cy="32" r="22" fill="none" stroke={metal.borda} stroke-width="1" stroke-opacity="0.4" />

    <g fill="#0b1020" fill-opacity="0.82">
      {conquista.simbolo === 'coroa' && (
        <>
          <path d="M20 40 L16 22 L25 30 L32 18 L39 30 L48 22 L44 40 Z" />
          <rect x="19" y="42" width="26" height="4" rx="1.5" />
        </>
      )}

      {conquista.simbolo === 'espada' && (
        <>
          <path d="M30 14 H34 L35.5 38 H28.5 Z" />
          <rect x="22" y="37" width="20" height="4" rx="1.5" />
          <rect x="29.5" y="40" width="5" height="10" rx="2" />
        </>
      )}

      {conquista.simbolo === 'calice' && (
        <>
          <path d="M20 16 H44 C44 30 38 36 32 36 C26 36 20 30 20 16 Z" />
          <rect x="29.5" y="35" width="5" height="10" />
          <rect x="22" y="45" width="20" height="4" rx="1.5" />
        </>
      )}

      {conquista.simbolo === 'escudo' && (
        <path d="M32 14 L47 19 V33 C47 42 40 48 32 51 C24 48 17 42 17 33 V19 Z" />
      )}

      {conquista.simbolo === 'folha' && (
        <>
          <path d="M46 14 C28 14 17 25 17 42 C17 46 18 49 20 51 C34 50 47 38 46 14 Z" />
          <path d="M20 51 L44 20" fill="none" stroke="#e2e8f0" stroke-width="2.5" stroke-linecap="round" />
        </>
      )}

      {conquista.simbolo === 'frasco' && (
        <>
          <path d="M27 14 H37 V26 L45 44 A4 4 0 0 1 41 50 H23 A4 4 0 0 1 19 44 L27 26 Z" />
          <rect x="25" y="11" width="14" height="4" rx="1.5" />
        </>
      )}

      {conquista.simbolo === 'bota' && (
        <path d="M22 14 H31 V33 C31 36 33 38 38 39 L46 42 A4 4 0 0 1 48 46 V50 H18 V14 Z" />
      )}

      {conquista.simbolo === 'alvo' && (
        <>
          <circle cx="32" cy="32" r="18" fill="none" stroke="#0b1020" stroke-width="4" />
          <circle cx="32" cy="32" r="10" fill="none" stroke="#0b1020" stroke-width="4" />
          <circle cx="32" cy="32" r="3.5" />
        </>
      )}

      {conquista.simbolo === 'relogio' && (
        <>
          <circle cx="32" cy="33" r="18" fill="none" stroke="#0b1020" stroke-width="4" />
          <path d="M32 22 V33 L40 38" fill="none" stroke="#0b1020" stroke-width="4" stroke-linecap="round" />
          <rect x="28" y="10" width="8" height="4" rx="1.5" />
        </>
      )}

      {conquista.simbolo === 'caveira' && (
        <>
          <path d="M32 14 C22 14 16 21 16 30 C16 36 19 39 22 41 V47 H42 V41 C45 39 48 36 48 30 C48 21 42 14 32 14 Z" />
          <circle cx="26" cy="31" r="4.5" fill="#e2e8f0" />
          <circle cx="38" cy="31" r="4.5" fill="#e2e8f0" />
          <rect x="29.5" y="38" width="5" height="6" rx="2" fill="#e2e8f0" />
        </>
      )}

      {conquista.simbolo === 'estrela' && (
        <path d="M32 13 L37 27 H51 L40 35.5 L44 50 L32 41 L20 50 L24 35.5 L13 27 H27 Z" />
      )}

      {conquista.simbolo === 'pluma' && (
        <>
          <path d="M44 16 C30 18 20 28 19 42 C30 41 41 32 44 16 Z" />
          <rect x="16" y="42" width="22" height="3.5" rx="1.75" transform="rotate(-38 16 42)" />
        </>
      )}

      {conquista.simbolo === 'engrenagem' && (
        <>
          <path d="M32 13 L36 19 H43 L44 26 L50 30 L46 36 L48 43 L41 45 L37 51 L32 48 L27 51 L23 45 L16 43 L18 36 L14 30 L20 26 L21 19 H28 Z" />
          <circle cx="32" cy="32" r="7" fill="#e2e8f0" />
        </>
      )}

      {conquista.simbolo === 'louros' && (
        <>
          <path d="M22 17 C13 25 13 41 23 50 C25 48 25 46 24 45 C17 38 17 26 24 19 Z" />
          <path d="M42 17 C51 25 51 41 41 50 C39 48 39 46 40 45 C47 38 47 26 40 19 Z" />
          <path d="M26 39 L23 27 L29 32 L32 24 L35 32 L41 27 L38 39 Z" />
          <rect x="25" y="40" width="14" height="3.5" rx="1.5" />
        </>
      )}

      {/* Os três degraus de prontidão: a mesma escada, um lance a mais em
          cada uma. O salto é visível de longe, que é o que uma medalha
          precisa fazer — ninguém lê o nome antes de ver o desenho. */}
      {conquista.simbolo === 'degrau-i' && (
        <rect x="24" y="34" width="17" height="14" rx="2" />
      )}

      {conquista.simbolo === 'degrau-ii' && (
        <>
          <rect x="16" y="34" width="15" height="14" rx="2" />
          <rect x="33" y="24" width="15" height="24" rx="2" />
        </>
      )}

      {conquista.simbolo === 'degrau-iii' && (
        <>
          <rect x="11" y="36" width="13" height="12" rx="2" />
          <rect x="25" y="28" width="13" height="20" rx="2" />
          <rect x="39" y="20" width="13" height="28" rx="2" />
          <path d="M45.5 9 L47.5 14 H52.5 L48.5 17 L50 22 L45.5 19 L41 22 L42.5 17 L38.5 14 H43.5 Z" />
        </>
      )}

      {conquista.simbolo === 'montanha' && (
        <>
          <path d="M32 13 L51 48 H13 Z" />
          <path d="M32 13 L41 29 L36 27 L31.5 32 L27 26 L23 29 Z" fill="#e2e8f0" />
        </>
      )}

      {conquista.simbolo === 'elo' && (
        <>
          <circle cx="25" cy="32" r="11" fill="none" stroke="#0b1020" stroke-width="5" />
          <circle cx="39" cy="32" r="11" fill="none" stroke="#0b1020" stroke-width="5" />
        </>
      )}

      {conquista.simbolo === 'diamante' && (
        <>
          <path d="M32 12 L50 28 L32 52 L14 28 Z" />
          <path
            d="M14 28 H50 M32 12 L24 28 L32 52 L40 28 Z"
            fill="none"
            stroke="#e2e8f0"
            stroke-width="2"
          />
        </>
      )}

      {conquista.simbolo === 'chama' && (
        <>
          <path d="M32 11 C40 22 44 27 44 35 A12 12 0 0 1 20 35 C20 27 24 22 32 11 Z" />
          <path d="M32 29 C36 34 37 36 37 39 A5 5 0 0 1 27 39 C27 36 28 34 32 29 Z" fill="#e2e8f0" />
        </>
      )}

      {conquista.simbolo === 'mascaras' && (
        <>
          <path d="M14 18 H31 V34 C31 42 27 48 22.5 48 C18 48 14 42 14 34 Z" />
          <circle cx="19" cy="28" r="2.5" fill="#e2e8f0" />
          <circle cx="26" cy="28" r="2.5" fill="#e2e8f0" />
          <path d="M33 18 H50 V34 C50 42 46 48 41.5 48 C37 48 33 42 33 34 Z" />
          <path d="M37 27 L41 30 M46 27 L42 30" stroke="#e2e8f0" stroke-width="2.5" stroke-linecap="round" />
        </>
      )}

      {conquista.simbolo === 'tijolos' && (
        <>
          <rect x="14" y="19" width="36" height="8" rx="1.5" />
          <rect x="14" y="29" width="16" height="8" rx="1.5" />
          <rect x="34" y="29" width="16" height="8" rx="1.5" />
          <rect x="14" y="39" width="36" height="8" rx="1.5" />
        </>
      )}

      {conquista.simbolo === 'gota' && (
        <>
          <path d="M32 12 C32 12 18 30 18 38 A14 14 0 0 0 46 38 C46 30 32 12 32 12 Z" />
          <path
            d="M39 39 A7 7 0 0 1 32 46"
            fill="none"
            stroke="#e2e8f0"
            stroke-width="2.5"
            stroke-linecap="round"
          />
        </>
      )}

      {conquista.simbolo === 'calendario' && (
        <>
          <rect x="20" y="11" width="5" height="11" rx="2" />
          <rect x="39" y="11" width="5" height="11" rx="2" />
          <rect x="13" y="17" width="38" height="33" rx="3.5" />
          <rect x="13" y="25" width="38" height="2.5" fill="#e2e8f0" />
          <path
            d="M23 38 L29 44 L42 31"
            fill="none"
            stroke="#e2e8f0"
            stroke-width="4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </>
      )}

      {conquista.simbolo === 'bandeira' && (
        <>
          <rect x="17" y="11" width="4.5" height="41" rx="2" />
          <path d="M21.5 14 H49 L42 24 L49 34 H21.5 Z" />
        </>
      )}

      {conquista.simbolo === 'teia' && (
        <g fill="none" stroke="#0b1020" stroke-width="2.5" stroke-linecap="round">
          <path d="M15 15 V48 M15 15 H48 M15 15 L43 43 M15 15 L29 47 M15 15 L47 29" />
          <path d="M15 25 Q24 24 25 15" />
          <path d="M15 34 Q31 32 33 15" />
          <path d="M15 43 Q38 40 41 15" />
        </g>
      )}

      {conquista.simbolo === 'cofre' && (
        <>
          <rect x="13" y="15" width="38" height="34" rx="3.5" />
          <circle cx="32" cy="32" r="8" fill="none" stroke="#e2e8f0" stroke-width="3" />
          <path
            d="M32 24 V20 M32 44 V40 M24 32 H20 M44 32 H40"
            fill="none"
            stroke="#e2e8f0"
            stroke-width="3"
            stroke-linecap="round"
          />
        </>
      )}

      {conquista.simbolo === 'bigorna' && (
        <path d="M14 20 H50 C50 27 42 30 36 31 V36 H44 L47 47 H17 L20 36 H28 V31 C21 30 14 27 14 20 Z" />
      )}

      {conquista.simbolo === 'moldura' && (
        <>
          <rect x="13" y="14" width="38" height="36" rx="3" />
          <rect x="19" y="20" width="26" height="24" rx="1.5" fill="#e2e8f0" />
          <path d="M22 41 L29 31 L34 37 L38 33 L42 41 Z" />
        </>
      )}

      {conquista.simbolo === 'maca' && (
        <>
          <path d="M32 23 C28 19 21 19 18 25 C15 31 18 42 23 47 C26 50 29 48 32 48 C35 48 38 50 41 47 C46 42 49 31 46 25 C43 19 36 19 32 23 Z" />
          <path d="M32 23 V15" fill="none" stroke="#e2e8f0" stroke-width="3" stroke-linecap="round" />
          <path d="M33 18 C37 13 43 14 44 16 C42 21 36 22 33 18 Z" fill="#e2e8f0" />
        </>
      )}

      {conquista.simbolo === 'vela' && (
        <>
          <rect x="25" y="26" width="14" height="23" rx="2" />
          <rect x="19" y="47" width="26" height="4.5" rx="2" />
          <path d="M32 10 C36 16 38.5 19.5 38.5 23 A6.5 6.5 0 0 1 25.5 23 C25.5 19.5 28 16 32 10 Z" fill="#e2e8f0" />
        </>
      )}

      {conquista.simbolo === 'coracao' && (
        <path d="M32 51 C13 38 11 27 17.5 20 C23 14 30 16.5 32 23 C34 16.5 41 14 46.5 20 C53 27 51 38 32 51 Z" />
      )}

      {conquista.simbolo === 'ampulheta' && (
        <>
          <rect x="14" y="10" width="36" height="4.5" rx="2" />
          <rect x="14" y="49" width="36" height="4.5" rx="2" />
          <path d="M19 14 H45 V19 L34 32 L45 45 V50 H19 V45 L30 32 L19 19 Z" />
        </>
      )}

      {conquista.simbolo === 'tridente' && (
        <>
          <path
            d="M16 15 V25 C16 31 20 34 26 35 M48 15 V25 C48 31 44 34 38 35 M32 13 V35"
            fill="none"
            stroke="#0b1020"
            stroke-width="4.5"
            stroke-linecap="round"
          />
          <rect x="29.5" y="32" width="5" height="21" rx="2" />
          <rect x="22" y="35" width="20" height="4" rx="2" />
        </>
      )}

      {conquista.simbolo === 'bifurcacao' && (
        <>
          <path
            d="M32 53 V34 L20 20 M32 34 L44 20"
            fill="none"
            stroke="#0b1020"
            stroke-width="5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <circle cx="19" cy="17" r="5.5" />
          <circle cx="45" cy="17" r="5.5" />
        </>
      )}

      {conquista.simbolo === 'coringa' && (
        <g transform="rotate(-8 32 32)">
          <rect x="18" y="11" width="28" height="42" rx="3.5" />
          <path d="M32 21 L34.5 28.5 H42.5 L36 33.5 L38.5 41 L32 36.5 L25.5 41 L28 33.5 L21.5 28.5 H29.5 Z" fill="#e2e8f0" />
        </g>
      )}

      {conquista.simbolo === 'pomba' && (
        <>
          <path d="M49 14 C40 14 33 18 29 25 C22 22 15 26 13 34 C19 32 23 33 25 35 C21 40 19 46 19 51 C28 49 37 42 41 33 C47 29 50 22 49 14 Z" />
          <circle cx="43" cy="20" r="1.8" fill="#e2e8f0" />
        </>
      )}

      {conquista.simbolo === 'garfo' && (
        <>
          <path
            d="M23 12 V25 M28 12 V25 M33 12 V25"
            fill="none"
            stroke="#0b1020"
            stroke-width="3.5"
            stroke-linecap="round"
          />
          <path d="M18 24 C18 30 22 33 26 34 V52 H32 V34 C36 33 40 30 40 24 Z" />
        </>
      )}

      {conquista.simbolo === 'porta' && (
        <>
          <rect x="16" y="11" width="32" height="42" rx="2.5" />
          <rect x="21" y="16" width="22" height="37" rx="1.5" fill="#e2e8f0" />
          <circle cx="38" cy="35" r="2.6" />
        </>
      )}

      {conquista.simbolo === 'raio' && <path d="M37 9 L19 35 H30 L26 55 L46 27 H34 Z" />}

      {conquista.simbolo === 'camera' && (
        <>
          <rect x="24" y="13" width="15" height="9" rx="2" />
          <rect x="11" y="19" width="42" height="30" rx="4" />
          <circle cx="32" cy="34" r="9.5" fill="#e2e8f0" />
          <circle cx="32" cy="34" r="5" />
        </>
      )}

      {conquista.simbolo === 'fantasma' && (
        <>
          <path d="M32 11 C21.5 11 15 19.5 15 30 V53 L21 48 L26.5 53 L32 48 L37.5 53 L43 48 L49 53 V30 C49 19.5 42.5 11 32 11 Z" />
          <circle cx="26" cy="29" r="3.2" fill="#e2e8f0" />
          <circle cx="38" cy="29" r="3.2" fill="#e2e8f0" />
        </>
      )}

      {conquista.simbolo === 'ciclo' && (
        <>
          <path
            d="M32 17 A15 15 0 1 1 17.5 36"
            fill="none"
            stroke="#0b1020"
            stroke-width="5"
            stroke-linecap="round"
          />
          <path d="M26 10 L38 17 L26 24 Z" />
        </>
      )}

      {conquista.simbolo === 'capacete' && (
        <>
          <path d="M32 12 C21 12 15 20 15 31 V43 H22 V33 H42 V43 H49 V31 C49 20 43 12 32 12 Z" />
          <rect x="29" y="20" width="6" height="24" rx="2" fill="#e2e8f0" />
        </>
      )}

      {conquista.simbolo === 'ombreira' && (
        <>
          <path d="M12 30 C12 21 19 15 27 15 L27 27 C21 27 18 31 18 37 V45 H12 Z" />
          <path d="M52 30 C52 21 45 15 37 15 L37 27 C43 27 46 31 46 37 V45 H52 Z" />
          <rect x="28" y="18" width="8" height="28" rx="2" fill="#e2e8f0" />
        </>
      )}

      {conquista.simbolo === 'couraca' && (
        <>
          <path d="M22 13 L32 19 L42 13 L50 18 V38 C50 46 42 51 32 53 C22 51 14 46 14 38 V18 Z" />
          <path d="M32 21 V48" fill="none" stroke="#e2e8f0" stroke-width="2.5" />
          <path d="M18 30 H46" fill="none" stroke="#e2e8f0" stroke-width="2.5" />
        </>
      )}

      {conquista.simbolo === 'cinto' && (
        <>
          <rect x="10" y="25" width="44" height="14" rx="3" />
          <rect x="25" y="21" width="14" height="22" rx="3" fill="#e2e8f0" />
          <rect x="29" y="25" width="6" height="14" rx="2" />
        </>
      )}

      {conquista.simbolo === 'calca' && (
        <>
          <path d="M19 12 H45 L43 52 H34 L32 30 L30 52 H21 Z" />
          <path d="M19 20 H45" fill="none" stroke="#e2e8f0" stroke-width="2.5" />
        </>
      )}

      {conquista.simbolo === 'bracelete' && (
        <>
          <path
            d="M32 17 A15 15 0 0 1 32 47"
            fill="none"
            stroke="#0b1020"
            stroke-width="8"
            stroke-linecap="round"
          />
          <path
            d="M32 17 A15 15 0 0 0 32 47"
            fill="none"
            stroke="#0b1020"
            stroke-width="8"
            stroke-linecap="round"
            stroke-dasharray="6 7"
          />
        </>
      )}

      {conquista.simbolo === 'anel' && (
        <>
          <circle cx="32" cy="37" r="14" fill="none" stroke="#0b1020" stroke-width="6" />
          <path d="M32 10 L38 20 H26 Z" />
        </>
      )}

      {conquista.simbolo === 'lamina' && (
        <>
          <path d="M40 10 L46 16 L26 44 L20 38 Z" />
          <rect x="15" y="39" width="12" height="5" rx="2" transform="rotate(45 21 41.5)" />
          <rect x="12" y="45" width="10" height="7" rx="2.5" />
        </>
      )}

      {conquista.simbolo === 'gargantilha' && (
        <>
          <path
            d="M16 16 A18 18 0 0 0 32 36 A18 18 0 0 0 48 16"
            fill="none"
            stroke="#0b1020"
            stroke-width="5"
            stroke-linecap="round"
          />
          <path d="M32 34 L40 44 L32 54 L24 44 Z" fill="none" stroke="#0b1020" stroke-width="4" />
        </>
      )}

      {conquista.simbolo === 'soquete' && (
        <>
          <circle cx="32" cy="32" r="18" fill="none" stroke="#0b1020" stroke-width="5" />
          <path d="M32 21 L41 32 L32 43 L23 32 Z" fill="none" stroke="#0b1020" stroke-width="4" />
        </>
      )}

      {conquista.simbolo === 'duas-laminas' && (
        <>
          <path d="M20 11 L26 15 L20 44 L14 40 Z" />
          <rect x="12" y="43" width="11" height="6" rx="2.5" />
          <path d="M44 11 L50 15 L44 44 L38 40 Z" fill="#e2e8f0" />
          <rect x="36" y="43" width="11" height="6" rx="2.5" fill="#e2e8f0" />
        </>
      )}

      {conquista.simbolo === 'dois-aneis' && (
        <>
          <circle cx="23" cy="34" r="11" fill="none" stroke="#0b1020" stroke-width="5" />
          <circle cx="43" cy="34" r="11" fill="none" stroke="#e2e8f0" stroke-width="5" />
          <path d="M23 14 L28 22 H18 Z" />
          <path d="M43 14 L48 22 H38 Z" fill="#e2e8f0" />
        </>
      )}
    </g>

    {!conquistada && (
      <path
        d="M27 32 V28 A5 5 0 0 1 37 28 V32 M24.5 32 H39.5 V44 H24.5 Z"
        fill="none"
        stroke="#0b1020"
        stroke-opacity="0.85"
        stroke-width="2.5"
        stroke-linejoin="round"
      />
    )}
  </svg>

  {/* Contador sobreposto, como notificação não lida. Só a partir de 2: "1"
      num canto não acrescenta nada a uma medalha que já está acesa. */}
  {vezes > 1 && (
    <span
      class="absolute -top-1 -right-1 min-w-[22px] h-[22px] px-1.5 rounded-full bg-[#f0a500] text-[#0b1020] text-[11px] font-bold flex items-center justify-center border-2 border-[#0b1020] tabular-nums"
      aria-hidden="true"
    >
      {vezes}
    </span>
  )}

  <span
    role="tooltip"
    class="pointer-events-none absolute left-1/2 -translate-x-1/2 top-full mt-2 z-20 w-52 rounded-lg border border-white/10 bg-[#141b2d] p-3 text-left opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-opacity shadow-xl"
  >
    <span class="block text-slate-200 text-[11px] font-semibold">
      {conquista.nome}
      {vezes > 1 && <span class="text-[#f0a500]"> · {vezes}×</span>}
    </span>

    {detalhe && (
      <span class="block text-[#f0a500] text-[11px] leading-relaxed mt-1">{detalhe}</span>
    )}

    {conquistada && personagens.length > 0 && (
      <span class="block text-slate-300 text-[11px] leading-relaxed mt-1">
        Como {personagens.join(' e ')}
      </span>
    )}

    <span class="block text-slate-400 text-[11px] leading-relaxed mt-1">{conquista.como}</span>

    {!conquistada && (
      <span class="block text-slate-500 text-[11px] mt-1.5">Ainda não conquistada.</span>
    )}
  </span>
</div>
