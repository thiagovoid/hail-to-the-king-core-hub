---
import type { OverallPerformanceScore } from '@/engine/scores';

interface Props {
  score: OverallPerformanceScore;
  /** Variação do dps/hps no período, em % — positivo é melhora. */
  trend: number | null;
  attendance: number;
  /** Quantas runs entraram na conta — deixa a nota rastreável. */
  runs: number;
}

const { score, trend, attendance, runs } = Astro.props;

// Faixa neutra: abaixo de 5% pra qualquer lado é ruído de boss/composição,
// não tendência — não vale pintar de verde nem de vermelho.
const trendColor =
  trend === null || Math.abs(trend) < 5
    ? 'text-slate-200'
    : trend > 0
      ? 'text-emerald-400'
      : 'text-red-400';

const scoreTextColor = (value: number) =>
  value >= 80 ? 'text-emerald-400' : value >= 50 ? 'text-amber-400' : 'text-red-400';

const scoreBarColor = (value: number) =>
  value >= 80 ? 'bg-emerald-500' : value >= 50 ? 'bg-amber-500' : 'bg-red-500';

const directionLabel = (direction: 'higher' | 'lower') =>
  direction === 'higher' ? 'quanto maior, melhor' : 'quanto menor, melhor';
---

<section class="mb-10">
  <div class="mb-4">
    <h2 class="text-xl font-bold text-white">
      Performance geral
    </h2>

    <p class="text-sm text-slate-400 mt-1">
      Média de {runs} run(s) da temporada, medindo a noite de raid inteira (todas
      as trys, não só os kills) contra as metas do core. Dimensão sem dado tem o
      peso redistribuído entre as demais, em vez de pesar contra o jogador.
    </p>
  </div>

  <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-5">
    <div class="flex items-center justify-between gap-4 mb-5">
      <span class="text-sm font-semibold text-slate-300">
        Score geral
      </span>

      {
        score.overall !== null ? (
          <span class={`text-3xl font-bold ${scoreTextColor(score.overall)}`}>
            {score.overall}
            <span class="text-base text-slate-500">/100</span>
          </span>
        ) : (
          <span class="text-sm text-slate-500">
            Dados insuficientes
          </span>
        )
      }
    </div>

    <div class="space-y-3">
      {
        score.dimensions.map((dimension) => (
          <div>
            <div class="flex justify-between text-xs mb-1">
              <span class="text-slate-400 flex items-center gap-1.5">
                {dimension.label}
                <span class="text-slate-600">({dimension.weight}%)</span>

                <span class="relative group inline-flex">
                  <button
                    type="button"
                    class="w-3.5 h-3.5 rounded-full border border-slate-600 text-slate-500 text-[9px] leading-none flex items-center justify-center hover:border-[#f0a500] hover:text-[#f0a500] transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-[#f0a500]"
                    aria-label={`O que é ${dimension.label}`}
                  >
                    i
                  </button>

                  <span
                    role="tooltip"
                    class="pointer-events-none absolute left-1/2 -translate-x-1/2 bottom-full mb-2 z-20 w-64 rounded-lg border border-white/10 bg-[#141b2d] p-3 text-left opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-opacity shadow-xl"
                  >
                    <span class="block text-slate-200 text-[11px] leading-relaxed">
                      {dimension.description}
                    </span>
                    <span class="block text-slate-400 text-[11px] leading-relaxed mt-2">
                      <span class="text-slate-500 font-semibold">Fonte:</span> {dimension.source}
                    </span>
                    <span class="block text-slate-400 text-[11px] leading-relaxed mt-2">
                      <span class="text-slate-500 font-semibold">Meta do core:</span>{' '}
                      {dimension.target.target} ({directionLabel(dimension.target.direction)})
                    </span>
                  </span>
                </span>
              </span>

              <span class={dimension.score !== null ? 'text-slate-300' : 'text-slate-600'}>
                {dimension.score !== null ? dimension.score : 'sem dado'}
              </span>
            </div>

            <div class="h-1.5 bg-slate-800 rounded-full overflow-hidden">
              {dimension.score !== null && (
                <div
                  class={`h-full rounded-full ${scoreBarColor(dimension.score)}`}
                  style={`width: ${dimension.score}%`}
                />
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4 mt-4">
    <article class="bg-slate-900/60 border border-slate-800 rounded-xl p-4">
      <p class="text-xs uppercase tracking-wide text-slate-500">
        Tendência
      </p>

      <strong class={`block text-2xl font-bold mt-1 ${trendColor}`}>
        {trend !== null ? `${trend > 0 ? '+' : ''}${trend}%` : '-'}
      </strong>

      <p class="text-[11px] text-slate-500 mt-1">
        Evolução do seu dps/hps ao longo das runs
      </p>
    </article>

    <article class="bg-slate-900/60 border border-slate-800 rounded-xl p-4">
      <p class="text-xs uppercase tracking-wide text-slate-500">
        Presença
      </p>

      <strong class="block text-2xl font-bold text-white mt-1">
        {attendance}%
      </strong>

      <p class="text-[11px] text-slate-500 mt-1">
        Runs em que você aparece no log
      </p>
    </article>
  </div>
</section>
