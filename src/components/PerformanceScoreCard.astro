---
import type { OverallPerformanceScore } from '@/engine/scores';
import { formatDecimalBr, formatDuracao, formatThousands } from '@/utils/format';
import ScoreDimensionRow from '@/components/ScoreDimensionRow.astro';
import InfoTooltip from '@/components/InfoTooltip.astro';
import { ROTULO_DA_CATEGORIA } from '@/normalization/buildAjudar';

interface Props {
  score: OverallPerformanceScore;
  /** Variação do dps/hps no período, em % — positivo é melhora. */
  trend: number | null;
  attendance: number;
  /** Data da noite medida — deixa a nota rastreável. */
  nightDate?: string | null;
  /**
   * Em quantas trys o jogador esteve naquela noite. Aparece porque duas
   * notas não são comparáveis sem isso: 2,0 em 3 trys e 2,0 em 12 dizem
   * coisas diferentes, e um fight que falhe na coleta encolhe a base sem
   * nada na tela avisar.
   */
  nightTries?: number | null;
  /**
   * Slots sem encanto ou sem gema na última noite. Mostrado sob a barra de
   * Preparação: a nota sozinha não diz o que fazer, a lista diz.
   */
  preparationMissing?: string[];
  /**
   * Onde os erros mecânicos aconteceram na temporada, do mais frequente pro
   * menos. Mesma ideia da lista de preparação: a nota diz quanto, isto diz
   * o que treinar.
   */
  mechanicsDetail?: Array<{
    boss: string;
    mechanic: string;
    label?: string;
    tries: number;
    /** Explicação visual no MythicTrap, quando a Wipefest tem uma. */
    tipEmbedUrl?: string;
  }>;
  /** Cooldowns ofensivos da noite, do pior aproveitado pro melhor. */
  attackDetail?: Array<{ spellId: number; name: string; casts: number; efficiency: number }>;
  /** As duas metades da nota de Atacar, pra tela não esconder de onde ela veio. */
  attackParts?: { uptime: number; cooldowns: number | null } | null;
  /** Cooldowns defensivos da noite, do pior aproveitado pro melhor. */
  defenseDetail?: Array<{ spellId: number; name: string; casts: number; efficiency: number }>;
  /** Dano recebido e mitigação — contexto da nota de Defender, não entram nela. */
  defenseContext?: { mitigation: number; dtps: number; selfSustain?: number } | null;
  /** Magia a magia da utilidade de grupo — o que explica a nota de Ajudar. */
  helpDetail?: Array<{
    spellId: number;
    name: string;
    casts: number;
    efficiency: number;
    categoria: "acelerar" | "controlar" | "interromper" | "socorrer" | "levantar";
  }>;
  /**
   * As mortes da noite, da mais cara pra mais barata.
   *
   * "18,5% do tempo morto" é verdade e não se entende. "Sentinelas, caiu aos
   * 1:12 de 3:40, Gotículas Tóxicas" é a mesma informação dita de um jeito
   * que dá pra agir.
   */
  deathDetail?: Array<{
    encounterID: number;
    atSecond: number;
    fightSeconds: number;
    afterSeconds: number;
    ability?: string;
  }>;
  /** encounterID -> nome do boss, pra morte dizer ONDE. */
  nomeDoEncontro?: Record<number, string>;
  /**
   * O laudo do interrupt: quantos foram seus, quantos deu pra pegar, e
   * quanto o raide cobriu.
   *
   * Contadas por ato, não por recarga de magia. `oportunidade` nula significa
   * que não havia o que interromper nas trys desta pessoa — o caso de sete
   * dos dez encontros da temporada.
   */
  interrupcoes?: {
    total: number;
    oportunidade: {
      oportunidades: number;
      cobertosPeloRaide: number;
      seus: number;
      pessoasQueInterromperam: number;
    } | null;
  } | null;
  /** As duas metades da nota de Curar, mais a cobertura crua. */
  healingParts?: { coverage: number; share: number; overheal: number } | null;
  /** Nome da função usada pra escolher os pesos ("tank", "healer", "dps"). */
  funcao?: string | null;
  /**
   * As regras do core sobre como ler estes números.
   *
   * Vêm de fora, do mesmo rules.json que alimenta a página de regras: quem
   * abre a própria página e vê um score não necessariamente passou por lá, e
   * é justamente aqui que o contrato importa. Duplicar o texto faria as duas
   * telas divergirem no primeiro ajuste.
   */
  regrasDoCore?: string[];
}

const {
  score,
  trend,
  attendance,
  nightDate = null,
  nightTries = null,
  preparationMissing = [],
  mechanicsDetail = [],
  attackDetail = [],
  attackParts = null,
  defenseDetail = [],
  defenseContext = null,
  helpDetail = [],
  deathDetail = [],
  nomeDoEncontro = {},
  interrupcoes = null,
  healingParts = null,
  funcao = null,
  regrasDoCore = [],
} = Astro.props;

// Faixa neutra: abaixo de 5% pra qualquer lado é ruído de boss/composição,
// não tendência — não vale pintar de verde nem de vermelho.
const trendColor =
  trend === null || Math.abs(trend) < 5
    ? 'text-slate-200'
    : trend > 0
      ? 'text-emerald-400'
      : 'text-red-400';

const scoreTextColor = (value: number) =>
  value >= 80 ? 'text-emerald-400' : value >= 50 ? 'text-amber-400' : 'text-red-400';

/**
 * A cor conta se a meta foi cumprida, não quanto do caminho foi andado.
 *
 * Antes usava o progresso: 2,3 erros contra meta 2 dava 87% e pintava de
 * verde, com a meta estourada. Agora verde é só quem cumpre; âmbar é quem
 * está perto (80% do caminho); vermelho, longe.
 */
/** 2.3 fica 2,3; 34 fica 34 — sem casa decimal inventada. */
/** 2026-09-15 -> 15/09/2026, pra dizer qual noite a nota mede. */
const formatarNoite = (iso: string) => {
  const [ano, mes, dia] = iso.split("-");
  return `${dia}/${mes}/${ano}`;
};

/**
 * A conta do Score geral, linha a linha, com os números DESTA pessoa.
 *
 * Explicar a fórmula em texto ("média ponderada das dimensões disponíveis")
 * não responde a pergunta que as pessoas fazem, que é "por que o MEU deu
 * 61". Mostrar peso × nota de cada dimensão e o divisor responde — e deixa
 * visível o que é fácil de duvidar: o divisor encolhe quando falta dado, em
 * vez de a dimensão entrar como zero.
 */
const dimensoesComDado = score.dimensions.filter(
  (dimension): dimension is typeof dimension & { score: number } =>
    // Sobreviver fica FORA da soma: ela não é parcela, é multiplicador, e
    // aparece logo abaixo como "× 0,91". Dentro da conta ela virava uma
    // linha "0% × 52 = 0", que soma zero e sugere que a dimensão foi
    // zerada — justamente o contrário do que ela faz com a nota.
    dimension.score !== null &&
    dimension.key !== 'survival' &&
    dimension.key !== 'preparation' &&
    dimension.key !== 'parse'
);

const contaDoScore = dimensoesComDado.map((dimension) => ({
  label: dimension.label,
  weight: dimension.weight,
  score: dimension.score,
  produto: Math.round(dimension.weight * dimension.score),
}));

const pesoDisponivel = dimensoesComDado.reduce((soma, dimension) => soma + dimension.weight, 0);
const somaDosProdutos = contaDoScore.reduce((soma, linha) => soma + linha.produto, 0);

/**
 * O desconto por tempo morto, pronto pra tela.
 *
 * Null quando não há desconto nenhum — mostrar "× 1,00" só ocuparia espaço
 * pra dizer que nada aconteceu. Ver `fatorDeSobrevivencia`.
 */
/**
 * As dimensões na ordem em que importam PRA ESTA PESSOA, sem as que não são
 * dela.
 *
 * Duas regras, as duas pedidas pelo core:
 *
 * 1. **Do maior peso pro menor.** A ordem era fixa pra todo mundo, então o
 *    tanque via Parse (peso 10 pra ele) antes de Defender (peso 30). Quem lê
 *    de cima pra baixo lia na ordem errada de importância.
 * 2. **Dimensão que não é da spec não aparece.** "Curar —" na ficha de um
 *    mago não informa nada: ele nunca vai curar. Peso zero E sem dado é o
 *    par que identifica isso — Curar num healer tem peso, e Mecânicas sem
 *    coleta tem peso, e as duas continuam aparecendo.
 *
 * Sobreviver fica por último de propósito, mesmo com peso zero: ela não é
 * parcela, é o multiplicador que fecha a conta, e é nessa ordem que a conta
 * acontece.
 */
const dimensoesVisiveis = [...score.dimensions]
  // Preparação saiu da lista porque virou PORTÃO, com seção própria: ela não
  // pontua mais, e uma linha de peso zero no meio das que pontuam faria
  // parecer que ela conta um pouquinho.
  // Parse saiu da nota junto com Preparação, mas por outro motivo: ele só
  // existe pra boss MORTO, e num grupo em progressão isso mede justamente as
  // lutas já dominadas. Continua na tela como contexto — no resumo da
  // temporada e no gráfico —, só não pontua mais.
  .filter((dimension) => dimension.key !== "preparation" && dimension.key !== "parse")
  .filter((dimension) => dimension.weight > 0 || dimension.value !== null)
  .sort((a, b) => {
    if (a.key === 'survival') return 1;
    if (b.key === 'survival') return -1;
    return b.weight - a.weight;
  });

const dimensaoDeSobreviver = score.dimensions.find((d) => d.key === "survival");
const descontoDeSobrevivencia =
  score.survivalFactor !== null && score.survivalFactor < 1 && dimensaoDeSobreviver?.value !== null
    ? {
        fator: score.survivalFactor!.toFixed(2).replace(".", ","),
        share: String(dimensaoDeSobreviver!.value).replace(".", ","),
        meta: dimensaoDeSobreviver!.target.target,
        excesso: `${(dimensaoDeSobreviver!.value! - dimensaoDeSobreviver!.target.target)
          .toFixed(1)
          .replace(".", ",")} pontos`,
      }
    : null;

/**
 * O detalhe explica a nota, mas são até sete linhas por dimensão — cinco
 * dimensões abertas de uma vez viravam parede de texto e escondiam o próprio
 * score. Fica recolhido, com um rótulo que diz o que tem dentro: "Detalhes"
 * sozinho não dá motivo pra ninguém clicar.
 */
const detalheDaDimensao: Partial<Record<string, { rotulo: string; itens: number }>> = {
  mechanics: mechanicsDetail.length
    ? { rotulo: 'Ver quais mecânicas', itens: mechanicsDetail.length }
    : undefined,
  attack:
    attackParts !== null || attackDetail.length > 0
      ? { rotulo: 'Ver uptime e cooldowns', itens: attackDetail.length }
      : undefined,
  defense:
    defenseContext !== null || defenseDetail.length > 0
      ? { rotulo: 'Ver dano recebido e cooldowns', itens: defenseDetail.length }
      : undefined,
  help:
    helpDetail.length > 0 || interrupcoes !== null
      ? { rotulo: 'Ver o que você fez pelo grupo', itens: helpDetail.length }
      : undefined,
  survival: deathDetail.length
    ? { rotulo: 'Ver cada morte e o que custou', itens: deathDetail.length }
    : undefined,
  healing: healingParts !== null ? { rotulo: 'Ver cobertura e desperdício', itens: 0 } : undefined,
  preparation: preparationMissing.length
    ? { rotulo: 'Ver o que falta arrumar', itens: preparationMissing.length }
    : undefined,
};
---

<section class="mb-10">
  <div class="mb-4">
    <h2 class="text-xl font-bold text-white">
      <span class="inline-flex items-center gap-2 flex-wrap">
        Performance da última run

        {regrasDoCore.length > 0 && (
          <InfoTooltip label="Como o core lê estes números" largura="larga" direcao="baixo">
            <span class="block text-slate-200 text-[11px] font-semibold">
              Como a gente lê estes números
            </span>

            <span class="block mt-2 space-y-1.5">
              {regrasDoCore.map((regra) => (
                <span class="flex gap-2 text-[11px] text-slate-400 leading-relaxed">
                  <span class="text-[#f0a500] shrink-0">▸</span>
                  <span>{regra}</span>
                </span>
              ))}
            </span>
          </InfoTooltip>
        )}

        {regrasDoCore.length > 0 && (
          <a
            href="/regras/#cat-core"
            class="text-xs font-normal text-slate-500 hover:text-[#f0a500] transition-colors"
          >
            regras do core
          </a>
        )}
      </span>
    </h2>

    <p class="text-sm text-slate-400 mt-1">
      {nightDate ? `Noite de ${formatarNoite(nightDate)}` : 'Última noite de raid'}
      {nightTries !== null && ` · ${nightTries} ${nightTries === 1 ? 'try' : 'trys'}`} —
      a raid inteira, todas as trys, não só os kills, comparada às metas do core.
      É a foto de agora, não a média da temporada: a evolução está no gráfico
      abaixo. Dimensão sem dado tem o peso redistribuído entre as demais, em vez
      de pesar contra o jogador.
    </p>
  </div>

  <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-5">
    <div class="flex items-center justify-between gap-4 mb-5">
      <span class="text-sm font-semibold text-slate-300 inline-flex items-center gap-1.5">
        Score geral

        <InfoTooltip label="Como o Score geral é calculado" largura="larga">
          <span class="block text-slate-200 text-[11px] leading-relaxed">
            Cada dimensão vira uma nota de 0 a 100 — o quanto do caminho até a meta do core você
            andou. O Score geral é a média dessas notas, com peso
            {funcao ? ` da régua de ${funcao}` : ''}.
          </span>

          {contaDoScore.length > 0 ? (
            <>
              <span class="block mt-2 pt-2 border-t border-white/10">
                {contaDoScore.map((linha) => (
                  <span class="flex justify-between gap-3 text-[11px] text-slate-400 tabular-nums">
                    <span>{linha.label}</span>
                    <span>
                      {linha.weight}% × {linha.score} = {linha.produto}
                    </span>
                  </span>
                ))}
              </span>

              <span class="flex justify-between gap-3 text-[11px] text-slate-200 font-semibold mt-1.5 pt-1.5 border-t border-white/10 tabular-nums">
                <span>{somaDosProdutos} ÷ {pesoDisponivel}%</span>
                <span>= {score.beforeSurvival}</span>
              </span>

              {/* Sobreviver não é parcela, é multiplicador: a melhor
                  preparação e o melhor dps não valem nada se o raide seguiu
                  sem você. Aparece como linha separada porque a pessoa
                  precisa ver de onde o desconto veio. */}
              {descontoDeSobrevivencia !== null && (
                <>
                  <span class="flex justify-between gap-3 text-[11px] text-amber-400 mt-1 tabular-nums">
                    <span>× sobrevivência</span>
                    <span>× {descontoDeSobrevivencia.fator}</span>
                  </span>

                  <span class="flex justify-between gap-3 text-[11px] text-slate-200 font-semibold mt-1.5 pt-1.5 border-t border-white/10 tabular-nums">
                    <span>Score geral</span>
                    <span>= {score.overall}</span>
                  </span>

                  <span class="block text-slate-500 text-[11px] leading-relaxed mt-2">
                    Você passou {descontoDeSobrevivencia.share}% do tempo de luta morto com o raide
                    ainda lutando — {descontoDeSobrevivencia.excesso} acima da meta de{' '}
                    {descontoDeSobrevivencia.meta}%. Dentro da meta não desconta nada: progressão
                    tem morte, e morrer na call de wipe custa quase zero.
                  </span>
                </>
              )}
            </>
          ) : (
            <span class="block text-slate-400 text-[11px] mt-2">
              Nenhuma dimensão tem dado nesta run.
            </span>
          )}

          {pesoDisponivel < 100 && (
            <span class="block text-slate-500 text-[11px] leading-relaxed mt-2">
              Falta dado em {100 - pesoDisponivel}% dos pesos. Dimensão sem dado é descartada e o
              divisor encolhe junto — ela nunca conta como zero.
            </span>
          )}
        </InfoTooltip>
      </span>

      {
        score.overall !== null ? (
          <span class={`text-3xl font-bold ${scoreTextColor(score.overall)}`}>
            {score.overall}
            <span class="text-base text-slate-500">/100</span>
          </span>
        ) : (
          <span class="text-sm text-slate-500">
            Dados insuficientes
          </span>
        )
      }
    </div>

    <div class="space-y-3">
      {
        dimensoesVisiveis.map((dimension) => {
          const detalhe = detalheDaDimensao[dimension.key];

          // Quem não tem o que detalhar não vira <details>: seta sem conteúdo
          // é promessa que a interface não cumpre.
          if (!detalhe) {
            return (
              <div class="dimensao">
                <ScoreDimensionRow
                  dimension={dimension}
                  multiplicador={descontoDeSobrevivencia?.fator ?? null}
                />
              </div>
            );
          }

          return (
            <details class="dimensao">
              {/* A linha inteira é o gatilho, não só a seta: alvo de clique
                  maior e o teclado alcança com um Tab só. */}
              <summary class="gatilho">
                <ScoreDimensionRow
                  dimension={dimension}
                  temDetalhe
                  itensDetalhe={detalhe.itens}
                  rotuloDetalhe={detalhe.rotulo}
                />
              </summary>

              <div class="conteudo">
                {dimension.key === 'preparation' && preparationMissing.length > 0 && (
                  <p class="text-[11px] text-slate-500 leading-relaxed">
                    <span class="text-slate-400">Falta arrumar:</span> {preparationMissing.join(', ')}
                  </p>
                )}

                {/* "x11" fazia o número parecer quantidade da habilidade. É
                    frequência: em quantas trys ela foi errada. O denominador
                    responde "de quantas?" sem a pessoa procurar. */}
                {dimension.key === 'mechanics' && mechanicsDetail.length > 0 && (
                  <ul class="space-y-1">
                    {mechanicsDetail.map((item) => (
                      <li class="text-[11px] text-slate-500 leading-relaxed">
                        <span class="text-slate-400">
                          {item.label ?? item.mechanic.replace('Damage from ', '')}
                        </span>{' '}
                        {nightTries !== null ? `em ${item.tries} de ${nightTries} trys` : `em ${item.tries} trys`}
                        <span class="text-slate-600"> &middot; {item.boss}</span>

                        {/* O MythicTrap carrega SÓ no clique: a página não pode
                            depender do tempo de resposta deles pra abrir. */}
                        {item.tipEmbedUrl && (
                          <details class="mt-1 group/trap">
                            <summary class="cursor-pointer text-[#f0a500] hover:underline list-none inline-flex items-center gap-1">
                              <span class="inline-block transition-transform group-open/trap:rotate-90">&rsaquo;</span>
                              ver a mecânica
                            </summary>

                            <div class="mt-2 rounded-lg overflow-hidden border border-slate-800 bg-[#0b1020]">
                              <iframe
                                src={item.tipEmbedUrl}
                                loading="lazy"
                                title={`MythicTrap — ${item.label ?? item.mechanic}`}
                                class="w-full h-[320px]"
                                referrerpolicy="no-referrer"
                                sandbox="allow-scripts allow-same-origin"
                              />
                            </div>

                            <p class="text-[10px] text-slate-600 mt-1">
                              Explicação do MythicTrap, via Wipefest. Só existe em inglês.
                            </p>
                          </details>
                        )}
                      </li>
                    ))}
                  </ul>
                )}

                {/* A nota de Atacar é a média de duas metades que se escondem
                    uma atrás da outra: dá pra ter uptime cheio sem nunca
                    gastar o cooldown grande. */}
                {dimension.key === 'attack' && attackParts !== null && (
                  <p class="text-[11px] text-slate-500 leading-relaxed">
                    <span class="text-slate-400">Uptime {formatDecimalBr(attackParts.uptime)}%</span>
                    {' · '}
                    {attackParts.cooldowns !== null
                      ? `cooldowns ${formatDecimalBr(attackParts.cooldowns)}% do tempo em recarga`
                      : 'sem cooldown ofensivo medido na noite'}
                  </p>
                )}

                {/* Contexto, não nota: a mitigação ficou entre 38% e 48% pro
                    raide inteiro, com os tanks nas três últimas posições. */}
                {/* A nota é média de duas metades que se contradizem com
                    frequência: quem cobre mais costuma desperdiçar mais.
                    Mostrar só o resultado esconderia justamente isso. */}
                {dimension.key === 'healing' && healingParts !== null && (
                  <p class="text-[11px] text-slate-500 leading-relaxed">
                    <span class="text-slate-400">
                      Cobriu {formatDecimalBr(healingParts.coverage)}% do dano que o raide tomou
                    </span>
                    {' · '}
                    {formatDecimalBr(healingParts.share)}% do seu quinhão
                    {' · '}
                    {formatDecimalBr(healingParts.overheal)}% da cura caiu em quem já estava cheio
                  </p>
                )}

                {dimension.key === 'defense' && defenseContext !== null && (
                  <p class="text-[11px] text-slate-500 leading-relaxed">
                    <span class="text-slate-400">
                      {formatThousands(defenseContext.dtps)} de dano recebido por segundo
                    </span>
                    {' · '}
                    {formatDecimalBr(defenseContext.mitigation)}% mitigado
                    {defenseContext.selfSustain !== undefined && (
                      <> &middot; {formatDecimalBr(defenseContext.selfSustain)}% reposto pela sua própria cura</>
                    )}
                    <span class="text-slate-600"> &middot; contexto, não entra na nota</span>
                  </p>
                )}

                {dimension.key === 'survival' && deathDetail.length > 0 && (
                  <ul class="space-y-0.5 mt-1">
                    {deathDetail.map((morte) => (
                      <li class="text-[11px] text-slate-500 leading-relaxed">
                        {/* O momento vem antes da causa porque é o que explica o
                            CUSTO: cair aos 20s de uma luta de 5min é caro, cair
                            aos 4min50 é quase de graça. */}
                        <span class="text-slate-400">{nomeDoEncontro[morte.encounterID] ?? `Encontro ${morte.encounterID}`}</span>
                        {' '}&middot; caiu aos {formatDuracao(morte.atSecond)} de{' '}
                        {formatDuracao(morte.fightSeconds)}
                        {morte.ability && <> &middot; <span class="text-slate-400">{morte.ability}</span></>}
                        <span class="text-slate-600">
                          {' '}&middot; o raide seguiu {formatDuracao(morte.afterSeconds)}
                        </span>
                      </li>
                    ))}
                  </ul>
                )}

                {dimension.key === 'help' && (
                  <>
                    {/* Interromper é contado por ATO, não por recarga: a maior
                        parte das interrupções de algumas specs sai de habilidade
                        de rotação, que não entra em lista de cooldown nenhuma.
                        Por isso ele aparece separado das magias. */}
                    {interrupcoes !== null && (
                      <p class="text-[11px] text-slate-500 leading-relaxed">
                        <span class="text-slate-400">
                          {interrupcoes.total} interrupç{interrupcoes.total === 1 ? 'ão' : 'ões'}
                        </span>
                        {/* O denominador é o que DEU pra interromper nas trys
                            em que você estava — não o número de trys. Sete dos
                            dez encontros da temporada não têm uma única magia
                            interrompível, e a régua antiga cobrava neles. */}
                        {interrupcoes.oportunidade === null ? (
                          <span class="text-slate-600">
                            {' '}&middot; não houve o que interromper nas suas trys
                          </span>
                        ) : (
                          <>
                            {' '}&middot; de {interrupcoes.oportunidade.oportunidades} que deu pra
                            pegar
                            <span class="text-slate-600">
                              {` · o raide pegou ${interrupcoes.oportunidade.cobertosPeloRaide}, divididos entre ${interrupcoes.oportunidade.pessoasQueInterromperam} pessoa${interrupcoes.oportunidade.pessoasQueInterromperam === 1 ? '' : 's'}`}
                            </span>
                          </>
                        )}
                        <span class="block text-slate-600">
                          Interromper só soma: é trabalho de time, e não deixar de interromper
                          nunca tira nota de ninguém.
                        </span>
                      </p>
                    )}

                    <ul class="space-y-0.5 mt-1">
                      {helpDetail.map((item) => (
                        <li class="text-[11px] text-slate-500 leading-relaxed">
                          <span class="text-slate-400">{item.name}</span>{' '}
                          {item.casts} uso{item.casts === 1 ? '' : 's'}
                          <span class="text-slate-600">
                            {' '}&middot; {ROTULO_DA_CATEGORIA[item.categoria]}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </>
                )}

                {(dimension.key === 'attack' || dimension.key === 'defense') && (
                  <ul class="space-y-0.5 mt-1">
                    {(dimension.key === 'attack' ? attackDetail : defenseDetail).map((item) => (
                      <li class="text-[11px] text-slate-500 leading-relaxed">
                        <span class="text-slate-400">{item.name}</span>{' '}
                        {formatDecimalBr(item.efficiency)}% do tempo em recarga
                        <span class="text-slate-600">
                          {' '}&middot; {item.casts} uso{item.casts === 1 ? '' : 's'}
                        </span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </details>
          );
        })
      }
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4 mt-4">
    <article class="bg-slate-900/60 border border-slate-800 rounded-xl p-4">
      <p class="text-xs uppercase tracking-wide text-slate-500">
        <span class="inline-flex items-center gap-1.5">
          Tendência
          <InfoTooltip label="O que é Tendência">
            <span class="block text-slate-200 text-[11px] leading-relaxed">
              Se o seu dano (ou cura) vem subindo ou caindo ao longo de <strong>todas</strong> as
              runs do histórico. Não é a última noite contra a anterior.
            </span>
            <span class="block text-slate-400 text-[11px] leading-relaxed mt-2">
              O cálculo traça a reta que melhor acompanha os seus números e mede o quanto ela sobe
              do começo ao fim, comparado à sua própria média. +75% quer dizer que a reta subiu o
              equivalente a 75% do seu dps médio.
            </span>
            <span class="block text-slate-400 text-[11px] leading-relaxed mt-2">
              Por ser uma reta, e não dois pontos comparados, uma noite ruim isolada não derruba o
              número — mas várias seguidas, sim.
            </span>
            <span class="block text-slate-500 text-[11px] leading-relaxed mt-2">
              Compara você com você mesmo, nunca com o resto do core. Precisa de pelo menos duas
              runs pra existir.
            </span>
          </InfoTooltip>
        </span>
      </p>

      <strong class={`block text-2xl font-bold mt-1 ${trendColor}`}>
        {trend !== null ? `${trend > 0 ? '+' : ''}${trend}%` : '-'}
      </strong>

      <p class="text-[11px] text-slate-500 mt-1">
        Subida ou queda do seu dps/hps ao longo de todas as runs
      </p>
    </article>

    <article class="bg-slate-900/60 border border-slate-800 rounded-xl p-4">
      <p class="text-xs uppercase tracking-wide text-slate-500">
        Presença
      </p>

      <strong class="block text-2xl font-bold text-white mt-1">
        {attendance}%
      </strong>

      <p class="text-[11px] text-slate-500 mt-1">
        Runs em que você aparece no log
      </p>
    </article>
  </div>
</section>

<style>
  /* Um filete entre dimensões. Sem ele, o detalhe aberto de uma linha
     encostava no rótulo da seguinte e parecia pertencer a ela. */
  .dimensao + .dimensao {
    border-top: 1px solid rgb(30 41 59 / 0.7);
    margin-top: 0.5rem;
    padding-top: 0.5rem;
  }

  /* A linha inteira é o gatilho. O triângulo nativo do <summary> não é
     estilizável de forma confiável entre navegadores, então é a nossa seta
     que gira. */
  .gatilho {
    cursor: pointer;
    list-style: none;
    border-radius: 0.375rem;
  }

  .gatilho::-webkit-details-marker {
    display: none;
  }

  .gatilho:hover {
    background: rgb(148 163 184 / 0.04);
  }

  .gatilho:focus-visible {
    outline: 1px solid #f0a500;
    outline-offset: 2px;
  }

  :global(.gatilho .seta) {
    transition: transform 150ms ease;
  }

  details[open] > .gatilho :global(.seta) {
    transform: rotate(90deg);
  }

  .conteudo {
    padding: 0.5rem 0 0.125rem 0.75rem;
    border-left: 1px solid rgb(30 41 59);
    margin-left: 0.25rem;
    margin-top: 0.375rem;
  }
</style>
