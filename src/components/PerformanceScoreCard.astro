---
import type { OverallPerformanceScore } from '@/engine/scores';

interface Props {
  score: OverallPerformanceScore;
  /** Variação do dps/hps no período, em % — positivo é melhora. */
  trend: number | null;
  attendance: number;
  /** Data da noite medida — deixa a nota rastreável. */
  nightDate?: string | null;
  /**
   * Em quantas trys o jogador esteve naquela noite. Aparece porque duas
   * notas não são comparáveis sem isso: 2,0 em 3 trys e 2,0 em 12 dizem
   * coisas diferentes, e um fight que falhe na coleta encolhe a base sem
   * nada na tela avisar.
   */
  nightTries?: number | null;
  /**
   * Slots sem encanto ou sem gema na última noite. Mostrado sob a barra de
   * Preparação: a nota sozinha não diz o que fazer, a lista diz.
   */
  preparationMissing?: string[];
  /**
   * Onde os erros mecânicos aconteceram na temporada, do mais frequente pro
   * menos. Mesma ideia da lista de preparação: a nota diz quanto, isto diz
   * o que treinar.
   */
  mechanicsDetail?: Array<{ boss: string; mechanic: string; label?: string; tries: number }>;
}

const { score, trend, attendance, nightDate = null, nightTries = null, preparationMissing = [], mechanicsDetail = [] } = Astro.props;

// Faixa neutra: abaixo de 5% pra qualquer lado é ruído de boss/composição,
// não tendência — não vale pintar de verde nem de vermelho.
const trendColor =
  trend === null || Math.abs(trend) < 5
    ? 'text-slate-200'
    : trend > 0
      ? 'text-emerald-400'
      : 'text-red-400';

const scoreTextColor = (value: number) =>
  value >= 80 ? 'text-emerald-400' : value >= 50 ? 'text-amber-400' : 'text-red-400';

/**
 * A cor conta se a meta foi cumprida, não quanto do caminho foi andado.
 *
 * Antes usava o progresso: 2,3 erros contra meta 2 dava 87% e pintava de
 * verde, com a meta estourada. Agora verde é só quem cumpre; âmbar é quem
 * está perto (80% do caminho); vermelho, longe.
 */
const metaCumprida = (dimension: (typeof score.dimensions)[number]) => {
  if (dimension.value === null) return false;
  return dimension.target.direction === 'lower'
    ? dimension.value <= dimension.target.target
    : dimension.value >= dimension.target.target;
};

const corDaDimensao = (dimension: (typeof score.dimensions)[number]) => {
  if (metaCumprida(dimension)) return { barra: 'bg-emerald-500', texto: 'text-emerald-400' };
  if ((dimension.score ?? 0) >= 80) return { barra: 'bg-amber-500', texto: 'text-amber-400' };
  return { barra: 'bg-red-500', texto: 'text-red-400' };
};

/** 2.3 fica 2,3; 34 fica 34 — sem casa decimal inventada. */
/** 2026-09-15 -> 15/09/2026, pra dizer qual noite a nota mede. */
const formatarNoite = (iso: string) => {
  const [ano, mes, dia] = iso.split("-");
  return `${dia}/${mes}/${ano}`;
};

const formatarValor = (valor: number) =>
  Number.isInteger(valor) ? String(valor) : valor.toFixed(1).replace('.', ',');

const directionLabel = (direction: 'higher' | 'lower') =>
  direction === 'higher' ? 'quanto maior, melhor' : 'quanto menor, melhor';
---

<section class="mb-10">
  <div class="mb-4">
    <h2 class="text-xl font-bold text-white">
      Performance geral
    </h2>

    <p class="text-sm text-slate-400 mt-1">
      {nightDate ? `Noite de ${formatarNoite(nightDate)}` : 'Última noite de raid'}
      {nightTries !== null && ` · ${nightTries} ${nightTries === 1 ? 'try' : 'trys'}`} —
      a raid inteira, todas as trys, não só os kills, comparada às metas do core.
      É a foto de agora, não a média da temporada: a evolução está no gráfico
      abaixo. Dimensão sem dado tem o peso redistribuído entre as demais, em vez
      de pesar contra o jogador.
    </p>
  </div>

  <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-5">
    <div class="flex items-center justify-between gap-4 mb-5">
      <span class="text-sm font-semibold text-slate-300">
        Score geral
      </span>

      {
        score.overall !== null ? (
          <span class={`text-3xl font-bold ${scoreTextColor(score.overall)}`}>
            {score.overall}
            <span class="text-base text-slate-500">/100</span>
          </span>
        ) : (
          <span class="text-sm text-slate-500">
            Dados insuficientes
          </span>
        )
      }
    </div>

    <div class="space-y-3">
      {
        score.dimensions.map((dimension) => (
          <div>
            <div class="flex justify-between text-xs mb-1">
              <span class="text-slate-400 flex items-center gap-1.5">
                {dimension.label}
                <span class="text-slate-600">({dimension.weight}%)</span>

                <span class="relative group inline-flex">
                  <button
                    type="button"
                    class="w-3.5 h-3.5 rounded-full border border-slate-600 text-slate-500 text-[9px] leading-none flex items-center justify-center hover:border-[#f0a500] hover:text-[#f0a500] transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-[#f0a500]"
                    aria-label={`O que é ${dimension.label}`}
                  >
                    i
                  </button>

                  <span
                    role="tooltip"
                    class="pointer-events-none absolute left-1/2 -translate-x-1/2 bottom-full mb-2 z-20 w-64 rounded-lg border border-white/10 bg-[#141b2d] p-3 text-left opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-opacity shadow-xl"
                  >
                    <span class="block text-slate-200 text-[11px] leading-relaxed">
                      {dimension.description}
                    </span>
                    <span class="block text-slate-400 text-[11px] leading-relaxed mt-2">
                      <span class="text-slate-500 font-semibold">Fonte:</span> {dimension.source}
                    </span>
                    <span class="block text-slate-400 text-[11px] leading-relaxed mt-2">
                      <span class="text-slate-500 font-semibold">Meta do core:</span>{' '}
                      {dimension.target.target} ({directionLabel(dimension.target.direction)})
                    </span>
                  </span>
                </span>
              </span>

              {/* Valor real e meta lado a lado, como no card de Objetivos: "87"
                  sozinho parecia um valor, mas é percentual de caminho andado —
                  e ninguém reconhecia a própria métrica nele. */}
              <span class="flex items-baseline gap-2">
                {dimension.value !== null ? (
                  <>
                    <span class={`font-semibold ${corDaDimensao(dimension).texto}`}>
                      {formatarValor(dimension.value)}
                    </span>
                    <span class="text-slate-600">meta {formatarValor(dimension.target.target)}</span>
                    {dimension.score !== null && <span class="text-slate-600">&middot; {dimension.score}%</span>}
                  </>
                ) : (
                  <span class="text-slate-600">sem dado</span>
                )}
              </span>
            </div>

            <div class="h-1.5 bg-slate-800 rounded-full overflow-hidden">
              {dimension.score !== null && (
                <div
                  class={`h-full rounded-full ${corDaDimensao(dimension).barra}`}
                  style={`width: ${dimension.score}%`}
                />
              )}
            </div>

            {/* A nota sozinha não diz o que fazer. Só aparece quando há o que
                arrumar — quem está com tudo pronto não vê lista vazia. */}
            {dimension.key === 'preparation' && preparationMissing.length > 0 && (
              <p class="mt-1.5 text-[11px] text-slate-500 leading-relaxed">
                <span class="text-slate-400">Falta arrumar:</span>{' '}
                {preparationMissing.join(', ')}
              </p>
            )}

            {/* Mesma ideia da Preparação: o número diz quanto, a lista diz
                onde treinar. Soma da temporada, igual ao número da dimensão. */}
            {dimension.key === 'mechanics' && mechanicsDetail.length > 0 && (
              <ul class="mt-1.5 space-y-0.5">
                {mechanicsDetail.map((item) => (
                  <li class="text-[11px] text-slate-500 leading-relaxed">
                    {/* O rótulo vem do log, no idioma de quem gravou: quem raida
                        em português conhece "Peçonha Sanguínea", não "Blood
                        Venom", e não reconhecia a própria mecânica. */}
                    <span class="text-slate-400">{item.label ?? item.mechanic.replace('Damage from ', '')}</span>
                    {' '}&times;{item.tries}
                    <span class="text-slate-600"> &middot; {item.boss}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4 mt-4">
    <article class="bg-slate-900/60 border border-slate-800 rounded-xl p-4">
      <p class="text-xs uppercase tracking-wide text-slate-500">
        Tendência
      </p>

      <strong class={`block text-2xl font-bold mt-1 ${trendColor}`}>
        {trend !== null ? `${trend > 0 ? '+' : ''}${trend}%` : '-'}
      </strong>

      <p class="text-[11px] text-slate-500 mt-1">
        Evolução do seu dps/hps ao longo das runs
      </p>
    </article>

    <article class="bg-slate-900/60 border border-slate-800 rounded-xl p-4">
      <p class="text-xs uppercase tracking-wide text-slate-500">
        Presença
      </p>

      <strong class="block text-2xl font-bold text-white mt-1">
        {attendance}%
      </strong>

      <p class="text-[11px] text-slate-500 mt-1">
        Runs em que você aparece no log
      </p>
    </article>
  </div>
</section>
