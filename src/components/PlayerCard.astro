---
/**
 * PlayerCard.astro — Card de jogador para a seção Membros
 * Estilo Raider.IO + Warcraft Logs: parse colorido por tier, IO com faixa de cor.
 */

import type { Player, WowClass } from '@/types/index';
import { getClassColor } from '@/utils/roster';
import { formatValue } from '@/utils/format';
import { safeUrl } from '@/utils/progression';

interface Props {
  player: Player;
}

const { player } = Astro.props;

function capitalize(s: string): string {
  return s.split('-').map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
}

// Fix errors-in-console: extract real hex value instead of using currentColor inline
const CLASS_HEX: Record<WowClass, string> = {
  'death-knight': '#c41e3a',
  'demon-hunter': '#a330c9',
  'druid':        '#ff7c0a',
  'evoker':       '#3aab8f',
  'hunter':       '#aad372',
  'mage':         '#3fc7eb',
  'monk':         '#00e87f',
  'paladin':      '#f48cba',
  'priest':       '#e2e8f0',
  'rogue':        '#fff468',
  'shaman':       '#3b9eff',
  'warlock':      '#9d9fec',
  'warrior':      '#c69b3a',
};
const classHex = CLASS_HEX[player.class] ?? '#94a3b8';

const raceName = capitalize(player.race);
const className = capitalize(player.class);
const classColor = getClassColor(player.class);

const roleBadge = {
  tank:   { label: 'Tank',   cls: 'bg-blue-500/15 border-blue-500/30 text-blue-300' },
  healer: { label: 'Healer', cls: 'bg-emerald-500/15 border-emerald-500/30 text-emerald-300' },
  dps:    { label: 'DPS',    cls: 'bg-rose-500/15 border-rose-500/30 text-rose-300' },
};
const role = roleBadge[player.role];

// IO tier colors — Raider.IO style
function ioColor(io: number | null): string {
  if (io === null) return 'text-slate-400';
  if (io >= 4000)  return 'text-[#f0a500]';
  if (io >= 3500)  return 'text-[#c084fc]';
  if (io >= 3000)  return 'text-[#60a5fa]';
  if (io >= 2500)  return 'text-[#22c55e]';
  return 'text-slate-300';
}

// Parse tier colors — WCL style
function parseColor(parse: number | null): string {
  if (parse === null) return 'text-slate-400';
  if (parse === 100)  return 'text-[#f0a500]';
  if (parse >= 95)    return 'text-[#f97316]';
  if (parse >= 75)    return 'text-[#c084fc]';
  if (parse >= 50)    return 'text-[#60a5fa]';
  if (parse >= 25)    return 'text-[#22c55e]';
  return 'text-slate-300';
}

const io         = player.raiderIo.io;
const highestKey = player.raiderIo.highestKey;
const bestDungeon = formatValue(player.raiderIo.bestDungeon);

const avgParse   = player.warcraftLogs.avgParse;
const bestParse  = player.warcraftLogs.bestParse;
const attendance = player.warcraftLogs.attendance;

const discord  = formatValue(player.discord);
const initials = player.name.slice(0, 2).toUpperCase();
const isMain   = player.type === 'main';

const linkRaiderIo = safeUrl(player.externalLinks.raiderIo);
const linkRaidbots = safeUrl(player.externalLinks.raidbots);
const linkArchon   = safeUrl(player.externalLinks.archon);
const linkWcl      = safeUrl(player.externalLinks.warcraftLogs);
const linkWipefest = safeUrl(player.externalLinks.wipefest);
---

<article
  class="bg-[#141b2d] border border-white/7 rounded-xl overflow-hidden hover:border-white/14 transition-all duration-200 flex flex-col"
  aria-label={`Card do jogador ${player.name}`}
>
  <!-- Header strip with class color accent -->
  <div class="relative h-16 bg-gradient-to-r from-[#0a0d14] to-[#1a2235] overflow-hidden">

    <!-- Fix errors-in-console: use real hex, not currentColor -->
    <div
      class="absolute inset-y-0 left-0 w-1"
      style={`background-color: ${classHex};`}
      aria-hidden="true"
    />

    <!-- Avatar bleed (decorative, aria-hidden) -->
    {player.avatar !== null && (
      <img
        src={player.avatar}
        alt=""
        width="64"
        height="64"
        loading="lazy"
        aria-hidden="true"
        class="absolute right-0 top-0 h-full w-auto object-cover opacity-25 object-top pointer-events-none"
      />
    )}

    <!-- Player info overlay -->
    <div class="absolute inset-0 pl-5 pr-3 flex items-center gap-3">
      <!-- Avatar thumb -->
      <div class="shrink-0 z-10">
        {player.avatar !== null ? (
          <img
            src={player.avatar}
            alt={`Avatar de ${player.name}`}
            width="40"
            height="40"
            loading="lazy"
            class="rounded-lg object-cover w-10 h-10 border border-white/10"
          />
        ) : (
          <div
            class="w-10 h-10 rounded-lg bg-[#1a2235] border border-white/10 flex items-center justify-center text-slate-300 text-sm font-bold select-none"
            aria-hidden="true"
          >
            {initials}
          </div>
        )}
      </div>

      <!-- Name + identity -->
      <div class="flex-1 min-w-0 z-10">
        <div class="flex items-center gap-2 mb-0.5">
          <h3 class={`font-bold text-sm leading-tight truncate ${classColor}`}>
            {player.name}
          </h3>
          <!-- Fix label-content-name-mismatch: no aria-label on decorative badge -->
          <span class={`shrink-0 inline-flex items-center px-1.5 py-px rounded text-[9px] font-bold border ${
            isMain
              ? 'bg-[#f0a500]/10 border-[#f0a500]/30 text-[#f0a500]'
              : 'bg-white/5 border-white/10 text-slate-400'
          }`} aria-hidden="true">
            {isMain ? 'MAIN' : 'ALT'}
          </span>
        </div>
        <!-- Fix color-contrast: use slate-400 (6.1:1 on #0a0d14) instead of slate-500 (4.4:1) -->
        <p class="text-slate-400 text-[10px] ">
          {raceName} · {className} · {player.spec}
        </p>
      </div>

      <!-- Role badge -->
      <span class={`shrink-0 z-10 inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold border ${role.cls}`}>
        {role.label}
      </span>
    </div>
  </div>

  <!-- Hero Spec badge -->
  {player.heroSpec !== null && (
    <div class="px-4 pt-2">
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-purple-500/10 border border-purple-500/20 text-purple-200 text-[10px] font-semibold">
        ✦ {player.heroSpec}
      </span>
    </div>
  )}

  <!-- Stats body -->
  <div class="flex-1 px-4 py-3 space-y-3">

    <!-- Raider.IO -->
    <section aria-label={`Raider.IO de ${player.name}`}>
      <!-- Fix color-contrast: slate-400 instead of slate-500 for labels -->
      <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-2">Raider.IO</p>
      <div class="flex items-end justify-between gap-2 mb-1.5">
        <div>
          <p class="text-[9px] text-slate-400 uppercase tracking-wider mb-0.5">IO Score</p>
          <p class={`text-xl font-bold tabular-nums leading-none ${ioColor(io)}`}>
            {io !== null ? io.toLocaleString() : '—'}
          </p>
        </div>
        <div class="text-right">
          <p class="text-[9px] text-slate-400 uppercase tracking-wider mb-0.5">Maior Key</p>
          <p class="text-sm font-bold text-slate-200">
            {highestKey !== null ? `+${highestKey}` : '—'}
          </p>
        </div>
      </div>
      {bestDungeon !== '—' && (
        <p class="text-[10px] text-slate-400 truncate">
          Melhor:
          <span class="text-slate-300 ml-1">{bestDungeon}</span>
        </p>
      )}
    </section>

    <!-- Warcraft Logs -->
    <section aria-label={`Warcraft Logs de ${player.name}`}>
      <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-2">Warcraft Logs</p>
      <div class="grid grid-cols-3 gap-2">
        <div>
          <p class="text-[9px] text-slate-400 uppercase tracking-wider mb-0.5">Avg</p>
          <p class={`text-sm font-bold tabular-nums ${parseColor(avgParse)}`}>
            {avgParse !== null ? `${avgParse}%` : '—'}
          </p>
        </div>
        <div>
          <p class="text-[9px] text-slate-400 uppercase tracking-wider mb-0.5">Best</p>
          <p class={`text-sm font-bold tabular-nums ${parseColor(bestParse)}`}>
            {bestParse !== null ? `${bestParse}%` : '—'}
          </p>
        </div>
        <div>
          <p class="text-[9px] text-slate-400 uppercase tracking-wider mb-0.5">Pres.</p>
          <p class="text-sm font-bold text-slate-200 tabular-nums">
            {attendance !== null ? `${attendance}%` : '—'}
          </p>
        </div>
      </div>
    </section>

  </div>

  <!-- Quick links footer -->
  {(linkRaiderIo || linkRaidbots || linkArchon || linkWcl || linkWipefest) && (
    <div class="px-4 pb-3 pt-2 border-t border-white/5">
      <!-- Fix label-content-name-mismatch: aria-label matches visible text content -->
      <div class="flex flex-wrap gap-1.5">

        {linkRaiderIo && (
          <a
            href={linkRaiderIo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-2 py-1 rounded bg-white/5 border border-white/7 text-slate-300 text-[10px] font-medium hover:border-[#f0a500]/40 hover:text-[#f0a500] transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-[#f0a500]"
          >
            Raider.IO <span class="sr-only">(nova aba)</span>
          </a>
        )}

        {linkWcl && (
          <a
            href={linkWcl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-2 py-1 rounded bg-white/5 border border-white/7 text-slate-300 text-[10px] font-medium hover:border-rose-400/40 hover:text-rose-300 transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-[#f0a500]"
          >
            WCL <span class="sr-only">(nova aba)</span>
          </a>
        )}

        {linkRaidbots && (
          <a
            href={linkRaidbots}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-2 py-1 rounded bg-white/5 border border-white/7 text-slate-300 text-[10px] font-medium hover:border-slate-400/40 hover:text-slate-200 transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-[#f0a500]"
          >
            Raidbots <span class="sr-only">(nova aba)</span>
          </a>
        )}

        {linkArchon && (
          <a
            href={linkArchon}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-2 py-1 rounded bg-white/5 border border-white/7 text-slate-300 text-[10px] font-medium hover:border-slate-400/40 hover:text-slate-200 transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-[#f0a500]"
          >
            Archon <span class="sr-only">(nova aba)</span>
          </a>
        )}

        {linkWipefest && (
          <a
            href={linkWipefest}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-2 py-1 rounded bg-white/5 border border-white/7 text-slate-300 text-[10px] font-medium hover:border-slate-400/40 hover:text-slate-200 transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-[#f0a500]"
          >
            Wipefest <span class="sr-only">(nova aba)</span>
          </a>
        )}

      </div>
    </div>
  )}
</article>
