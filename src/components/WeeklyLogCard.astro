---
/**
 * WeeklyLogCard.astro — Card de log semanal de raid
 * Exibe data, duração, bosses mortos, destaques com cor de classe
 * e links condicionais para Warcraft Logs e Wipefest.
 */

import type { WeeklyLog } from '@/types/index';
import { safeUrl } from '@/utils/progression';
import { formatDate } from '@/utils/format';
import { getClassColor } from '@/utils/roster';

interface Props {
  log: WeeklyLog;
}

const { log } = Astro.props;

// Duration formatting
const hours = Math.floor(log.durationMinutes / 60);
const mins = log.durationMinutes % 60;
const durationFormatted = `${hours}h ${String(mins).padStart(2, '0')}m`;

// Date formatting
const dateFormatted = formatDate(log.date);

// Conditional links
const warcraftLogsUrl = safeUrl(log.links.warcraftLogs);
const wipefestUrl = safeUrl(log.links.wipefest);

// Highlights array for grid rendering
const highlightItems = [
  { label: 'Melhor DPS',        highlight: log.highlights.bestDps },
  { label: 'Melhor HPS',        highlight: log.highlights.bestHps },
  { label: 'Melhor Tank',       highlight: log.highlights.bestTank },
  { label: 'Jogador da Semana', highlight: log.highlights.playerOfTheWeek },
];
---

<article
  class="bg-[#1a2030] border border-slate-700/50 rounded-xl hover:border-slate-600/70 transition-colors"
  aria-label={`Log da Semana ${log.weekNumber}`}
>
  <!-- Card header -->
  <header class="px-5 py-4 border-b border-slate-700/50">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">

      <!-- Week title + date -->
      <div>
        <h2 class="text-[#f0a500] font-bold text-lg leading-tight">
          Semana {log.weekNumber}
        </h2>
        <time
          datetime={log.date}
          class="text-slate-400 text-sm mt-0.5 block"
        >
          {dateFormatted}
        </time>
      </div>

      <!-- Stats badges -->
      <div class="flex flex-wrap items-center gap-2">

        <!-- Duration -->
        <span
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-800 border border-slate-700/50 text-slate-300 text-sm font-medium"
          aria-label={`Duração: ${durationFormatted}`}
        >
          ⏱ {durationFormatted}
        </span>

        <!-- Bosses killed -->
        <span
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#00c48c]/10 border border-[#00c48c]/30 text-[#00c48c] text-sm font-semibold"
          aria-label={`${log.bossesKilled} bosses mortos`}
        >
          ⚔ {log.bossesKilled} boss{log.bossesKilled !== 1 ? 'es' : ''}
        </span>

      </div>
    </div>
  </header>

  <!-- Highlights grid -->
  <section
    aria-label={`Destaques da Semana ${log.weekNumber}`}
    class="px-5 py-4"
  >
    <p class="text-slate-400 text-xs font-semibold uppercase tracking-widest mb-3">
      Destaques
    </p>

    <dl class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      {highlightItems.map(({ label, highlight }) => (
        <div class="flex flex-col gap-1">
          <dt class="text-slate-400 text-xs font-semibold uppercase tracking-widest">
            {label}
          </dt>
          {highlight ? (
            <dd>
              <span
                class={`text-sm font-semibold block ${getClassColor(highlight.class)}`}
                aria-label={`${highlight.playerName} (${highlight.class})`}
              >
                {highlight.playerName}
              </span>
              <span class="text-slate-400 text-xs block mt-0.5">
                {highlight.value}
              </span>
            </dd>
          ) : (
            <dd class="text-slate-400 text-sm">—</dd>
          )}
        </div>
      ))}
    </dl>
  </section>

  <!-- External links (conditional) -->
  {(warcraftLogsUrl || wipefestUrl) && (
    <footer
      class="px-5 pb-4 pt-2 border-t border-slate-700/50"
      aria-label={`Links externos — Semana ${log.weekNumber}`}
    >
      <div class="flex flex-wrap gap-2" role="list">

        {warcraftLogsUrl && (
          <a
            href={warcraftLogsUrl}
            target="_blank"
            rel="noopener noreferrer"
            role="listitem"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 border border-slate-700/50 text-slate-300 text-xs font-medium hover:border-[#f0a500]/50 hover:text-[#f0a500] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f0a500]"
            aria-label={`Warcraft Logs — Semana ${log.weekNumber} (abre em nova aba)`}
          >
            📊 Warcraft Logs
          </a>
        )}

        {wipefestUrl && (
          <a
            href={wipefestUrl}
            target="_blank"
            rel="noopener noreferrer"
            role="listitem"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 border border-slate-700/50 text-slate-300 text-xs font-medium hover:border-[#f0a500]/50 hover:text-[#f0a500] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f0a500]"
            aria-label={`Wipefest — Semana ${log.weekNumber} (abre em nova aba)`}
          >
            🔍 Wipefest
          </a>
        )}

      </div>
    </footer>
  )}
</article>
