
---
import type { PlayerPerformanceGoals } from '@/types/goals';
import PerformanceGoalCard from '@/components/PerformanceGoalCard.astro';

interface Props {
  goals: PlayerPerformanceGoals;
  current: {
    dps?: number;
    hps?: number;
    parse?: number;
    mechanics?: {
      errors: number;
    };
    deaths?: number;
  };
}

const { goals, current } = Astro.props;
---

<section class="mb-10">
  <div class="mb-4">
    <h2 class="text-xl font-bold text-white">
      Objetivos de performance
    </h2>

    <p class="text-sm text-slate-400 mt-1">
      Metas individuais para evolução durante as sessões do core.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

    {
      goals.dps &&
      current.dps !== undefined && (
        <PerformanceGoalCard
          label="DPS"
          goal={goals.dps}
          actual={current.dps}
          format="performance"
        />
      )
    }

    {
      goals.hps &&
      current.hps !== undefined && (
        <PerformanceGoalCard
          label="HPS"
          goal={goals.hps}
          actual={current.hps}
          format="performance"
        />
      )
    }

    {
      goals.parse &&
      current.parse !== undefined && (
        <PerformanceGoalCard
          label="Parse"
          goal={goals.parse}
          actual={current.parse}
        />
      )
    }

    {
      goals.mechanics &&
      current.mechanics !== undefined && (
        <PerformanceGoalCard
          label="Erros mecânicos"
          goal={goals.mechanics}
          actual={current.mechanics.errors}
        />
      )
    }

    {
      goals.deaths &&
      current.deaths !== undefined && (
        <PerformanceGoalCard
          label="Mortes"
          goal={goals.deaths}
          actual={current.deaths}
        />
      )
    }

  </div>
</section>
