
---
import type { PlayerPerformanceGoals } from '@/types/goals';
import PerformanceGoalCard from '@/components/PerformanceGoalCard.astro';

interface Props {
  /**
   * Metas individuais do roster. Opcional de propósito: cinco jogadores não
   * têm nenhuma cadastrada, e as metas do CORE (erros, atacar, defender,
   * curar) não dependem disso — elas vinham da temporada o tempo todo.
   * Enquanto a seção exigia `goals`, esses cinco não viam objetivo nenhum.
   */
  goals?: PlayerPerformanceGoals;
  /**
   * Meta de erros mecânicos do core — igual pra todo mundo, diferente das
   * metas individuais (a de dps vem do Raidbots, por jogador). Por isso vem
   * à parte, e não dentro de `goals`.
   */
  coreMechanicsTarget?: number | null;
  /** Meta de execução ofensiva do core. Mesma lógica de coreMechanicsTarget. */
  coreAttackTarget?: number | null;
  /** Meta de execução defensiva do core. */
  coreDefenseTarget?: number | null;
  /** Meta de cura do core. Só rende caixa pra quem curou na noite. */
  coreHealingTarget?: number | null;
  current: {
    dps?: number;
    hps?: number;
    parse?: number;
    mechanics?: {
      errors: number;
    };
    attack?: { score: number };
    healing?: { score: number };
    /** score é null quando nenhum cooldown defensivo foi medido. */
    defense?: { score: number | null };
    deaths?: number;
  };
}

const {
  goals = {},
  current,
  coreMechanicsTarget = null,
  coreAttackTarget = null,
  coreDefenseTarget = null,
  coreHealingTarget = null,
} = Astro.props;

// Parse e mortes seguem escondidos: parse só existe pra boss morto e mortes
// saíram do score. Erros mecânicos voltou quando a coleta do Wipefest passou
// a rodar. Basta tirar do set pra voltarem a aparecer.
const HIDDEN_GOALS = new Set(['parse', 'deaths']);

const cards = [
  goals.dps && current.dps !== undefined
    ? { key: 'dps', label: 'DPS', goal: goals.dps, actual: current.dps, format: 'performance' as const }
    : null,
  goals.hps && current.hps !== undefined
    ? { key: 'hps', label: 'HPS', goal: goals.hps, actual: current.hps, format: 'performance' as const }
    : null,
  goals.parse && current.parse !== undefined
    ? { key: 'parse', label: 'Parse', goal: goals.parse, actual: current.parse, format: 'number' as const }
    : null,
  coreMechanicsTarget !== null && current.mechanics !== undefined
    ? {
        key: 'mechanics',
        label: 'Erros mecânicos',
        goal: {
          metric: 'mechanics' as const,
          target: coreMechanicsTarget,
          direction: 'lower' as const,
          description: 'Máximo de erros por try, na média da última noite',
          source: 'Wipefest (meta do core)',
        },
        actual: current.mechanics.errors,
        format: 'number' as const,
      }
    : null,
  coreAttackTarget !== null && current.attack !== undefined
    ? {
        key: 'attack',
        label: 'Atacar',
        goal: {
          metric: 'attack' as const,
          target: coreAttackTarget,
          direction: 'higher' as const,
          description: 'Uptime e cooldowns ofensivos, na média da última noite',
          source: 'Warcraft Logs + Wowhead (meta do core)',
        },
        actual: current.attack.score,
        format: 'number' as const,
      }
    : null,
  // Nota nula = nenhum cooldown defensivo medido. Sem caixa, em vez de uma
  // barra zerada que pareceria "você não se defendeu".
  coreDefenseTarget !== null && current.defense?.score != null
    ? {
        key: 'defense',
        label: 'Defender',
        goal: {
          metric: 'defense' as const,
          target: coreDefenseTarget,
          direction: 'higher' as const,
          description: 'Tempo em recarga dos cooldowns defensivos, na última noite',
          source: 'Warcraft Logs + Wowhead (meta do core)',
        },
        actual: current.defense.score,
        format: 'number' as const,
      }
    : null,
  coreHealingTarget !== null && current.healing !== undefined
    ? {
        key: 'healing',
        label: 'Curar',
        goal: {
          metric: 'healing' as const,
          target: coreHealingTarget,
          direction: 'higher' as const,
          description: 'Quinhão do dano coberto e aproveitamento da cura, na última noite',
          source: 'Warcraft Logs (meta do core)',
        },
        actual: current.healing.score,
        format: 'number' as const,
      }
    : null,
  goals.deaths && current.deaths !== undefined
    ? { key: 'deaths', label: 'Mortes', goal: goals.deaths, actual: current.deaths, format: 'number' as const }
    : null,
].filter((card) => card !== null && !HIDDEN_GOALS.has(card.key));
---

<section class="mb-10" hidden={cards.length === 0}>
  <div class="mb-4">
    <h2 class="text-xl font-bold text-white">
      Objetivos de performance
    </h2>

    <p class="text-sm text-slate-400 mt-1">
      Metas individuais para evolução durante as sessões do core.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {
      cards.map((card) => (
        <PerformanceGoalCard
          label={card!.label}
          goal={card!.goal}
          actual={card!.actual}
          format={card!.format}
        />
      ))
    }
  </div>
</section>
