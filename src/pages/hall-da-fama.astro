---
/**
 * hall-da-fama.astro — Hall da Fama (doc "4.3 Hall da Fama")
 * Reconhecimentos calculados a partir de dado real, ver
 * engine/guild/hallOfFame.ts pro que ficou de fora e por quê.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Boss, Player, SiteConfig } from '@/types/index';
import { buildHallOfFame } from '@/engine/guild/hallOfFame';

import seasonJson from '../../data/seasons/midnight-s2/config.json';
import rosterJson from '../../data/guild/roster.json';
import { performanceWeeks } from '../../data/weekly/performance/index';

const config = seasonJson.config as SiteConfig;
const bossesNormal = seasonJson.bossesNormal as Boss[];
const bossesHeroic = seasonJson.bossesHeroic as Boss[];
const players = rosterJson as Player[];

const goalsByPlayerId = Object.fromEntries(
  players.map((player) => [player.id, player.performanceGoals])
);

const hallOfFame = buildHallOfFame(
  config.currentSeason,
  performanceWeeks,
  bossesNormal,
  bossesHeroic,
  players,
  goalsByPlayerId
);

const ICON: Record<string, string> = {
  bestParse: '📊',
  fewestDeaths: '💀',
  bestAttendance: '📅',
  bestEvolution: '📈',
  mvp: '🏆',
};
---

<BaseLayout
  title="Hall da Fama"
  description={`Reconhecimentos da ${config.currentSeason} — quem se destacou no core.`}
>
  <section class="bg-[#0a0d14] border-b border-white/5">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 text-center">
      <p class="text-slate-400 text-xs font-semibold uppercase tracking-widest mb-2">
        {config.currentSeason}
      </p>
      <h1 class="text-3xl sm:text-4xl font-bold text-[#f0a500] tracking-tight">
        Hall da Fama
      </h1>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {hallOfFame.entries.map((entry) => (
        <article class="bg-[#141b2d] border border-white/7 rounded-xl p-6">
          <p class="text-slate-400 text-xs font-bold uppercase tracking-widest mb-3">
            {ICON[entry.key]} {entry.label}
          </p>

          {entry.winner ? (
            <>
              <a
                href={`/core/membros/${entry.winner.playerId}/`}
                class="block text-2xl font-bold text-white hover:text-[#f0a500] transition-colors"
              >
                {entry.winner.playerName}
              </a>
              <p class="text-[#f0a500] text-sm font-semibold mt-1">{entry.winner.value}</p>
            </>
          ) : (
            <p class="text-slate-500 text-sm">Ainda sem dados suficientes nesta temporada.</p>
          )}
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
