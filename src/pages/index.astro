---
/**
 * index.astro — Página inicial do Core Hub
 * Exibe HeroSection com barras de progressão Normal/Heroica e SummaryCards navegáveis.
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/HeroSection.astro';
import SummaryCard from '@/components/SummaryCard.astro';
import CorePerformanceChart from '@/components/CorePerformanceChart.astro';
import type { SiteConfig, Boss, Player, Loot } from '@/types/index';
import { computeProgression } from '@/utils/progression';
import { computeMythicStats } from '@/utils/roster';
import { formatDate, formatValue } from '@/utils/format';

import seasonJson from '../../data/seasons/midnight-s2.json';
import rosterJson from '../../data/roster.json';
import lootJson from '../../data/loot.json';

const config = seasonJson.config as SiteConfig;
const bossesNormal = seasonJson.bossesNormal as Boss[];
const bossesHeroic = seasonJson.bossesHeroic as Boss[];
const recentLogs = seasonJson.recentLogs ?? [];
const players = rosterJson as Player[];
const lootData = lootJson as Loot[];
const performanceWeeks = getPerformanceWeeks();

import {
  getCorePerformanceSeries,
  getPerformanceWeeks,
} from '@/utils/performance';

const dpsSeries = getCorePerformanceSeries(
  performanceWeeks,
  players,
  'dps'
).map((series) => {
  const player = players.find(
    (item) => item.id === series.playerId
  );

  return {
    ...series,
    playerName: player?.name ?? series.playerId,
    playerClass: player?.class,
    playerSlug: player?.name
        ? encodeURIComponent(player.name.toLowerCase())
        : undefined
  };
});

const parseSeries = getCorePerformanceSeries(
  performanceWeeks,
  players,
  'parse'
).map((series) => {
  const player = players.find(
    (item) => item.id === series.playerId
  );

  return {
    ...series,
    playerName: player?.name ?? series.playerId,
    playerClass: player?.class,
    playerSlug: player?.name
        ? encodeURIComponent(player.name.toLowerCase())
        : undefined
  };
});

const deathsSeries = getCorePerformanceSeries(
  performanceWeeks,
  players,
  'deaths'
).map((series) => {
  const player = players.find(
    (item) => item.id === series.playerId
  );

  return {
    ...series,
    playerName: player?.name ?? series.playerId,
    playerClass: player?.class,
    playerSlug: player?.name
        ? encodeURIComponent(player.name.toLowerCase())
        : undefined
  };
});

const mechanicsSeries = getCorePerformanceSeries(
  performanceWeeks,
  players,
  'mechanics'
).map((series) => {
  const player = players.find(
    (item) => item.id === series.playerId
  );

  return {
    ...series,
    playerName: player?.name ?? series.playerId,
    playerClass: player?.class,
    playerSlug: player?.name
        ? encodeURIComponent(player.name.toLowerCase())
        : undefined
  };
});

// Base path
const base = '/hail-to-the-king-core-hub';

// 1 — Progressão Normal
const progressionNormal = computeProgression(bossesNormal);
const progressionNormalValue = progressionNormal.total > 0 ? `${progressionNormal.killed}/${progressionNormal.total} N` : null;
const progressionNormalSubtitle = progressionNormal.total > 0 ? `${progressionNormal.percent}% Normal concluído` : undefined;

// 2 — Progressão Heroica
const progressionHeroic = computeProgression(bossesHeroic);
const progressionHeroicValue = progressionHeroic.total > 0 ? `${progressionHeroic.killed}/${progressionHeroic.total} H` : null;
const progressionHeroicSubtitle = progressionHeroic.total > 0 ? `${progressionHeroic.percent}% Heróico concluído` : undefined;


// 3 — Média Raider.IO + Melhor Key da Semana
const mythicStats = computeMythicStats(players);
const avgIoValue = mythicStats.avgIo > 0 ? mythicStats.avgIo : null;
const bestKey = config.weeklyHighlights.bestKey;
const avgIoSubtitle = bestKey
  ? `Média do grupo · Melhor key: ${bestKey.dungeon} +${bestKey.level}`
  : 'Média do grupo';

// 4 — Participação na Raid
const playersWithAttendance = players.filter((p) => p.warcraftLogs.attendance !== null);
const avgAttendance =
  playersWithAttendance.length > 0
    ? Math.round(
        playersWithAttendance.reduce((sum, p) => sum + (p.warcraftLogs.attendance as number), 0) /
          playersWithAttendance.length
      )
    : null;
const attendanceValue = avgAttendance !== null ? `${avgAttendance}%` : null;

// 5 — Loots Distribuídos
const lootCount = lootData.length;

// 6 — Próxima Raid
const nextRaid = config.nextRaid;
const nextRaidValue = nextRaid ? formatDate(nextRaid.date) : null;
const nextRaidSubtitle = nextRaid ? `${nextRaid.time} — ${nextRaid.objective}` : undefined;
---

<BaseLayout
  title="Home"
  description="Página inicial do Core Nemesis — progressão, membros e destaques da semana."
>

  <HeroSection config={config} bossesNormal={bossesNormal} bossesHeroic={bossesHeroic} recentLogs={recentLogs} />

  <section
    aria-label="Resumo da temporada"
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14"
  >
    <!-- Section header -->
    <div class="flex items-center gap-3 mb-6">
      <div class="h-px flex-1 bg-white/5" aria-hidden="true" />
      <h2 class="text-slate-400 text-xs font-semibold uppercase tracking-widest px-2">
        Destaques da Semana
      </h2>
      <div class="h-px flex-1 bg-white/5" aria-hidden="true" />
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">

      <SummaryCard
        title="Regras"
        value="Confira"
        subtitle="Regras e diretrizes do core"
        icon="📋"
        href={`${base}/regras/`}
        accent="red"
      />

      <SummaryCard
        title="Progressão"
        value={progressionNormalValue}
        altValue={progressionHeroicValue}
        subtitle={progressionNormalSubtitle}
        altsubtitle={progressionHeroicSubtitle}
        icon="⚔"
        href={`${base}/progressao/`}
        accent="green"
        altAccent="purple"
      />

      <SummaryCard
        title="Média Raider.IO"
        value={avgIoValue}
        subtitle={avgIoSubtitle}
        icon="🗝"
        href={`${base}/mythic/`}
        accent="blue"
      />

      <SummaryCard
          title="Membros"
          value={players.filter((p) => p.type === 'main').length}
          subtitle={`${players.length} total com alts`}
          icon="👥"
          href={`${base}/membros/`}
          accent="default"
        />

      <!--SummaryCard
        title="Participação na Raid"
        value={attendanceValue}
        subtitle="Presença média"
        icon="📅"
        href={`${base}/logs/`}
        accent="green"
      /-->

      <!--SummaryCard
        title="Loots Distribuídos"
        value={lootCount}
        subtitle="na temporada"
        icon="💎"
        href={`${base}/loots/`}
        accent="gold"
      /-->

      <!--SummaryCard
        title="Próxima Raid"
        value={nextRaidValue}
        subtitle={nextRaidSubtitle}
        icon="📆"
        href={`${base}/planejamento/`}
        accent="green"
      /-->

    </div>

    <!-- Section header -->
    <div class="flex items-center gap-3 px-4 sm:px-6 lg:px-8 py-10">
      <div class="h-px flex-1 bg-white/5" aria-hidden="true" />
      <h2 class="text-slate-400 text-xs font-semibold uppercase tracking-widest px-2">
        Performance do core
      </h2>
      <div class="h-px flex-1 bg-white/5" aria-hidden="true" />
    </div>

    <CorePerformanceChart
      metrics={[
        {
          id: 'dps',
          label: 'DPS',
          direction: 'higher',
          series: dpsSeries,
        },
        {
          id: 'parse',
          label: 'Parse',
          direction: 'higher',
          series: parseSeries,
        },
        {
          id: 'deaths',
          label: 'Mortes',
          direction: 'lower',
          series: deathsSeries,
        },
        {
          id: 'mechanics',
          label: 'Mecânicas',
          direction: 'lower',
          series: mechanicsSeries,
        },
      ]}
    />
  </section>

  <!-- Quick links section -->
  <!-- section
    aria-label="Navegação rápida"
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-14"
  >
    <div class="flex items-center gap-3 mb-6">
      <div class="h-px flex-1 bg-white/5" aria-hidden="true" />
      <h2 class="text-slate-400 text-xs font-semibold uppercase tracking-widest px-2">
        Acesso Rápido
      </h2>
      <div class="h-px flex-1 bg-white/5" aria-hidden="true" />
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      {[
        { label: 'Progressão', icon: '⚔', href: `${base}/progressao/` },
        { label: 'Membros',    icon: '👥', href: `${base}/membros/` },
        { label: 'Mythic+',   icon: '🗝', href: `${base}/mythic/` },
        { label: 'Logs',       icon: '📜', href: `${base}/logs/` },
        { label: 'Loots',      icon: '💎', href: `${base}/loots/` },
        { label: 'Regras',     icon: '📋', href: `${base}/regras/` },
      ].map((link) => (
        <a
          href={link.href}
          class="flex flex-col items-center gap-2 py-4 px-3 rounded-xl bg-[#141b2d] border border-white/7 hover:border-[#f0a500]/30 hover:bg-[#1a2235] text-slate-400 hover:text-[#f0a500] transition-all text-center group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f0a500]"
        >
          <span class="text-2xl group-hover:scale-110 transition-transform" aria-hidden="true">{link.icon}</span>
          <span class="text-xs font-semibold uppercase tracking-wide">{link.label}</span>
        </a>
      ))}
    </div>
  </section-->

</BaseLayout>
