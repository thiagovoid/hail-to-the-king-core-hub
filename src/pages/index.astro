---
/**
 * index.astro — Home institucional da Hail to the King
 * Porta de entrada do site: quem somos, pilares, e a partir daqui o
 * visitante escolhe pra onde ir (história completa, ou o dashboard de
 * performance do Core Nemesis). Core Nemesis deixou de ser a home — agora
 * é uma área dentro do site, não o site inteiro.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PillarsGrid from '@/components/PillarsGrid.astro';
import type { GuildAbout } from '@/types/index';

import aboutJson from '../../data/guild/about.json';

const about = aboutJson as GuildAbout;
---

<BaseLayout
  title="Início"
  description="Hail to the King — uma guild de World of Warcraft criada por amigos em 2012, baseada em respeito, humildade, empatia, companheirismo e amizade."
>
  <section aria-label="Apresentação da guild" class="relative overflow-hidden bg-[#0a0d14]">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute inset-0 bg-gradient-to-b from-[#0a0d14] via-[#0d1420] to-[#0a0d14]" />
      <div class="absolute -top-20 -left-20 w-[500px] h-[500px] rounded-full bg-[#f0a500]/6 blur-[80px]" />
      <div class="absolute -bottom-20 right-0 w-[400px] h-[400px] rounded-full bg-[#22c55e]/5 blur-[80px]" />
    </div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28 text-center">
      <span class="inline-flex items-center px-3 py-1 rounded-full bg-[#f0a500]/10 border border-[#f0a500]/30 text-[#f0a500] text-xs font-semibold uppercase tracking-widest mb-6">
        Guild de World of Warcraft · desde {about.founding.year}
      </span>

      <h1 class="text-4xl sm:text-6xl font-bold text-white tracking-tight mb-6">
        Hail to the King
      </h1>

      <p class="text-lg sm:text-xl text-slate-300 leading-relaxed mb-10">
        {about.message}
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href="/core/"
          class="inline-flex items-center px-5 py-2.5 rounded-lg bg-[#f0a500] text-[#0a0d14] font-bold text-sm hover:bg-[#fbbf24] transition-colors"
        >
          ⚔ Ver o Core Nemesis
        </a>
        <a
          href="/historia/"
          class="inline-flex items-center px-5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-slate-200 font-bold text-sm hover:border-[#f0a500]/40 hover:text-[#f0a500] transition-colors"
        >
          📜 Nossa história
        </a>
      </div>
    </div>
  </section>

  <section aria-labelledby="pillars-heading" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20">
    <div class="text-center mb-10">
      <h2 id="pillars-heading" class="text-2xl font-bold text-white mb-2">Nossos pilares</h2>
      <p class="text-slate-400 text-sm max-w-2xl mx-auto">{about.purpose}</p>
    </div>

    <PillarsGrid pillars={about.pillars} />
  </section>

  <section aria-labelledby="core-heading" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
    <div class="bg-[#141b2d] border border-white/7 rounded-xl p-8 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h2 id="core-heading" class="text-xl font-bold text-white mb-2">
          Core Nemesis
        </h2>
        <p class="text-slate-400 text-sm max-w-xl">
          O core de raid da Hail to the King — progressão, roster, performance e metas de cada jogador, tudo em tempo real.
        </p>
      </div>
      <a
        href="/core/"
        class="shrink-0 inline-flex items-center px-5 py-2.5 rounded-lg bg-[#f0a500]/10 border border-[#f0a500]/30 text-[#f0a500] font-bold text-sm hover:bg-[#f0a500]/20 transition-colors"
      >
        Ver dashboard →
      </a>
    </div>
  </section>
</BaseLayout>
