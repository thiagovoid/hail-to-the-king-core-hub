---
/**
 * loots.astro — Página de Loots do Core Hub
 * Exibe tabela de loots com filtros e estatísticas por jogador.
 *
 * Requirements: 7.1, 7.2
 */

import BaseLayout from "@/layouts/BaseLayout.astro";
import LootTable from "@/components/LootTable.astro";
import LootStats from "@/components/LootStats.astro";
import type { Loot, Player } from "@/types/index";

import lootData from "../../data/loot.json";
import rosterData from "../../data/roster.json";

const loots = lootData as Loot[];
const players = rosterData as Player[];

const totalLoots = loots.length;
const uniqueWeeks = [...new Set(loots.map((l) => l.week))].length;
---

<BaseLayout
  title="Loots"
  description="Histórico de loots distribuídos nas sessões de raid do core Hail to the King."
>
  <!-- Page header -->
  <section
    aria-label="Cabeçalho da seção Loots"
    class="bg-[#0a0d14] border-b border-white/5"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <div>
          <p class="text-slate-400 text-xs font-semibold uppercase tracking-widest mb-2">
            Raid · Loots
          </p>
          <h1 class="text-3xl sm:text-4xl font-bold text-[#f0a500] tracking-tight mb-3">
            Histórico de Loots
          </h1>
          <div class="flex flex-wrap items-center gap-3">
            <span
              class="inline-flex items-center px-3 py-1 rounded-full bg-[#f0a500]/10 border border-[#f0a500]/30 text-[#f0a500] text-sm font-medium"
            >
              🎁 {totalLoots} itens distribuídos
            </span>
            <span
              class="inline-flex items-center px-3 py-1 rounded-full bg-[#00c48c]/10 border border-[#00c48c]/30 text-[#00c48c] text-sm font-medium"
            >
              📅 {uniqueWeeks} semanas registradas
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">

    <!-- Loot table with filters -->
    <section aria-labelledby="loot-table-heading">
      <div class="pb-3 mb-6 border-b border-slate-700/50">
        <h2 id="loot-table-heading" class="text-xl font-bold text-[#f0a500] mb-1">
          Tabela de Loots
        </h2>
        <p class="text-slate-400 text-sm">
          Todos os itens distribuídos nas sessões de raid. Use os filtros para refinar a visualização.
        </p>
      </div>
      <LootTable loots={loots} players={players} />
    </section>

    <!-- Loot stats per player -->
    <section aria-labelledby="loot-stats-heading">
      <div class="pb-3 mb-6 border-b border-slate-700/50">
        <h2 id="loot-stats-heading" class="text-xl font-bold text-[#f0a500] mb-1">
          Estatísticas por Jogador
        </h2>
        <p class="text-slate-400 text-sm">
          Resumo de loots recebidos por membro — total, data do último item e média mensal.
        </p>
      </div>
      <LootStats loots={loots} players={players} />
    </section>

  </div>
</BaseLayout>
