---
/**
 * A retrospectiva da temporada inteira de uma pessoa, num core.
 *
 * Fora da navegação: chega-se por link, da /admin ou de quem compartilhou.
 * Os slides e o `noindex` moram no componente — aqui só a rota e o recorte
 * de semanas que ela significa.
 */
import RetrospectivaStories from '@/components/RetrospectivaStories.astro';

import roster from '../../../../../data/guild/roster.json';
import seasonJson from '../../../../../data/seasons/midnight-s2/config.json';
import { performanceWeeks } from '../../../../../data/weekly/performance/index';
import { mapearPessoas, type PersonagemDoRoster } from '@/engine/guild/pessoas';
import { coresDeRaide, jogadoresDoCore, semanasDoCore } from '@/engine/guild/cores';

export function getStaticPaths() {
  // Uma retrospectiva por core: o "2º do core" dos slides de comparação
  // precisa saber de que core. Quem joga em dois tem uma de cada.
  return coresDeRaide().flatMap((core) => {
    const doCore = jogadoresDoCore(roster, core.slug);
    const pessoas = mapearPessoas(doCore as unknown as PersonagemDoRoster[]);

    // Uma página por PESSOA, não por personagem: a temporada do Voidsurge
    // inclui o que ele fez de Voidwar, e duas páginas dividiriam a história
    // dele em duas metades.
    return doCore
      .filter((jogador) => (pessoas.get(jogador.id) ?? jogador.id) === jogador.id)
      .map((jogador) => ({
        params: { core: core.slug, id: jogador.id },
        props: {
          core,
          jogador,
          personagens: doCore
            .filter((outro) => (pessoas.get(outro.id) ?? outro.id) === jogador.id)
            .map((outro) => outro.id),
        },
      }));
  });
}

const { core: coreAtual, jogador, personagens } = Astro.props;
---

<RetrospectivaStories
  coreAtual={coreAtual}
  jogador={jogador}
  personagens={personagens}
  semanas={semanasDoCore(performanceWeeks, coreAtual.slug)}
  titulo={seasonJson.config.currentSeason ?? 'Midnight S2'}
/>
