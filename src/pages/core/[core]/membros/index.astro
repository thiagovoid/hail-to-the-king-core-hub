---
/**
 * membros.astro — Página de Membros
 * Lista o roster agrupado por role (Tank/Healer/DPS — doc "8.2 Roster"),
 * com filtros client-side por status, classe e main/alt.
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import PlayerCard from '@/components/PlayerCard.astro';
import type { Player, WowClass } from '@/types/index';
import rosterData from '../../../../../data/guild/roster.json';
import { coresDeRaide, jogadoresDoCore, papelNoCore, type PapelNoCore } from '@/engine/guild/cores';

/** Uma página de roster por core de raide. */
export function getStaticPaths() {
  return coresDeRaide().map((c) => ({ params: { core: c.slug }, props: { core: c } }));
}

const { core: coreAtual } = Astro.props;

const players = jogadoresDoCore(rosterData as Player[], coreAtual.slug);

const ROLE_ORDER = ['tank', 'healer', 'dps'] as const;
const ROLE_LABEL: Record<(typeof ROLE_ORDER)[number], string> = {
  tank: 'Tanks',
  healer: 'Healers',
  dps: 'DPS',
};

// Mains antes de alts dentro de cada role; o sort é estável, então a ordem
// do roster.json é preservada dentro de cada grupo.
const TYPE_ORDER: Record<PapelNoCore, number> = { main: 0, alt: 1, replace: 2 };

/** Quem não está no core vai pro fim, em vez de quebrar a ordenação. */
const ordemDoPapel = (player: Player) => {
  const papel = papelNoCore(player, coreAtual.slug);
  return papel ? TYPE_ORDER[papel] : 99;
};

const groups = ROLE_ORDER.map((role) => ({
  role,
  label: ROLE_LABEL[role],
  players: players
    .filter((p) => p.role === role)
    .sort((a, b) => ordemDoPapel(a) - ordemDoPapel(b)),
}));

const classesInRoster = [...new Set(players.map((p) => p.class))].sort() as WowClass[];

function capitalize(s: string): string {
  return s.split('-').map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
}
---

<BaseLayout
  title="Membros"
  description={`Conheça o roster do ${coreAtual.nome}: tanks, healers, DPS, status e estatísticas.`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- Page header -->
    <header class="mb-8">
      <h1 class="text-3xl font-bold text-slate-100 mb-2">Membros</h1>
      {/* Os números são recontados pelo filtro: sem isso o cabeçalho dizia
          "29 membros" com três cards na tela. */}
      <p class="text-slate-400 text-sm">
        <span data-conta="total">{players.length}</span>{' '}
        <span data-rotulo="total">{players.length === 1 ? 'membro' : 'membros'}</span> ·{' '}
        <span data-conta="tank">{groups.find((g) => g.role === 'tank')?.players.length ?? 0}</span>{' '}
        tanks ·{' '}
        <span data-conta="healer">{groups.find((g) => g.role === 'healer')?.players.length ?? 0}</span>{' '}
        healers ·{' '}
        <span data-conta="dps">{groups.find((g) => g.role === 'dps')?.players.length ?? 0}</span> DPS
      </p>
    </header>

    <!-- Filtros -->
    {players.length > 0 && (
      <div
        id="filtros"
        data-core={coreAtual.slug}
        class="flex flex-wrap gap-3 mb-10 pb-6 border-b border-slate-700/50"
      >
        {coresDeRaide().length > 1 && (
          <label class="flex items-center gap-2 text-sm text-slate-400">
            Core
            <select
              id="seletor-de-core"
              class="bg-[#141b2d] border border-white/10 rounded-lg px-3 py-1.5 text-slate-200 text-sm"
            >
              {coresDeRaide().map((core) => (
                <option value={core.slug} selected={core.slug === coreAtual.slug}>
                  {core.nome}
                </option>
              ))}
            </select>
          </label>
        )}

        <label class="flex items-center gap-2 text-sm text-slate-400">
          Status
          <select id="filter-status" class="bg-[#141b2d] border border-white/10 rounded-lg px-3 py-1.5 text-slate-200 text-sm">
            <option value="">Todos</option>
            <option value="trial">Trial</option>
            <option value="member">Member</option>
            <option value="veteran">Veteran</option>
            <option value="inactive">Inativo</option>
          </select>
        </label>

        <label class="flex items-center gap-2 text-sm text-slate-400">
          Classe
          <select id="filter-class" class="bg-[#141b2d] border border-white/10 rounded-lg px-3 py-1.5 text-slate-200 text-sm">
            <option value="">Todas</option>
            {classesInRoster.map((wowClass) => (
              <option value={wowClass}>{capitalize(wowClass)}</option>
            ))}
          </select>
        </label>

        <label class="flex items-center gap-2 text-sm text-slate-400">
          Tipo
          <select id="filter-type" class="bg-[#141b2d] border border-white/10 rounded-lg px-3 py-1.5 text-slate-200 text-sm">
            <option value="">Todos</option>
            <option value="main">Main</option>
            <option value="alt">Alt</option>
            <option value="replace">Suplentes</option>
          </select>
        </label>

        <p id="filter-empty-hint" class="hidden text-slate-500 text-sm self-center">
          Nenhum membro corresponde aos filtros selecionados.
        </p>
      </div>
    )}

    <!-- Grupos por role -->
    {groups.map((group) => group.players.length > 0 && (
      <section aria-labelledby={`${group.role}-heading`} class="mb-12" data-role-section={group.role}>
        <div class="pb-3 mb-6 border-b border-slate-700/50">
          <h2 id={`${group.role}-heading`} class="text-2xl font-bold text-[#f0a500] mb-1">
            {group.label}
          </h2>
          <p class="text-slate-400 text-sm">
            <span data-conta-grupo={group.role}>{group.players.length}</span>{' '}
            <span data-rotulo-grupo={group.role}>
              {group.players.length === 1 ? 'personagem' : 'personagens'}
            </span>
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
          {group.players.map((player) => (
            <PlayerCard player={player} />
          ))}
        </div>
      </section>
    ))}

    <!-- Empty state -->
    {players.length === 0 && (
      <p class="text-slate-400 text-center py-16">Nenhum membro cadastrado ainda.</p>
    )}

  </div>
</BaseLayout>

<script>
  const statusSelect = document.getElementById('filter-status') as HTMLSelectElement | null;
  const classSelect = document.getElementById('filter-class') as HTMLSelectElement | null;
  const typeSelect = document.getElementById('filter-type') as HTMLSelectElement | null;
  const emptyHint = document.getElementById('filter-empty-hint');
  const coreSelect = document.getElementById('seletor-de-core') as HTMLSelectElement | null;

  // De que core é esta página. "Titular" quer dizer titular NESTE core, e
  // o card de quem joga em dois guarda o papel de cada um.
  const filtros = document.getElementById('filtros');

  /**
   * Os números do cabeçalho e de cada grupo, depois do filtro.
   *
   * Grupo que ficou sem ninguém some inteiro: um título "Tanks" sobre
   * "0 personagens" e nenhum card é pior que não mostrar o grupo.
   */
  function atualizarContagens(porRole: Map<string, number>, total: number) {
    const escreve = (el: Element | null, valor: number) => {
      if (el) el.textContent = String(valor);
    };

    escreve(document.querySelector('[data-conta="total"]'), total);
    const rotuloTotal = document.querySelector('[data-rotulo="total"]');
    if (rotuloTotal) rotuloTotal.textContent = total === 1 ? 'membro' : 'membros';

    for (const role of ['tank', 'healer', 'dps']) {
      const quantos = porRole.get(role) ?? 0;

      escreve(document.querySelector(`[data-conta="${role}"]`), quantos);
      escreve(document.querySelector(`[data-conta-grupo="${role}"]`), quantos);

      const rotulo = document.querySelector(`[data-rotulo-grupo="${role}"]`);
      if (rotulo) rotulo.textContent = quantos === 1 ? 'personagem' : 'personagens';

      const secao = document.querySelector<HTMLElement>(`[data-role-section="${role}"]`);
      if (secao) secao.style.display = quantos === 0 ? 'none' : '';
    }
  }

  function applyFilters() {
    const status = statusSelect?.value ?? '';
    const wowClass = classSelect?.value ?? '';
    const type = typeSelect?.value ?? '';
    const core = filtros?.dataset.core ?? '';

    /**
     * Core e Tipo não são filtros independentes: "titular" sem core quer
     * dizer titular em ALGUM core, e com core escolhido quer dizer titular
     * NAQUELE. Cruzar os dois como se fossem soltos escondia quem só joga
     * no core não-principal.
     */
    const papelCombina = (card: HTMLElement, core: string, type: string) => {
      const pares = (card.dataset.papeis ?? '')
        .split(',')
        .filter(Boolean)
        .map((par) => par.split(':') as [string, string]);

      const noCore = core ? pares.filter(([slug]) => slug === core) : pares;
      if (noCore.length === 0) return false;
      return !type || noCore.some(([, papel]) => papel === type);
    };

    let visibleCount = 0;
    const porRole = new Map<string, number>();

    // Esconde via style inline, não pelo atributo `hidden`: o card tem a
    // classe `flex` do Tailwind, que empata em especificidade com a regra
    // `[hidden]` do navegador e ganha por vir depois na folha de estilo —
    // o atributo era marcado mas o card continuava aparecendo.
    document.querySelectorAll<HTMLElement>('article[data-role]').forEach((card) => {
      const matches =
        (!status || card.dataset.status === status) &&
        (!wowClass || card.dataset.class === wowClass) &&
        papelCombina(card, core, type);

      card.style.display = matches ? '' : 'none';
      if (matches) visibleCount++;
      if (matches) {
        const role = card.dataset.role ?? '';
        porRole.set(role, (porRole.get(role) ?? 0) + 1);
      }
    });

    atualizarContagens(porRole, visibleCount);

    // Esconde o cabeçalho de uma seção de role inteira quando o filtro zera
    // todos os cards dela, em vez de deixar um título "Tanks" sobre nada.
    document.querySelectorAll<HTMLElement>('[data-role-section]').forEach((section) => {
      const hasVisibleCard = [...section.querySelectorAll<HTMLElement>('article[data-role]')].some(
        (card) => card.style.display !== 'none'
      );
      section.style.display = hasVisibleCard ? '' : 'none';
    });

    emptyHint?.classList.toggle('hidden', visibleCount > 0);
  }

  statusSelect?.addEventListener('change', applyFilters);
  classSelect?.addEventListener('change', applyFilters);
  typeSelect?.addEventListener('change', applyFilters);
  // Trocar de core é navegar, não filtrar: o roster do outro core é outra
  // página, com outras contagens e outro gráfico.
  coreSelect?.addEventListener('change', () => {
    if (coreSelect.value) window.location.pathname = `/core/${coreSelect.value}/membros/`;
  });
</script>
