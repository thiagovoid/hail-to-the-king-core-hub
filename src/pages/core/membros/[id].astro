---
/**
 * [id].astro — A URL antiga da ficha de um jogador.
 *
 * /core/membros/<id> veio de quando existia um core só. Virou
 * /core/<core>/membros/<id>, e o link antigo já circulou em Discord e em
 * perfil de jogador — então ele continua de pé apontando pro novo.
 *
 * É página de verdade, e não entrada em `redirects` do config, porque em
 * build estático o Astro precisa da lista de ids pra gerar um arquivo por
 * jogador, e quem tem essa lista é o roster.
 */

import roster from '../../../../data/guild/roster.json';
import { coresDe, corePrincipal, type ParticipacaoEmCores } from '@/engine/guild/cores';

export function getStaticPaths() {
  return roster.map((player) => ({ params: { id: player.id } }));
}

const { id } = Astro.params;
const player = roster.find((jogador) => jogador.id === id);

/**
 * O primeiro core em que ele joga, não o principal: quem só joga no Ômega
 * tinha a URL antiga apontando pra um roster que não é o dele.
 *
 * O `unknown` é por causa do import de JSON, que infere `type: string`
 * onde `ParticipacaoEmCores` quer a união dos papéis.
 */
const destino =
  coresDe((player ?? {}) as unknown as { cores?: ParticipacaoEmCores })[0] ??
  corePrincipal().slug;

return Astro.redirect(`/core/${destino}/membros/${id}/`);
---
