
---
import BaseLayout from '@/layouts/BaseLayout.astro';

import roster from '../../../../data/guild/roster.json';
import seasonJson from '../../../../data/seasons/midnight-s2/config.json';
import { performanceWeeks } from '../../../../data/weekly/performance/index';
import PerformanceSummary from '@/components/PerformanceSummary.astro';
import PerformanceGoals from '@/components/PerformanceGoals.astro';
import PerformanceScoreCard from '@/components/PerformanceScoreCard.astro';
import PerformanceChart from '@/components/PerformanceChart.astro';
import ContribuicaoForaDeFuncao from '@/components/ContribuicaoForaDeFuncao.astro';
import PainelDoTank from '@/components/PainelDoTank.astro';

import {
  buildPlayerSeasonAverage,
  calculateAttendance,
  calculateTrend,
  formatPerformanceValue,
  getPlayerHistory,
} from '@/engine/metrics';
import { formatCompact } from '@/utils/format';
import { calculateOverallScore } from '@/engine/scores';
import { buildCoachRecommendation } from '@/engine/scores/coach';
import CoachCard from '@/components/CoachCard.astro';
import { formatDate } from '@/utils/format';

export function getStaticPaths() {
  return roster.map((player) => ({
    params: {
      id: player.id,
    },
    props: {
      player,
    },
  }));
}

const { player } = Astro.props;

const weeks = performanceWeeks;

const history = getPlayerHistory(
  weeks,
  player.id
);

// Média da temporada: base do resumo e das metas individuais (a meta de dps
// compara contra a média de todos os registros — decisão registrada).
const seasonAverage = buildPlayerSeasonAverage(player.id, history);

// O Score Geral, porém, mede a ÚLTIMA NOITE, não a temporada: é a foto de
// como a pessoa está agora. Misturar as duas coisas fazia aparecer erro de
// boss que nem foi jogado na semana, e uma noite ruim ficava diluída em oito.
// O histórico é o que o gráfico mostra.
const ultimaNoite = history.at(-1);

// Detalhe da MESMA noite que o Score Geral mede. Antes isto somava a
// temporada inteira, e aparecia erro de boss que nem foi jogado na semana.
const mechanicsDetail = [...(ultimaNoite?.mechanicsDetail ?? [])]
  .sort((a, b) => b.tries - a.tries)
  .slice(0, 3);

const preparationMissing = ultimaNoite?.preparationMissing ?? [];

// Mesma noite do Score Geral. Os três piores: a lista inteira vira parede de
// texto e o que importa é o que treinar primeiro.
const attackDetail = (ultimaNoite?.attackDetail ?? []).slice(0, 3);
const attackParts = ultimaNoite?.attack
  ? { uptime: ultimaNoite.attack.uptime, cooldowns: ultimaNoite.attack.cooldowns }
  : null;

const defenseDetail = (ultimaNoite?.defenseDetail ?? []).slice(0, 3);
const defenseContext = ultimaNoite?.defense
  ? {
      mitigation: ultimaNoite.defense.mitigation,
      dtps: ultimaNoite.defense.dtps,
      selfSustain: ultimaNoite.defense.selfSustain,
    }
  : null;

/** Média das noites em que o número existe — a régua é a pessoa, não o core. */
const mediaDe = <T,>(valores: Array<T | undefined>): number | undefined => {
  const definidos = valores.filter((valor): valor is T => valor !== undefined).map(Number);
  if (definidos.length === 0) return undefined;
  return Math.round(definidos.reduce((soma, valor) => soma + valor, 0) / definidos.length);
};

const foraDeFuncaoAtual = ultimaNoite?.offRole ?? null;
const foraDeFuncaoMedia = {
  dps: mediaDe(history.map((run) => run.offRole?.dps)),
  hps: mediaDe(history.map((run) => run.offRole?.hps)),
};
const noitesForaDeFuncao = history.filter((run) => run.offRole !== undefined).length;

// O painel só aparece pra quem a WCL registrou tankando — o cadastro pode
// estar desatualizado, e quem trocou de função no meio da season veria um
// painel que não é dela.
const eTank = player.role === 'tank';
const tankAtual = eTank && ultimaNoite?.defense ? ultimaNoite.defense : null;
const tankMedia = {
  dtps: mediaDe(history.map((run) => run.defense?.dtps)),
  mitigation: mediaDe(history.map((run) => run.defense?.mitigation)),
  selfSustain: mediaDe(history.map((run) => run.defense?.selfSustain)),
};
const noitesComoTank = history.filter((run) => run.defense !== undefined).length;

const healingParts = ultimaNoite?.healing
  ? {
      coverage: ultimaNoite.healing.coverage,
      share: ultimaNoite.healing.share,
      overheal: ultimaNoite.healing.overheal,
    }
  : null;

const hasData = history.length > 0;

const dpsHistory = history
  .filter((performance) => performance.dps !== undefined)
  .map((performance) => ({
    date: performance.date,
    value: performance.dps!,
  }));

const parseHistory = history
  .filter((performance) => performance.parse !== undefined)
  .map((performance) => ({
    date: performance.date,
    value: performance.parse!,
  }));

const mechanicsHistory = history
  .filter((performance) => performance.mechanics?.errors !== undefined)
  .map((performance) => ({
    date: performance.date,
    value: performance.mechanics!.errors,
    // O que explicou aquele ponto, pra não se perder quando chegar log novo.
    detail: [...(performance.mechanicsDetail ?? [])]
      .sort((a, b) => b.tries - a.tries)
      .slice(0, 4)
      .map((item) =>
        `${item.label ?? item.mechanic.replace('Damage from ', '')} — ${item.tries} de ${performance.mechanics?.tries ?? '?'} trys`
      ),
  }));

const attackHistory = history
  .filter((performance) => performance.attack !== undefined)
  .map((performance) => ({
    date: performance.date,
    value: performance.attack!.score,
    detail: [
      `Uptime — ${performance.attack!.uptime}%`,
      performance.attack!.cooldowns !== null
        ? `Cooldowns — ${performance.attack!.cooldowns}% do tempo em recarga`
        : 'Cooldowns — sem cooldown ofensivo medido',
      ...(performance.attackDetail ?? [])
        .slice(0, 3)
        .map((item) => `${item.name} — ${item.efficiency}% (${item.casts} uso${item.casts === 1 ? '' : 's'})`),
    ],
  }));

const defenseHistory = history
  .filter((performance) => performance.defense?.score != null)
  .map((performance) => ({
    date: performance.date,
    value: performance.defense!.score!,
    detail: [
      `${formatCompact(performance.defense!.dtps)} de dano recebido por segundo`,
      `${performance.defense!.mitigation}% mitigado`,
      ...(performance.defenseDetail ?? [])
        .slice(0, 3)
        .map((item) => `${item.name} — ${item.efficiency}% (${item.casts} uso${item.casts === 1 ? '' : 's'})`),
    ],
  }));

const deathsHistory = history
  .map((performance) => ({
    date: performance.date,
    value: performance.deaths,
  }));

const hpsHistory = history
  .filter((performance) => performance.hps !== undefined)
  .map((performance) => ({
    date: performance.date,
    value: performance.hps!,
  }));

// Healers têm hps, o resto tem dps — nunca os dois juntos, então só um
// dos dois entra no gráfico principal (o outro ficaria sempre vazio).
const primaryMetricSeries = player.role === 'healer'
  ? {
      id: 'hps',
      label: 'HPS',
      data: hpsHistory,
      target: player.performanceGoals?.hps?.target,
      current: seasonAverage.hps ?? null,
      direction: 'higher' as const,
    }
  : {
      id: 'dps',
      label: 'DPS',
      data: dpsHistory,
      target: player.performanceGoals?.dps?.target,
      current: seasonAverage.dps ?? null,
      direction: 'higher' as const,
    };

// Escondidas por hora (mesmo critério do dashboard do core): só a métrica
// principal (dps/hps) fica no gráfico. Basta tirar daqui pra voltarem.
// Mortes virou indicador de temporada, ao lado de Bosses mortos. Parse
// voltou: sete das oito noites têm percentil pra 100% dos presentes.
const HIDDEN_CHART_SERIES = new Set(['deaths']);

const overallScore = hasData
  ? calculateOverallScore(ultimaNoite ?? seasonAverage, seasonJson.config.performanceTargets)
  : undefined;

const coachRecommendation = overallScore
  ? buildCoachRecommendation(overallScore)
  : undefined;

// Tendência olha pra métrica principal do jogador (dps ou hps, mesmo
// critério de primaryMetricSeries acima) ao longo do histórico.
const trend = calculateTrend(
  primaryMetricSeries.data.map((point) => point.value)
);

const attendance = calculateAttendance(weeks, player.id);

---

<BaseLayout
  title={`${player.name} — Performance`}
  description={`Evolução de performance de ${player.name} no Core Nemesis.`}
>
  <div class="max-w-7xl mx-auto px-4 py-8">
    <a
      href="/core/membros/"
      class="inline-flex items-center gap-2 text-sm text-slate-400 hover:text-white transition-colors mb-8"
    >
      ← Voltar para membros
    </a>

    <header class="flex items-center gap-5 mb-8">
      <img
        src={player.avatar}
        alt={player.name}
        width="96"
        height="96"
        class="w-24 h-24 rounded-lg border border-slate-700"
      />

      <div>
        <h1 class="text-3xl font-bold text-white">
          {player.name}
        </h1>

        <p class="text-slate-400 mt-1">
          {player.class} · {player.spec}
        </p>

        <p class="text-sm text-slate-500 mt-1 capitalize">
          {player.role}
        </p>
      </div>
    </header>

    {
      hasData ? (
        <PerformanceSummary average={seasonAverage} />
      ) : (
        <section class="bg-slate-900/60 border border-slate-800 rounded-xl p-6">
          <h2 class="text-xl font-bold text-white">
            Sem dados de performance
          </h2>

          <p class="text-slate-400 mt-2">
            Ainda não existem dados registrados para este jogador.
          </p>
        </section>
      )
    }

    {
      hasData && overallScore && (
        <PerformanceScoreCard
          score={overallScore}
          trend={trend}
          attendance={attendance}
          nightDate={ultimaNoite?.date ?? null}
          nightTries={ultimaNoite?.mechanics?.tries ?? null}
          preparationMissing={preparationMissing}
          mechanicsDetail={mechanicsDetail}
          attackDetail={attackDetail}
          attackParts={attackParts}
          defenseDetail={defenseDetail}
          defenseContext={defenseContext}
          healingParts={healingParts}
        />
      )
    }

    <!-- Coach Virtual escondido por hora (vale pra todos os membros).
         A engine e o componente seguem prontos — basta descomentar.
    {
      hasData && coachRecommendation && (
        <CoachCard recommendation={coachRecommendation} />
      )
    }
    -->

    {
      hasData && (
        <PerformanceGoals
          goals={player.performanceGoals}
          current={{
            ...seasonAverage,
            mechanics: ultimaNoite?.mechanics,
            attack: ultimaNoite?.attack,
            defense: ultimaNoite?.defense,
            healing: ultimaNoite?.healing,
          }}
          coreMechanicsTarget={seasonJson.config.performanceTargets.mechanics.target}
          coreAttackTarget={seasonJson.config.performanceTargets.attack.target}
          coreDefenseTarget={seasonJson.config.performanceTargets.defense.target}
          coreHealingTarget={seasonJson.config.performanceTargets.healing.target}
        />
      )
    }

    <PainelDoTank atual={tankAtual} media={tankMedia} nights={noitesComoTank} />

    <ContribuicaoForaDeFuncao
      atual={foraDeFuncaoAtual}
      media={foraDeFuncaoMedia}
      nights={noitesForaDeFuncao}
    />

    {
      history.length > 0 && (
        <PerformanceChart
          series={[
            primaryMetricSeries,
            {
              id: 'parse',
              label: 'Parse',
              data: parseHistory,
              target: player.performanceGoals?.parse?.target,
              direction: 'higher',
            },
            {
              id: 'mechanics',
              label: 'Mecânicas',
              data: mechanicsHistory,
              // A meta de mecânicas é do core, igual pra todo mundo — a
              // individual saiu do roster quando só o objetivo de dps ficou.
              target: seasonJson.config.performanceTargets.mechanics.target,
              current: ultimaNoite?.mechanics?.errors ?? null,
              direction: 'lower',
            },
            {
              id: 'attack',
              label: 'Atacar',
              data: attackHistory,
              // Meta do core, igual pra todo mundo — não existe objetivo
              // individual de execução ofensiva no roster.
              target: seasonJson.config.performanceTargets.attack.target,
              current: ultimaNoite?.attack?.score ?? null,
              direction: 'higher',
            },
            {
              id: 'defense',
              label: 'Defender',
              data: defenseHistory,
              target: seasonJson.config.performanceTargets.defense.target,
              current: ultimaNoite?.defense?.score ?? null,
              direction: 'higher',
            },
            {
              id: 'deaths',
              label: 'Mortes',
              data: deathsHistory,
              target: player.performanceGoals?.deaths?.target,
              direction: 'lower',
            },
          ].filter((item) => !HIDDEN_CHART_SERIES.has(item.id))}
        />
      )
    }

    <section>
      <h2 class="text-xl font-bold text-white mb-4">
        Histórico
      </h2>

      <div class="overflow-x-auto bg-slate-900/60 border border-slate-800 rounded-xl">
        <table class="w-full text-sm">
          <thead class="border-b border-slate-800">
            <tr class="text-left text-slate-500">
              <th class="px-4 py-3">Semana</th>
              <th class="px-4 py-3">Data</th>
              <th class="px-4 py-3">DPS</th>
              <th class="px-4 py-3">HPS</th>
              <th class="px-4 py-3">Parse</th>
              <th class="px-4 py-3">Mortes</th>
              <th class="px-4 py-3">Erros</th>
              <th class="px-4 py-3">Item Level</th>
            </tr>
          </thead>

          <tbody>
            {
              history.map((performance) => {
                return (
                  <tr class="border-b border-slate-800/50 last:border-0">
                    <td class="px-4 py-3 text-white">
                      {performance.week}
                    </td>

                    <td class="px-4 py-3 text-slate-400">
                      {formatDate(performance.date)}
                    </td>

                    <td class="px-4 py-3 text-slate-300">
                      {formatPerformanceValue(performance.dps)}
                    </td>

                    <td class="px-4 py-3 text-slate-300">
                      {formatPerformanceValue(performance.hps)}
                    </td>

                    <td class="px-4 py-3 text-slate-300">
                      {performance.parse ?? '-'}
                    </td>

                    <td class="px-4 py-3 text-slate-300">
                      {performance.deaths}
                    </td>

                    <td class="px-4 py-3 text-slate-300">
                      {performance.mechanics?.errors ?? '-'}
                    </td>

                    <td class="px-4 py-3 text-slate-300">
                      {performance.itemLevel ?? '-'}
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
    </section>
  </div>
</BaseLayout>
