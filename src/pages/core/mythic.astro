---
/**
 * mythic.astro — Página de Mythic+ do Core Hub
 * Exibe ranking de IO do roster, estatísticas agregadas e top keys da semana.
 *
 * Requirements: 5.1, 5.2, 5.3
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import MythicRankingTable from '@/components/MythicRankingTable.astro';
import MythicStatsBar from '@/components/MythicStatsBar.astro';
import type { Player } from '@/types/index';
import { computeMythicStats } from '@/utils/roster';
import { formatDate } from '@/utils/format';

import rosterData from '../../../data/guild/roster.json';
import { getLatestWeeklyHighlights } from '../../../data/weekly/highlights/index';

const players = rosterData as Player[];
const stats = computeMythicStats(players);

const weekHighlights = getLatestWeeklyHighlights();
const topKeys = weekHighlights?.topKeys ?? [];
const weekNumber = weekHighlights?.week;
const weekDate = formatDate(weekHighlights?.date ?? null);
---

<BaseLayout
  title="Mythic+"
  description="Ranking de IO, estatísticas e top keys de Mythic+ do Core Nemesis."
>

  <!-- Page header -->
  <section
    aria-label="Cabeçalho da seção Mythic+"
    class="bg-[#0a0d14] border-b border-white/5"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <div>
          <p class="text-slate-400 text-xs font-semibold uppercase tracking-widest mb-2">
            Mythic+
          </p>
          <h1 class="text-3xl sm:text-4xl font-bold text-[#f0a500] tracking-tight mb-3">
            Ranking & Estatísticas
          </h1>
          <div class="flex flex-wrap items-center gap-3">
            <span
              class="inline-flex items-center px-3 py-1 rounded-full bg-[#f0a500]/10 border border-[#f0a500]/30 text-[#f0a500] text-sm font-medium"
            >
              🗝 {players.length} membros
            </span>
            <span
              class="inline-flex items-center px-3 py-1 rounded-full bg-[#00c48c]/10 border border-[#00c48c]/30 text-[#00c48c] text-sm font-medium"
            >
              ⚡ Média {stats.avgIo} IO
            </span>
          </div>
        </div>

        <p class="text-slate-400 text-sm shrink-0">
          Semana {weekNumber} ·{' '}
          <time datetime={weekHighlights?.date} class="text-slate-400 font-medium">
            {weekDate}
          </time>
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">

    <!-- Stats bar -->
    <section aria-labelledby="stats-heading">
      <div class="pb-3 mb-6 border-b border-slate-700/50">
        <h2 id="stats-heading" class="text-xl font-bold text-[#f0a500] mb-1">
          Estatísticas do Grupo
        </h2>
        <p class="text-slate-400 text-sm">Métricas agregadas de IO de todos os membros do roster.</p>
      </div>
      <MythicStatsBar stats={stats} />
    </section>

    <!-- Ranking table -->
    <section aria-labelledby="ranking-heading">
      <div class="pb-3 mb-6 border-b border-slate-700/50">
        <h2 id="ranking-heading" class="text-xl font-bold text-[#f0a500] mb-1">
          Ranking de IO
        </h2>
        <p class="text-slate-400 text-sm">
          Jogadores ordenados por Raider.IO Score decrescente. Empates recebem o mesmo número de rank.
        </p>
      </div>
      <MythicRankingTable players={players} />
    </section>

    <!-- Top Keys da semana -->
    <section aria-labelledby="topkeys-heading">
      <div class="pb-3 mb-6 border-b border-slate-700/50">
        <h2 id="topkeys-heading" class="text-xl font-bold text-[#f0a500] mb-1">
          Top Keys da Semana
        </h2>
        <p class="text-slate-400 text-sm">
          Melhores chaves completadas na semana {weekNumber}
          {weekDate !== '—' ? ` (${weekDate})` : ''}.
        </p>
      </div>

      {topKeys.length > 0 ? (
        <div class="overflow-x-auto rounded-lg border border-slate-700/50">
          <table
            class="w-full text-sm"
            aria-label="Top Keys da semana"
          >
            <thead>
              <tr class="bg-[#1a2030] border-b border-slate-700/50">
                <th
                  scope="col"
                  class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-400 w-10"
                >
                  #
                </th>
                <th
                  scope="col"
                  class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-400"
                >
                  Dungeon
                </th>
                <th
                  scope="col"
                  class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-400 w-36"
                >
                  Nível da Chave
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-700/30">
              {topKeys.map((key, index) => (
                <tr class="hover:bg-[#1a2030]/60 transition-colors">
                  <td class="px-4 py-3 text-slate-400 tabular-nums font-medium">
                    {index + 1}
                  </td>
                  <td class="px-4 py-3 text-slate-200 font-medium">
                    {key.dungeon}
                  </td>
                  <td class="px-4 py-3 text-right tabular-nums">
                    <span class="inline-flex items-center justify-center px-2.5 py-0.5 rounded-full bg-[#f0a500]/10 border border-[#f0a500]/30 text-[#f0a500] font-bold text-sm">
                      +{key.keyLevel}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="text-slate-400 text-center py-10">
          Nenhuma top key registrada para esta semana.
        </p>
      )}
    </section>

  </div>
</BaseLayout>
