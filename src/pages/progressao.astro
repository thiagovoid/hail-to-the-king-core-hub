---
/**
 * progressao.astro — Página de Progressão do Core Hub
 * Exibe o status detalhado de cada boss da raid atual com acordeão expansível.
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import BossCard from '@/components/BossCard.astro';
import type { SiteConfig, Boss } from '@/types/index';
import { computeProgression } from '@/utils/progression';
import { formatDate } from '@/utils/format';

import seasonJson from '../../data/seasons/midnight-s2.json';

const config = seasonJson.config as SiteConfig;
const bosses = seasonJson.bosses as Boss[];

const progression = computeProgression(bosses);

// Build progression summary: "7/8 Mythic" or "7/8 (87%)"
const progressionSummary = progression.total > 0
  ? progression.killed < progression.total
    ? `${progression.killed}/${progression.total} (${progression.percent}%)`
    : `${progression.killed}/${progression.total} Mythic`
  : '—';

const lastUpdated = formatDate(config.lastUpdated);
---

<BaseLayout
  title="Progressão"
  description={`Progressão Mythic do core Hail to the King — ${config.currentRaid}. ${progressionSummary}.`}
>
  <!-- Page header -->
  <section
    aria-label="Cabeçalho da progressão"
    class="bg-[#0a0d14] border-b border-white/5"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">

        <div>
          <!-- Raid name -->
          <p class="text-slate-400 text-xs font-semibold uppercase tracking-widest mb-2">
            Progressão Mythic
          </p>
          <h1 class="text-3xl sm:text-4xl font-bold text-[#f0a500] tracking-tight mb-3">
            {config.currentRaid}
          </h1>
          <!-- Progression summary badge -->
          <div class="flex flex-wrap items-center gap-3">
            <span
              class="inline-flex items-center px-3 py-1 rounded-full bg-[#00c48c]/10 border border-[#00c48c]/30 text-[#00c48c] text-sm font-semibold"
            >
              ⚔ {progressionSummary}
            </span>
            <span class="inline-flex items-center px-3 py-1 rounded-full bg-[#f0a500]/10 border border-[#f0a500]/30 text-[#f0a500] text-sm font-medium">
              🌙 {config.currentSeason}
            </span>
          </div>
        </div>

        <!-- Last updated -->
        <p class="text-slate-400 text-sm shrink-0">
          Atualizado em{' '}
          <time datetime={config.lastUpdated} class="text-slate-400 font-medium">
            {lastUpdated}
          </time>
        </p>

      </div>
    </div>
  </section>

  <!-- Boss list -->
  <section
    aria-label="Lista de bosses"
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10"
  >
    <h2 class="text-slate-400 text-xs font-semibold uppercase tracking-widest mb-6">
      Encontros
    </h2>

    <div class="flex flex-col gap-2">
      {bosses.map((boss, i) => (
        <BossCard boss={boss} index={i} />
      ))}
    </div>
  </section>
</BaseLayout>
