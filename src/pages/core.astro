---
/**
 * core.astro — Dashboard do Core Nemesis
 * Era a home (/) até a reorganização institucional: Core Nemesis agora é
 * uma área dentro do site da Hail to the King, não a porta de entrada.
 * Exibe HeroSection com barras de progressão Normal/Heroica e SummaryCards navegáveis.
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/HeroSection.astro';
import SummaryCard from '@/components/SummaryCard.astro';
import CorePerformanceChart from '@/components/CorePerformanceChart.astro';
import CoreRankingTable from '@/components/CoreRankingTable.astro';
import CoreHealthPanel from '@/components/CoreHealthPanel.astro';
import type { SiteConfig, Boss, Player } from '@/types/index';
import { computeProgression } from '@/utils/progression';
import { computeMythicStats, getClassColor } from '@/utils/roster';
import { formatThousands } from '@/utils/format';

import seasonJson from '../../data/seasons/midnight-s2/config.json';
import rosterJson from '../../data/guild/roster.json';
import { getLatestWeeklyHighlights } from '../../data/weekly/highlights/index';
import { performanceWeeks } from '../../data/weekly/performance/index';

const config = seasonJson.config as SiteConfig;
const bossesNormal = seasonJson.bossesNormal as Boss[];
const bossesHeroic = seasonJson.bossesHeroic as Boss[];
const recentLogs = seasonJson.recentLogs ?? [];
const players = rosterJson as Player[];
const weeklyHighlights = getLatestWeeklyHighlights();

import { getCorePerformanceSeries } from '@/engine/metrics';
import { buildCoreRanking, calculateCoreAverages } from '@/engine/team';
import { calculateCoreHealth } from '@/engine/guild/coreHealth';
import { serieDoHailScore } from '@/engine/team/hailScore';
import HailScoreCard from '@/components/HailScoreCard.astro';

const coreAverages = calculateCoreAverages(performanceWeeks);
const targets = config.performanceTargets;
const coreRanking = buildCoreRanking(performanceWeeks, players, targets);
const coreHealth = calculateCoreHealth(performanceWeeks, players, targets, bossesNormal, bossesHeroic);

// Hail Score: a nota do core inteiro, noite a noite. Entra como a primeira
// aba do gráfico porque é a leitura de cima — as outras explicam ela.
const funcaoDoJogador = (playerId: string) =>
  players.find((jogador) => jogador.id === playerId)?.role;

const hailScore = serieDoHailScore(performanceWeeks, targets, funcaoDoJogador);
const hailScoreAtual = hailScore.at(-1)?.value ?? null;
const hailScoreAnterior = hailScore.at(-2)?.value ?? null;
const hailScoreData = hailScore.at(-1)?.date ?? null;

// Mesma ordenação da página de membros: tank, healer, dps; main antes de
// alt dentro de cada grupo. Duas telas listando o core em ordens diferentes
// fariam a pessoa procurar duas vezes.
const ROLE_ORDER = ['tank', 'healer', 'dps'] as const;
const ROLE_LABEL: Record<(typeof ROLE_ORDER)[number], string> = {
  tank: 'Tanks',
  healer: 'Healers',
  dps: 'DPS',
};
const TYPE_ORDER: Record<Player['type'], number> = { main: 0, alt: 1 };

const rosterGroups = ROLE_ORDER.map((role) => ({
  label: ROLE_LABEL[role],
  players: players
    .filter((player) => player.role === role)
    .sort((a, b) => TYPE_ORDER[a.type] - TYPE_ORDER[b.type])
    .map((player) => ({
      name: player.name,
      slug: encodeURIComponent(player.name.toLowerCase()),
      colorClass: getClassColor(player.class),
    })),
})).filter((grupo) => grupo.players.length > 0);

const dpsSeries = getCorePerformanceSeries(
  performanceWeeks,
  players,
  'dps'
).map((series) => {
  const player = players.find(
    (item) => item.id === series.playerId
  );

  return {
    ...series,
    playerName: player?.name ?? series.playerId,
    playerClass: player?.class,
    playerSlug: player?.name
        ? encodeURIComponent(player.name.toLowerCase())
        : undefined
  };
});

const parseSeries = getCorePerformanceSeries(
  performanceWeeks,
  players,
  'parse'
).map((series) => {
  const player = players.find(
    (item) => item.id === series.playerId
  );

  return {
    ...series,
    playerName: player?.name ?? series.playerId,
    playerClass: player?.class,
    playerSlug: player?.name
        ? encodeURIComponent(player.name.toLowerCase())
        : undefined
  };
});

const deathsSeries = getCorePerformanceSeries(
  performanceWeeks,
  players,
  'deaths'
).map((series) => {
  const player = players.find(
    (item) => item.id === series.playerId
  );

  return {
    ...series,
    playerName: player?.name ?? series.playerId,
    playerClass: player?.class,
    playerSlug: player?.name
        ? encodeURIComponent(player.name.toLowerCase())
        : undefined
  };
});

const mechanicsSeries = getCorePerformanceSeries(
  performanceWeeks,
  players,
  'mechanics'
).map((series) => {
  const player = players.find(
    (item) => item.id === series.playerId
  );

  return {
    ...series,
    playerName: player?.name ?? series.playerId,
    playerClass: player?.class,
    playerSlug: player?.name
        ? encodeURIComponent(player.name.toLowerCase())
        : undefined
  };
});

// Base path
const base = '';

// Parse e mortes seguem escondidos: parse só existe pra boss morto, e
// mortes saíram do score. Mecânicas voltou quando a coleta do Wipefest
// passou a rodar. As séries continuam sendo calculadas — basta tirar daqui.
// Mortes saiu do score e virou indicador na página do jogador. Parse
// voltou: das oito noites coletadas, sete têm percentil pra 100% dos
// presentes — a exceção é 27/08, que não teve kill nenhum, e a WCL só
// rankeia kill. Noite sem boss morto simplesmente não vira ponto.
const HIDDEN_CHART_METRICS = new Set(['deaths']);

const formatDpsAverage = (value: number | null) => (value === null ? null : formatThousands(value, 2));

// 1 — Progressão Normal
const progressionNormal = computeProgression(bossesNormal);
const progressionNormalValue = progressionNormal.total > 0 ? `${progressionNormal.killed}/${progressionNormal.total} N` : null;
const progressionNormalSubtitle = progressionNormal.total > 0 ? `${progressionNormal.percent}% Normal concluído` : undefined;

// 2 — Progressão Heroica
const progressionHeroic = computeProgression(bossesHeroic);
const progressionHeroicValue = progressionHeroic.total > 0 ? `${progressionHeroic.killed}/${progressionHeroic.total} H` : null;
const progressionHeroicSubtitle = progressionHeroic.total > 0 ? `${progressionHeroic.percent}% Heróico concluído` : undefined;


// 3 — Média Raider.IO + Melhor Key da Semana
const mythicStats = computeMythicStats(players);
const avgIoValue = mythicStats.avgIo > 0 ? mythicStats.avgIo : null;
const bestKey = weeklyHighlights?.bestKey ?? null;
const avgIoSubtitle = bestKey
  ? `Média do grupo · Melhor key: ${bestKey.dungeon} +${bestKey.level}`
  : 'Média do grupo';
---

<BaseLayout
  title="Core Nemesis"
  description="Dashboard do Core Nemesis — progressão, membros e destaques da semana."
>

  <HeroSection config={config} bossesNormal={bossesNormal} bossesHeroic={bossesHeroic} recentLogs={recentLogs} />

  {/* <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 sm:pt-14">
    <CoreHealthPanel health={coreHealth} />
  </div> */}

  <section
    aria-label="Resumo da temporada"
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14"
  >
    <!-- Section header -->
    <div class="flex items-center gap-3 mb-6">
      <div class="h-px flex-1 bg-white/5" aria-hidden="true" />
      <h2 class="text-slate-400 text-xs font-semibold uppercase tracking-widest px-2">
        Destaques da Semana
      </h2>
      <div class="h-px flex-1 bg-white/5" aria-hidden="true" />
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">

      <SummaryCard
        title="Regras"
        value="Confira"
        subtitle="Regras e diretrizes do core"
        icon="📋"
        href={`${base}/regras/`}
        accent="red"
      />

      <SummaryCard
        title="Progressão"
        value={progressionNormalValue}
        altValue={progressionHeroicValue}
        subtitle={progressionNormalSubtitle}
        altsubtitle={progressionHeroicSubtitle}
        icon="⚔"
        href={`${base}/core/progressao/`}
        accent="green"
        altAccent="purple"
      />

      <SummaryCard
        title="Média Raider.IO"
        value={avgIoValue}
        subtitle={avgIoSubtitle}
        icon="🗝"
        href={`${base}/core/mythic/`}
        accent="blue"
      />

      <SummaryCard
          title="Membros"
          value={players.filter((p) => p.type === 'main').length}
          subtitle={`${players.length} total com alts`}
          icon="👥"
          href={`${base}/core/membros/`}
          accent="default"
        />

    </div>

    <!-- Section header -->
    <div class="flex items-center gap-3 px-4 sm:px-6 lg:px-8 py-10">
      <div class="h-px flex-1 bg-white/5" aria-hidden="true" />
      <h2 class="text-slate-400 text-xs font-semibold uppercase tracking-widest px-2">
        Performance do core
      </h2>
      <div class="h-px flex-1 bg-white/5" aria-hidden="true" />
    </div>

    <!-- Médias do core na run mais recente (Team Analytics Engine) -->
    <div class="grid grid-cols-2 gap-4 mb-10">
      <SummaryCard title="DPS Médio" value={formatDpsAverage(coreAverages.dps)} subtitle="Última run" icon="⚔" accent="red" />
      <SummaryCard title="Erros Mecânicos" value={coreAverages.mechanicErrors} subtitle="Média · última run" icon="⚠" accent="gold" />
    </div>

    <HailScoreCard
      valor={hailScoreAtual}
      anterior={hailScoreAnterior}
      nightDate={hailScoreData}
    />

    <CorePerformanceChart
      rosterGroups={rosterGroups}
      metrics={[
        {
          id: 'hail-score',
          label: 'Hail Score',
          direction: 'higher',
          series: [
            {
              playerId: 'core',
              playerName: 'Core',
              playerClass: null,
              playerSlug: undefined,
              data: hailScore,
            },
          ],
        },
        {
          id: 'dps',
          label: 'DPS',
          direction: 'higher',
          series: dpsSeries,
        },
        {
          id: 'parse',
          label: 'Parse',
          direction: 'higher',
          series: parseSeries,
        },
        {
          id: 'deaths',
          label: 'Mortes',
          direction: 'lower',
          series: deathsSeries,
        },
        {
          id: 'mechanics',
          label: 'Mecânicas',
          direction: 'lower',
          series: mechanicsSeries,
        },
      ].filter((metric) => !HIDDEN_CHART_METRICS.has(metric.id))}
    />

    {/* <div class="mt-14">
      <CoreRankingTable ranking={coreRanking} />
    </div> */}
  </section>

</BaseLayout>
