---
/**
 * planejamento.astro — Página de Planejamento Semanal do Core Hub
 * Exibe objetivos da semana, composição por role, ausências e avisos da liderança
 * lidos de data/schedule.json.
 *
 * Requirements: 8.1, 8.2, 8.3, 8.4, 8.5
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Schedule } from '@/types/index';
import scheduleData from '../../data/schedule.json';

const schedule = scheduleData as Schedule;

/**
 * Req 8.5 — se weekObjectives, composition (tanks+healers+dps) e leadershipNotes
 * estiverem todos vazios, exibe mensagem de planejamento não publicado.
 */
const hasObjectives = schedule.weekObjectives.length > 0;
const hasComposition =
  schedule.composition.tanks.length > 0 ||
  schedule.composition.healers.length > 0 ||
  schedule.composition.dps.length > 0;
const hasLeadershipNotes = schedule.leadershipNotes.length > 0;

const hasData = hasObjectives || hasComposition || hasLeadershipNotes;

const totalInComposition =
  schedule.composition.tanks.length +
  schedule.composition.healers.length +
  schedule.composition.dps.length;
---

<BaseLayout
  title="Planejamento"
  description="Objetivos, composição e avisos da semana para as sessões de raid do core Hail to the King."
>

  <!-- Page header -->
  <section
    aria-label="Cabeçalho do planejamento"
    class="bg-[#0a0d14] border-b border-white/5"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <div>
          <p class="text-slate-400 text-xs font-semibold uppercase tracking-widest mb-2">
            Raid · Semana
          </p>
          <h1 class="text-3xl sm:text-4xl font-bold text-[#f0a500] tracking-tight mb-3">
            Planejamento da Semana
          </h1>
          {hasData && (
            <div class="flex flex-wrap items-center gap-3">
              {hasObjectives && (
                <span class="inline-flex items-center px-3 py-1 rounded-full bg-[#f0a500]/10 border border-[#f0a500]/30 text-[#f0a500] text-sm font-medium">
                  🎯 {schedule.weekObjectives.length} objetivo{schedule.weekObjectives.length !== 1 ? 's' : ''}
                </span>
              )}
              {hasComposition && (
                <span class="inline-flex items-center px-3 py-1 rounded-full bg-[#00c48c]/10 border border-[#00c48c]/30 text-[#00c48c] text-sm font-medium">
                  ⚔ {totalInComposition} confirmados
                </span>
              )}
              {schedule.absences.length > 0 && (
                <span class="inline-flex items-center px-3 py-1 rounded-full bg-[#e84040]/10 border border-[#e84040]/30 text-[#e84040] text-sm font-medium">
                  ⚠ {schedule.absences.length} ausência{schedule.absences.length !== 1 ? 's' : ''}
                </span>
              )}
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Empty state — Req 8.5 -->
  {!hasData ? (
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
      <p class="text-slate-400 text-center text-base">
        Planejamento da semana ainda não publicado.
      </p>
    </div>
  ) : (
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">

      <!-- Leadership Notes — Req 8.4 (visually highlighted, shown first for prominence) -->
      {hasLeadershipNotes && (
        <section aria-labelledby="leadership-heading">
          <div class="rounded-xl border border-[#f0a500]/40 bg-[#f0a500]/5 p-6">
            <div class="flex items-center gap-3 mb-5">
              <span class="text-2xl" aria-hidden="true">📢</span>
              <h2 id="leadership-heading" class="text-xl font-bold text-[#f0a500]">
                Avisos da Liderança
              </h2>
            </div>
            <ul class="space-y-3" role="list">
              {schedule.leadershipNotes.map((note) => (
                <li class="flex items-start gap-3">
                  <span class="text-[#f0a500] mt-0.5 shrink-0" aria-hidden="true">▶</span>
                  <p class="text-slate-200 text-sm leading-relaxed">{note}</p>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}

      <!-- Week Objectives — Req 8.1 -->
      {hasObjectives && (
        <section aria-labelledby="objectives-heading">
          <div class="pb-3 mb-6 border-b border-slate-700/50">
            <h2 id="objectives-heading" class="text-xl font-bold text-[#f0a500] mb-1">
              Objetivos da Semana
            </h2>
            <p class="text-slate-400 text-sm">Metas definidas pela liderança para as sessões desta semana.</p>
          </div>
          <ul class="space-y-3" role="list">
            {schedule.weekObjectives.map((objective, index) => (
              <li class="flex items-start gap-4 rounded-lg bg-[#1a2030] border border-slate-700/50 px-5 py-4">
                <span
                  class="shrink-0 w-7 h-7 flex items-center justify-center rounded-full bg-[#f0a500]/15 border border-[#f0a500]/30 text-[#f0a500] text-xs font-bold tabular-nums"
                  aria-hidden="true"
                >
                  {index + 1}
                </span>
                <span class="text-slate-200 text-sm leading-relaxed pt-0.5">{objective}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- Planned Composition — Req 8.2 -->
      {hasComposition && (
        <section aria-labelledby="composition-heading">
          <div class="pb-3 mb-6 border-b border-slate-700/50">
            <h2 id="composition-heading" class="text-xl font-bold text-[#f0a500] mb-1">
              Composição Planejada
            </h2>
            <p class="text-slate-400 text-sm">
              Jogadores confirmados para a sessão, separados por função.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">

            <!-- Tanks -->
            <div class="rounded-xl bg-[#1a2030] border border-slate-700/50 overflow-hidden">
              <div class="flex items-center gap-2 px-5 py-3 bg-[#0d1117]/60 border-b border-slate-700/50">
                <span class="text-lg" aria-hidden="true">🛡</span>
                <h3 class="text-sm font-semibold text-[#f0a500] uppercase tracking-wide">
                  Tanks
                </h3>
                <span class="ml-auto text-xs text-slate-400 font-medium">
                  {schedule.composition.tanks.length}
                </span>
              </div>
              {schedule.composition.tanks.length > 0 ? (
                <ul class="divide-y divide-slate-700/30" role="list">
                  {schedule.composition.tanks.map((name) => (
                    <li class="px-5 py-3 text-slate-200 text-sm font-medium">
                      {name}
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="px-5 py-4 text-slate-400 text-sm italic">Nenhum tank confirmado.</p>
              )}
            </div>

            <!-- Healers -->
            <div class="rounded-xl bg-[#1a2030] border border-slate-700/50 overflow-hidden">
              <div class="flex items-center gap-2 px-5 py-3 bg-[#0d1117]/60 border-b border-slate-700/50">
                <span class="text-lg" aria-hidden="true">💚</span>
                <h3 class="text-sm font-semibold text-[#00c48c] uppercase tracking-wide">
                  Healers
                </h3>
                <span class="ml-auto text-xs text-slate-400 font-medium">
                  {schedule.composition.healers.length}
                </span>
              </div>
              {schedule.composition.healers.length > 0 ? (
                <ul class="divide-y divide-slate-700/30" role="list">
                  {schedule.composition.healers.map((name) => (
                    <li class="px-5 py-3 text-slate-200 text-sm font-medium">
                      {name}
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="px-5 py-4 text-slate-400 text-sm italic">Nenhum healer confirmado.</p>
              )}
            </div>

            <!-- DPS -->
            <div class="rounded-xl bg-[#1a2030] border border-slate-700/50 overflow-hidden">
              <div class="flex items-center gap-2 px-5 py-3 bg-[#0d1117]/60 border-b border-slate-700/50">
                <span class="text-lg" aria-hidden="true">⚔</span>
                <h3 class="text-sm font-semibold text-[#e84040] uppercase tracking-wide">
                  DPS
                </h3>
                <span class="ml-auto text-xs text-slate-400 font-medium">
                  {schedule.composition.dps.length}
                </span>
              </div>
              {schedule.composition.dps.length > 0 ? (
                <ul class="divide-y divide-slate-700/30" role="list">
                  {schedule.composition.dps.map((name) => (
                    <li class="px-5 py-3 text-slate-200 text-sm font-medium">
                      {name}
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="px-5 py-4 text-slate-400 text-sm italic">Nenhum DPS confirmado.</p>
              )}
            </div>

          </div>
        </section>
      )}

      <!-- Confirmed Absences — Req 8.3 -->
      <section aria-labelledby="absences-heading">
        <div class="pb-3 mb-6 border-b border-slate-700/50">
          <h2 id="absences-heading" class="text-xl font-bold text-[#f0a500] mb-1">
            Ausências Confirmadas
          </h2>
          <p class="text-slate-400 text-sm">
            Jogadores que confirmaram ausência para esta semana.
          </p>
        </div>

        {schedule.absences.length > 0 ? (
          <ul class="flex flex-wrap gap-3" role="list">
            {schedule.absences.map((name) => (
              <li>
                <span class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-[#e84040]/10 border border-[#e84040]/30 text-[#e84040] text-sm font-medium">
                  <span aria-hidden="true">✗</span>
                  {name}
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-slate-400 text-sm">Nenhuma ausência confirmada para esta semana.</p>
        )}
      </section>

    </div>
  )}

</BaseLayout>
