---
/**
 * [id].astro — A URL curta da retrospectiva.
 *
 * /retrospectiva/<id> é o link que a pessoa compartilha; a página real
 * virou /core/<core>/retrospectiva/<id> porque o "2º do core" dos slides
 * de comparação precisa saber de que core. O link curto segue valendo e
 * manda pro core em que ela joga.
 */

import roster from '../../../data/guild/roster.json';
import { coresDe, corePrincipal } from '@/engine/guild/cores';
import { mapearPessoas, type PersonagemDoRoster } from '@/engine/guild/pessoas';

export function getStaticPaths() {
  // Uma por PESSOA, igual à página real: o alt não tem retrospectiva
  // própria, e gerar uma aqui apontaria pra uma página que não existe.
  const pessoas = mapearPessoas(roster as unknown as PersonagemDoRoster[]);

  return roster
    .filter((jogador) => (pessoas.get(jogador.id) ?? jogador.id) === jogador.id)
    .filter((jogador) => coresDe(jogador).length > 0)
    .map((jogador) => ({ params: { id: jogador.id } }));
}

const { id } = Astro.params;
const player = roster.find((jogador) => jogador.id === id);

/**
 * O primeiro core em que ela joga, não o principal: quem só joga no Ômega
 * tinha o link curto apontando pra um core que não é o dela.
 */
const destino = coresDe(player ?? {})[0] ?? corePrincipal().slug;

return Astro.redirect(`/core/${destino}/retrospectiva/${id}/`);
---
