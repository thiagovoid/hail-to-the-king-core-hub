---
/**
 * roster.astro — Página do Roster
 * Lista todos os jogadores separados em Mains e Alts, com grid responsivo.
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import PlayerCard from '@/components/PlayerCard.astro';
import type { Player } from '@/types/index';
import rosterData from '../../data/roster.json';

const players = rosterData as Player[];

const mains = players.filter((p) => p.type === 'main');
const alts = players.filter((p) => p.type === 'alt');
---

<BaseLayout
  title="Roster"
  description="Conheça os membros do core de raid Hail to the King: mains, alts, classes, specs e estatísticas."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- Page header -->
    <header class="mb-10">
      <h1 class="text-3xl font-bold text-slate-100 mb-2">Roster</h1>
      <p class="text-slate-400 text-sm">
        {players.length} membros · {mains.length} mains · {alts.length} alts
      </p>
    </header>

    <!-- Mains section -->
    {mains.length > 0 && (
      <section aria-labelledby="mains-heading" class="mb-12">
        <div class="pb-3 mb-6 border-b border-slate-700/50">
          <h2 id="mains-heading" class="text-2xl font-bold text-[#f0a500] mb-1">
            Mains
          </h2>
          <p class="text-slate-400 text-sm">{mains.length} personagens principais</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
          {mains.map((player) => (
            <PlayerCard player={player} />
          ))}
        </div>
      </section>
    )}

    <!-- Alts section -->
    {alts.length > 0 && (
      <section aria-labelledby="alts-heading">
        <div class="pb-3 mb-6 border-b border-slate-700/50">
          <h2 id="alts-heading" class="text-2xl font-bold text-[#f0a500] mb-1">
            Alts
          </h2>
          <p class="text-slate-400 text-sm">{alts.length} personagens alternativos</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
          {alts.map((player) => (
            <PlayerCard player={player} />
          ))}
        </div>
      </section>
    )}

    <!-- Empty state (should never happen with real data) -->
    {players.length === 0 && (
      <p class="text-slate-500 text-center py-16">Nenhum jogador no roster ainda.</p>
    )}

  </div>
</BaseLayout>
